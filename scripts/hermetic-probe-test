cp "$tmp/probe/cfg/.claude.json" "$tmp/account-before.json"
live_case
live_queue
probe "$fx" live
check "live wipe exits 0" 0 "$rc"
check "live wipe: the transcripts line counts what went" 1 "$(lines "✔ transcripts  removed 3 transcript(s) in 2 project dir(s) from $tmp/probe/cfg/projects")"
check "live wipe: the earlier sessions' project dirs are gone" '0 0' "$(printf '%s %s' "$(test -e "$transcripts/-old-live" && echo 1 || echo 0)" "$(test -e "$transcripts/-hand-probe" && echo 1 || echo 0)")"
