check "static validates the root and the plugin" 2 "$(logged 'claude plugin validate --strict')"
# a nested checkout and a dangling link in the tree: git lists the one as
# `nested/` and the other by name, grep can read neither, and both are
# skipped and counted rather than ending the sweep
mkdir -p "$fx/nested"
git -C "$fx/nested" init -q
ln -s "$fx/nope" "$fx/dangling"
shim_reset
probe "$fx" static
check "static with a nested checkout and a dangling link exits 0" 0 "$rc"
check "static with a nested checkout and a dangling link: both skipped and counted" 1 "$(lines 'every one a KEEP site (2 listed entries that are not files skipped')"
rm -rf "$fx/nested" "$fx/dangling"

