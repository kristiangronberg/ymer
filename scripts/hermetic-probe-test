check "live refused compound: bash-commands passes, naming the refused run" 1 "$(lines '✔ bash-commands no Bash command beyond `claude mcp get <name>` and the state folder'"'"'s `rev-parse` ran in any run — refused, never run, in run(s) 2')"
live_seeded /ymer:kaizen-capture run-capture-true-refused.jsonl
probe "$fx" live
check "live refused habit exits 0" 0 "$rc"
check "live refused habit: bash-commands passes, naming the refused run" 1 "$(lines '✔ bash-commands no Bash command beyond `claude mcp get <name>` and the state folder'"'"'s `rev-parse` ran in any run — refused, never run, in run(s) 2')"

# ── 26 · live, docker-compose not on PATH ─────────────────────────────
# the shim is hidden and PATH narrowed to the system's own directories, so
# a real binary installed elsewhere on the maintainer's machine is not found
live_case
mv "$tmp/bin/docker-compose" "$tmp/dc.hidden"
savepath=$PATH
PATH=$tmp/bin:$(getconf PATH)
probe "$fx" live
PATH=$savepath
mv "$tmp/dc.hidden" "$tmp/bin/docker-compose"
check "live without docker-compose exits 2" 2 "$rc"
check "live without docker-compose names the binary" 1 "$(lines '✘ docker       docker-compose is not on PATH')"

