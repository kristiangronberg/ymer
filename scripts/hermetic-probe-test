chmod -R u+w "$transcripts"
check "live wipe that cannot finish exits 1" 1 "$rc"
check "live wipe that cannot finish: the transcripts line names the directory and the fix" 1 "$(lines "✘ transcripts  could not remove all of $tmp/probe/cfg/projects — remove it by hand")"
check "live wipe that cannot finish: the runs still run" 1 "$(lines '✔ instructions')"

# ── 38 · the model pin: one probe_model, in the entry alone ───────────
# the eval and live stages read the entry's pin, so a second assignment in
# a stage file would let the two drift apart — and no argv the shims log
# tells two pins reading the same value from one
pins() { cat "$@" | grep -c '^probe_model='; }
check "one probe_model pin across the entry and the stages" 1 "$(pins "$here"/hermetic-probe "$here"/hermetic-probe-static "$here"/hermetic-probe-eval "$here"/hermetic-probe-live)"
mkdir -p "$tmp/pin"
cp "$here"/hermetic-probe "$here"/hermetic-probe-static "$here"/hermetic-probe-eval "$here"/hermetic-probe-live "$tmp/pin/"
printf 'probe_model=claude-sonnet-5\n' >>"$tmp/pin/hermetic-probe-eval"
check "a second pin in a stage file is counted" 2 "$(pins "$tmp/pin"/hermetic-probe "$tmp/pin"/hermetic-probe-static "$tmp/pin"/hermetic-probe-eval "$tmp/pin"/hermetic-probe-live)"

echo
echo "hermetic-probe-test: $pass passed, $fail failed"
[ "$fail" = 0 ]
