check "seeded values: the values check fails" 1 "$(lines '✘ values')"
check "seeded values: the path is listed" 1 "$(lines 'notes.md:1:a path /Users/someone/state')"
check "seeded values: the host is listed" 1 "$(lines 'notes.md:3:a host http://example.invalid:9999')"
check "seeded values: the call shape is listed" 1 "$(lines 'notes.md:4:a call mcp__foo__bar')"
check "seeded values: the token is listed, CR and all" 1 "$(lines 'notes.md:5:a token someone-token')"
check "seeded values: the KEEP site is not listed" 0 "$(lines 'notes.md:2:')"
check "seeded values: a value beside the KEEP site on one line is listed" 1 "$(lines 'notes.md:6:a kept ~/things beside /Users/someone/state')"
check "seeded values: a value running on past the KEEP text is listed" 1 "$(lines 'notes.md:7:a longer ~/things-private')"
check "seeded values: the KEEP text ending a sentence is not listed" 0 "$(lines 'notes.md:8:')"
check "seeded values: a file with a space in its name is swept" 1 "$(lines 'a note.md:1:a path /Users/someone/state')"
check "seeded values: a binary file is swept and its hit listed with its line" 1 "$(lines 'blob.bin:1:blob')"
check "seeded values: the KEEP'd URL standing alone is not listed" 0 "$(lines 'url.md:1:')"
check "seeded values: the KEEP'd URL running on through a query is listed" 1 "$(lines "url.md:2:a longer $u?token=x")"
check "seeded values: a record id in a doc handle is listed" 1 "$(lines 'ids.md:1:a handle doc-0000aaaa-')"
check "seeded values: an upper-case record id is listed" 1 "$(lines 'ids.md:2:an upper handle doc-0000AAAA-')"

