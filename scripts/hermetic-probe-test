#!/bin/sh
# hermetic-probe-test — self-test for hermetic-probe and its stage files.
# Run it after any edit to them: it works in a temp directory, calls no
# model and touches no real node or config — `claude`, `docker`,
# `docker-compose` and `curl` are shims first on PATH that record their
# argv and replay canned output, and a shimmed call can leave files behind
# the way a real run leaves them in state/, so what is tested is the
# probe's own logic: the sweeps and their KEEP filter (a value beside an
# allowed one, a value running on past one, a binary file, a nested
# checkout in the corpus, an empty corpus, the token file's shape), the
# reference rules, the runner's result read, the login assert, the scrub,
# prompt-before-flags and the strict MCP config, the node read-back,
# teardown on failure — a failed `up` included — the compose copy's
# project name checked before `up` and again before `down`, a wrong one
# refused at either end, each live precondition's exit 2, a run that did
# not end in success, the two arms and the option between them, the seeded
# steps' not-run lines, the state reads' deltas over the node and state/,
# the history read, setup's report read for its facts — dressed, and
# naming a wrong node address — the behaviour checks — an input carrying a
# brace or an escaped quote included, a server call read by its result —
# the runs' hook over its own events, the one model pin, the static
# stage's verifier check — its test passing, failing and missing — and
# the exit codes.
#
#   scripts/hermetic-probe-test
#
# Exit 0 = every case passed.

set -u

here=$(cd "$(dirname "$0")" && pwd)
# physical, as the live stage normalises its probe dir: mktemp's path sits
# under a symlink on macOS, and the report lines the cases read spell $tmp
tmp=$(cd "$(mktemp -d)" && pwd -P)
trap 'rm -rf "$tmp"' EXIT

pass=0
fail=0

check() { # check <name> <expected> <actual>
	if [ "$2" = "$3" ]; then
		pass=$((pass + 1))
		echo "ok   — $1"
	else
		fail=$((fail + 1))
		echo "FAIL — $1"
		echo "       expected: $2"
		echo "       actual:   $3"
	fi
}

# ── shims ─────────────────────────────────────────────────────────────
# One body for all four: log `<command> <argv>`, then answer from
# $SHIM_DIR/queue (first line whose key is a substring of the argv,
# consumed) or $SHIM_DIR/answers (the same, kept), where a line is
# `<key><TAB><response>` and a response is text, `@<file>` or `rc=<n>`.
# A `-o <file>`/`--json <file>` argument receives the text instead of
# stdout.
SHIM_DIR=$tmp/shim
export SHIM_DIR
mkdir -p "$tmp/bin" "$SHIM_DIR"
for cmd in claude docker docker-compose curl; do
	cat >"$tmp/bin/$cmd" <<'EOF'
#!/bin/sh
me=$(basename "$0")
printf '%s %s\n' "$me" "$*" >>"$SHIM_DIR/log"
[ -n "${ANTHROPIC_API_KEY+x}" ] && echo "$me: ANTHROPIC_API_KEY is set" >>"$SHIM_DIR/log"
key=$(printf '%s %s' "$me" "$*" | tr '\n' ' ')
out=''
json=''
prev=''
for a in "$@"; do
	case $prev in
	-o) out=$a ;;
	--json) json=$a ;;
	esac
	prev=$a
done
resp=''
for src in queue answers; do
	f=$SHIM_DIR/$src
	[ -f "$f" ] || continue
	n=$(awk -v k="$key" -F'\t' '{ if (index(k, $1) > 0) { print NR; exit } }' "$f")
	[ -n "$n" ] || continue
	resp=$(sed -n "${n}p" "$f" | cut -f2-)
	if [ "$src" = queue ]; then
		sed "${n}d" "$f" >"$f.new" && mv "$f.new" "$f"
	fi
	break
done
case $resp in
rc=*) exit "${resp#rc=}" ;;
@*) body=$(cat "${resp#@}") ;;
*) body=$resp ;;
esac
# a call's side effect: the first line of $SHIM_DIR/effects whose key is a
# substring of the argv, consumed, run as a shell command — what a real
# run leaves on disk
if [ -f "$SHIM_DIR/effects" ]; then
	n=$(awk -v k="$key" -F'\t' '{ if (index(k, $1) > 0) { print NR; exit } }' "$SHIM_DIR/effects")
	if [ -n "$n" ]; then
		eff=$(sed -n "${n}p" "$SHIM_DIR/effects" | cut -f2-)
		sed "${n}d" "$SHIM_DIR/effects" >"$SHIM_DIR/effects.new" && mv "$SHIM_DIR/effects.new" "$SHIM_DIR/effects"
		sh -c "$eff"
	fi
fi
if [ -n "$out" ]; then
	printf '%s\n' "$body" >"$out"
elif [ -n "$json" ]; then
	printf '%s\n' "$body" >"$json"
else
	printf '%s\n' "$body"
fi
exit 0
EOF
	chmod +x "$tmp/bin/$cmd"
done
PATH=$tmp/bin:$PATH
export PATH

shim_reset() { # shim_reset — empty log, queue, answers and effects
	: >"$SHIM_DIR/log"
	: >"$SHIM_DIR/queue"
	: >"$SHIM_DIR/answers"
	: >"$SHIM_DIR/effects"
}
queue() { printf '%s\t%s\n' "$1" "$2" >>"$SHIM_DIR/queue"; }
answer() { printf '%s\t%s\n' "$1" "$2" >>"$SHIM_DIR/answers"; }
effect() { printf '%s\t%s\n' "$1" "$2" >>"$SHIM_DIR/effects"; }
# requeue/reanswer <key> [<response>]... — drop every line keyed exactly
# <key>, then add one line per response: how a case replaces what
# live_queue put there
shim_drop() { # shim_drop <queue|answers|effects> <key> — the one drop-by-key they share
	awk -F'\t' -v k="$2" '$1 != k' "$SHIM_DIR/$1" >"$SHIM_DIR/$1.new" && mv "$SHIM_DIR/$1.new" "$SHIM_DIR/$1"
}
requeue() {
	k=$1
	shift
	shim_drop queue "$k"
	for r in "$@"; do queue "$k" "$r"; done
}
reanswer() {
	k=$1
	shift
	shim_drop answers "$k"
	for r in "$@"; do answer "$k" "$r"; done
}
logged() { grep -c -F -- "$1" "$SHIM_DIR/log"; }
# The live stage's compose call, from its own copy of the compose file, and
# the bash-commands failure's text up to its run list — each spelled once
scratch_dc="docker-compose -p hermetic-probe -f $tmp/probe/compose/docker-compose.yml"
bash_other='✘ bash-commands a Bash command other than `claude mcp get <name>` or the state folder'"'"'s `rev-parse` in run(s)'

# ── canned output ─────────────────────────────────────────────────────
canned=$tmp/canned
mkdir -p "$canned"
printf '{\n  "loggedIn": true,\n  "authMethod": "claude.ai"\n}\n' >"$canned/auth-ok.json"
printf '{\n  "loggedIn": false,\n  "authMethod": "none"\n}\n' >"$canned/auth-none.json"
# `claude mcp list` under a logged-in config dir: the login's own claude.ai
# connectors, listed whether or not anything was ever added
printf 'Checking MCP server health…\n\nclaude.ai Docs: %s - ✔ Connected\n' 'http://example.invalid:9999/mcp' >"$canned/mcp-list-connectors.txt"
# The runner's result, pretty-printed one key per line as the real one is.
eval_result() { # eval_result <partial> <total> <passed> <runs ending normally>
	printf '{\n  "schemaVersion": 1,\n  "partial": %s,\n  "cases": [\n' "$1"
	i=0
	while [ "$i" -lt "$4" ]; do
		i=$((i + 1))
		printf '    {\n      "name": "case-%s",\n      "arms": {\n        "with": [\n          {\n            "error": null,\n            "passed": true\n          }\n        ]\n      }\n    },\n' "$i"
	done
	printf '    {\n      "name": "tail",\n      "arms": {\n        "with": [\n          {\n            "error": "timed out after 300s",\n            "passed": false\n          }\n        ]\n      }\n    }\n'
	printf '  ],\n  "aggregates": {\n    "casesTotal": %s,\n    "casesPassed": %s\n  }\n}\n' "$2" "$3"
}
eval_result false 2 2 2 >"$canned/eval-ok.json"
eval_result false 2 1 2 >"$canned/eval-fail.json"
eval_result true 2 1 1 >"$canned/eval-partial.json"
eval_result false 1 1 1 >"$canned/eval-short.json"
# stream-json runs: an init line naming the servers the run saw, one
# tool_use block per <tool> <input> pair, the tool_result lines a case
# sets, an optional narration line, and the result line last — the shape
# the live stage reads
trace_init_default='{"type":"system","subtype":"init","mcp_servers":[{"name":"ymer-node","status":"connected","source":"dynamic"}]}'
trace_init=$trace_init_default
trace_narration=''
run_trace() { # run_trace <result text> [<tool> <input json>]...
	printf '%s\n' "$trace_init"
	r=$1
	shift
	i=0
	while [ $# -ge 2 ]; do
		i=$((i + 1))
		printf '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t%s","name":"%s","input":%s}]}}\n' "$i" "$1" "$2"
		shift 2
	done
	[ -n "$trace_results" ] && printf '%s\n' "$trace_results"
	[ -n "$trace_narration" ] && printf '{"type":"assistant","message":{"content":[{"type":"text","text":"%s"}]}}\n' "$trace_narration"
	printf '{"is_error":false,"subtype":"success","type":"result","result":"%s","permission_denials":[%s]}\n' "$r" "$trace_denied"
}
trace_denied='' # the result event's permission_denials entries, for a trace whose calls were refused
trace_results='' # tool_result lines, one per answered call: a call a case leaves out has no result
tool_result() { # tool_result <id> <content> <is_error> — a user line answering tool_use <id>, as the CLI writes one
	printf '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","content":"%s","is_error":%s,"tool_use_id":"%s"}]}}' "$2" "$3" "$1"
}
notebook=mcp__ymer-node__notebook
live=$tmp/live # the live cases' fixture, named here so a canned trace can read under it
pstate=$tmp/probe/state # the live stage's state/, under the probe dir every live case uses
# setup's report with no state folder named, in the lines the skill's own
# grammar gives; the second variant is the wording a denied read
# produced, which the report check must not accept
setup_report="Setup — ymer environment\n\n  ✔ node          reachable — 7 tables created, front \`claude_code\` added\n  ✘ state_folder  not set — set it with /plugin configure ymer@ymer\n  ✔ ymer          no connection in this session — work tracked in the node's \`tasks\` table\n  – Meta Roadmap  not checked"
run_trace "$setup_report" $notebook '{"action":"execute","data":{"sql":"CREATE TABLE fronts (slug TEXT)"}}' Read "{\"file_path\":\"$live/plugins/ymer/skills/setup/SKILL.md\"}" >"$canned/run-setup1.jsonl"
run_trace "$(printf '%s' "$setup_report" | sed 's/not set — set it/not readable from this session — set it/')" $notebook '{"action":"execute","data":{"sql":"CREATE TABLE fronts (slug TEXT)"}}' >"$canned/run-setup1-unreadable.jsonl"
run_trace 'recorded' $notebook '{"action":"execute","data":{"sql":"INSERT INTO frictions VALUES (1)"}}' >"$canned/run-capture.jsonl"
# summary with no state folder: it reads the backlog and stops naming setup
run_trace 'No state folder is named, so nothing was drained. Run /ymer:setup.' $notebook '{"action":"query","data":{"sql":"SELECT slug FROM fronts"}}' >"$canned/run-summary-stop.jsonl"
# summary's healthy trace in the second arm carries the declared commands
# — the state folder's rev-parse bare and with its path quoted — reads
# inside the probe dir, one path absolute and one relative, a write under
# state/, and the history row it saves
save_sql="INSERT INTO topics_history (topic, area, artifact, body, phase, front) SELECT 't', 'meta', 'request.md', new.body, 'kaizen_summary', 'claude_code' FROM (SELECT 'b' AS body) AS new"
run_trace 'drained' $notebook '{"action":"execute","data":{"sql":"UPDATE frictions SET status = 1"}}' $notebook "{\"action\":\"execute\",\"data\":{\"sql\":\"$save_sql\"}}" Bash '{"command":"claude mcp get ymer"}' Bash '{"command":"claude mcp get ymer 2>&1"}' Bash "{\"command\":\"git -C $pstate rev-parse --is-inside-work-tree\"}" Bash "{\"command\":\"git -C \\\"$pstate\\\" rev-parse --is-inside-work-tree\"}" Write "{\"file_path\":\"$pstate/meta/2026/09-21-friction-batch/request.md\",\"content\":\"x\"}" Read "{\"file_path\":\"$tmp/probe/cwd/notes.md\"}" Glob '{"pattern":"*.md"}' >"$canned/run-summary.jsonl"
# the same summary writing beside state/ rather than into it
run_trace 'drained' $notebook '{"action":"execute","data":{"sql":"UPDATE frictions SET status = 1"}}' Write "{\"file_path\":\"$tmp/probe/cwd/request.md\",\"content\":\"x\"}" >"$canned/run-summary-outside.jsonl"
# the re-run's report, healthy on the result line while a narration line
# mid-run says `tables created`: only a read of the result line passes it
trace_narration='All seven tables created earlier are present; composing the report.'
run_trace "Setup — ymer environment\n\n  ✔ node          reachable — 7 tables, front \`claude_code\`\n  ✔ state_folder  $pstate — not a git work tree, history in the node's \`topics_history\`" $notebook '{"action":"query","data":{"sql":"SELECT 1"}}' >"$canned/run-setup2.jsonl"
trace_narration=''
run_trace "Setup — ymer environment\n\n  ✔ node          reachable — 7 tables, front \`claude_code\`\n  ✔ state_folder  $pstate — git work tree, history in git" $notebook '{"action":"query","data":{"sql":"SELECT 1"}}' >"$canned/run-setup2-git.jsonl"
run_trace "  ✔ node          reachable — 7 tables created, front \`claude_code\` added" $notebook '{"action":"query","data":{"sql":"SELECT 1"}}' >"$canned/run-setup2-created.jsonl"
# setup's reports dressed the way a model dresses them — a sentence
# before, bold role names, ` — ` separators, backticked values, a code
# fence, a Details section after, a decoration or a double blank inside a
# phrase the check reads — right in every fact, so the report checks must
# pass them; the re-run's Details line says created and added, off the
# node's line, and does not decide the node's line
run_trace "Now compiling the full report.\n\n**Setup — ymer environment**\n\n\`\`\`\n✔ **node** — reachable — 7 tables created, front \`claude_code\` added\n✘ **state_folder** — not **set** — set it with /plugin configure ymer@ymer\n✔ **ymer** — no  connection in this session (no \`ymer\` MCP server configured) — work tracked in the node's \`tasks\` table\n– **Meta Roadmap** — not checked\n\`\`\`\n\nDetails:\n- **state_folder**: the option is unset." $notebook '{"action":"execute","data":{"sql":"CREATE TABLE fronts (slug TEXT)"}}' >"$canned/run-setup1-decorated.jsonl"
run_trace "Setup — ymer environment\n\n✔ **node** — reachable, 7 tables present (fronts, frictions, tasks, tasks_log, topics_history, tutor_subjects, tutor_engagements), all columns/indexes/triggers verified, no changes needed — front \`claude_code\` already registered\n✔ **state_folder** — \`$pstate\` — not a git work tree, history in the node's \`topics_history\`\n✔ **ymer** — no connection in this session (no \`ymer\` MCP server configured; only \`ymer-node\`) — work tracked in the node's \`tasks\` table\n– **Meta Roadmap** — not checked — no ymer; process work routes to \`Meta Roadmap\` in \`tasks\`\n\nDetails:\n- nothing was created or added this run." $notebook '{"action":"query","data":{"sql":"SELECT 1"}}' >"$canned/run-setup2-decorated.jsonl"
# no coordinator line, and the Meta Roadmap line naming ymer's missing
# connection and tasks in its place: the coordinator is not reported
run_trace "Setup — ymer environment\n\n  ✔ node          reachable — 7 tables created, front \`claude_code\` added\n  ✘ state_folder  not set — set it with /plugin configure ymer@ymer\n  – Meta Roadmap  not checked — no connection to ymer; process work routes to \`Meta Roadmap\` in \`tasks\`" $notebook '{"action":"execute","data":{"sql":"CREATE TABLE fronts (slug TEXT)"}}' >"$canned/run-setup1-no-ymer.jsonl"
# the re-run's node line naming a change the re-run never made: tables
# created, or a front row added — and the line saying created beside a
# Details line that restates the node's facts without it
run_trace "  ✔ node          reachable — 7 tables created, front \`claude_code\`\n  ✔ state_folder  $pstate — not a git work tree, history in the node's \`topics_history\`" $notebook '{"action":"query","data":{"sql":"SELECT 1"}}' >"$canned/run-setup2-created-only.jsonl"
run_trace "  ✔ node          reachable — 7 tables, front \`claude_code\` added\n  ✔ state_folder  $pstate — not a git work tree, history in the node's \`topics_history\`" $notebook '{"action":"query","data":{"sql":"SELECT 1"}}' >"$canned/run-setup2-added.jsonl"
run_trace "  ✔ node          reachable — 7 tables created, front \`claude_code\`\n  ✔ state_folder  $pstate — not a git work tree, history in the node's \`topics_history\`\n\nDetails:\n- ✔ **node**: reachable, 7 tables, front \`claude_code\`" $notebook '{"action":"query","data":{"sql":"SELECT 1"}}' >"$canned/run-setup2-created-recap.jsonl"
# the re-run's report naming the node by address: a port the node does
# not run on, as a URL, as a bare port and after the node's server name,
# and the probe's own port
run_trace "  ✔ node          reachable at http://127.0.0.1:8012/mcp — 7 tables, front \`claude_code\`\n  ✔ state_folder  $pstate — not a git work tree, history in the node's \`topics_history\`" $notebook '{"action":"query","data":{"sql":"SELECT 1"}}' >"$canned/run-setup2-wrong-url.jsonl"
run_trace "  ✔ node          reachable on port 8012 — 7 tables, front \`claude_code\`\n  ✔ state_folder  $pstate — not a git work tree, history in the node's \`topics_history\`" $notebook '{"action":"query","data":{"sql":"SELECT 1"}}' >"$canned/run-setup2-wrong-port.jsonl"
run_trace "  ✔ node          reachable at ymer-node:8012 — 7 tables, front \`claude_code\`\n  ✔ state_folder  $pstate — not a git work tree, history in the node's \`topics_history\`" $notebook '{"action":"query","data":{"sql":"SELECT 1"}}' >"$canned/run-setup2-wrong-host.jsonl"
run_trace "  ✔ node          reachable at http://127.0.0.1:8112/mcp — 7 tables, front \`claude_code\`\n  ✔ state_folder  $pstate — not a git work tree, history in the node's \`topics_history\`" $notebook '{"action":"query","data":{"sql":"SELECT 1"}}' >"$canned/run-setup2-right-url.jsonl"
# the first run's and the drift run's reports naming a port the node does
# not run on, each otherwise the run it stands in for
run_trace "$(printf '%s' "$setup_report" | sed 's/reachable —/reachable on port 8012 —/')" $notebook '{"action":"execute","data":{"sql":"CREATE TABLE fronts (slug TEXT)"}}' Read "{\"file_path\":\"$live/plugins/ymer/skills/setup/SKILL.md\"}" >"$canned/run-setup1-wrong-port.jsonl"
run_trace 'tasks.due_date added — node on port 8012' $notebook '{"action":"execute","data":{"sql":"ALTER TABLE tasks ADD COLUMN due_date TEXT"}}' >"$canned/run-setup3-wrong-port.jsonl"
run_trace 'tasks.due_date added' $notebook '{"action":"execute","data":{"sql":"ALTER TABLE tasks ADD COLUMN due_date TEXT"}}' >"$canned/run-setup3.jsonl"
# the state folder's reading aimed at another folder: the path is the
# stage's own, so any other is no declared command
run_trace 'read' Bash '{"command":"git -C /Users/someone/state rev-parse --is-inside-work-tree"}' >"$canned/run-capture-revparse.jsonl"
run_trace 'committed' Bash '{"command":"git commit -m x"}' >"$canned/run-summary-git.jsonl"
# a `{}` ahead of the commit: a read cut at the first `}` would hide it
run_trace 'committed' Bash '{"command":"echo {} && git commit -m x"}' >"$canned/run-summary-git-brace.jsonl"
run_trace 'written' Write '{"file_path":"notes.md","content":"x"}' >"$canned/run-capture-write.jsonl"
run_trace 'appended' Bash '{"command":"echo x >> notes.txt"}' >"$canned/run-capture-bash.jsonl"
run_trace 'read' Bash '{"command":"claude mcp get ymer 2>&1; echo done"}' >"$canned/run-capture-compound.jsonl"
# the same compound, refused: the run's result event names it under
# permission_denials, so it never ran — the record is the same whether the
# runs' hook or the permission layer refused it; and `true`, the habit the
# hook refuses where no allow rule would
trace_denied='{"tool_name":"Bash","tool_use_id":"t1","tool_input":{"command":"claude mcp get ymer 2>&1; echo done"}}'
run_trace 'read' Bash '{"command":"claude mcp get ymer 2>&1; echo done"}' >"$canned/run-capture-refused.jsonl"
trace_denied='{"tool_name":"Bash","tool_use_id":"t1","tool_input":{"command":"true","description":"d"}}'
run_trace 'read' Bash '{"command":"true","description":"d"}' >"$canned/run-capture-true-refused.jsonl"
trace_denied=''
run_trace 'read' Read '{"file_path":"/Users/someone/state"}' >"$canned/run-capture-outside.jsonl"
# two paths that open under an allowed prefix and climb out of it, and a
# Glob whose pattern is absolute — a call with no path key at all
run_trace 'read' Read "{\"file_path\":\"$tmp/probe/cwd/../outside\"}" >"$canned/run-capture-climb.jsonl"
run_trace 'read' Read "{\"file_path\":\"$live/../outside\"}" >"$canned/run-capture-climb-root.jsonl"
run_trace 'globbed' Glob '{"pattern":"/Users/someone/state"}' >"$canned/run-capture-glob.jsonl"
# a brace glob ahead of its path: the `}` inside the pattern would end a
# read cut at the first `}` before the path key
run_trace 'globbed' Glob '{"pattern":"*.{md,yaml}","path":"/Users/someone/state"}' >"$canned/run-capture-glob-brace.jsonl"
run_trace 'searched' mcp__foo__bar '{"query":"x"}' >"$canned/run-capture-reach.jsonl"
# a server call read by its result, paired by id: the CLI's answer that
# no such tool exists — a name with no tool part, beside a notebook call
# left unanswered — reaches nothing; a foreign tool that answered, that was
# refused, or whose no-such-tool answer names another tool reached its
# server; and the call above, with no result at all, is a reach too
trace_results=$(tool_result t1 '<tool_use_error>Error: No such tool available: mcp__ymer-node</tool_use_error>' true)
run_trace 'recorded' mcp__ymer-node '{}' $notebook '{"action":"execute","data":{"sql":"INSERT INTO frictions VALUES (1)"}}' >"$canned/run-capture-no-such-tool.jsonl"
trace_results=$(tool_result t1 'found' false)
run_trace 'searched' mcp__foo__bar '{"query":"x"}' >"$canned/run-capture-reach-answered.jsonl"
trace_results=$(tool_result t1 'Claude requested permissions to use mcp__foo__bar, but you have not granted it yet.' true)
run_trace 'searched' mcp__foo__bar '{"query":"x"}' >"$canned/run-capture-reach-refused.jsonl"
trace_results=$(tool_result t1 '<tool_use_error>Error: No such tool available: mcp__ymer-node</tool_use_error>' true)
run_trace 'searched' mcp__foo__bar '{"query":"x"}' >"$canned/run-capture-reach-misnamed.jsonl"
trace_results=''
trace_init='{"type":"system","subtype":"init","mcp_servers":[{"name":"ymer-node","status":"connected","source":"dynamic"},{"name":"other","status":"connected","source":"claudeai"}]}'
run_trace 'recorded' $notebook '{"action":"execute","data":{"sql":"INSERT INTO frictions VALUES (1)"}}' >"$canned/run-capture-connector.jsonl"
trace_init=$trace_init_default
# a compound behind an escaped quote: the stage reads the command as the
# whole JSON string, so what it holds runs on past the quoted name to the `;`
run_trace 'read' Bash '{"command":"claude mcp get \"ymer\"; cat ~/things-private"}' >"$canned/run-capture-quoted.jsonl"
sed 's/"subtype":"success"/"subtype":"error_max_turns"/' "$canned/run-capture.jsonl" >"$canned/run-capture-failed.jsonl"
# tutor at its guard: with no ymer, the docs' home named; with no tables,
# setup named — each having only read the node
run_trace "Tutor skill — stopped: no ymer docs tool in this session. The knowledge and engagement docs live in ymer, so nothing was opened." $notebook '{"action":"query","data":{"sql":"SELECT subject FROM tutor_subjects"}}' >"$canned/run-tutor-ymer.jsonl"
run_trace "Tutor skill — stopped: the notebook has no tutor_subjects or tutor_engagements table. Run /ymer:setup, which creates both." $notebook '{"action":"query","data":{"sql":"SELECT name FROM sqlite_master"}}' >"$canned/run-tutor-stop.jsonl"
node_rows() { # node_rows <n> — a query answer whose first cell is <n>
	printf '{"result":{"content":[{"text":"{\\"columns\\":[\\"n\\"],\\"rows\\":[[%s]]}","type":"text"}],"isError":false}}' "$1"
}
node_tables() { # node_tables <n> — a tables answer counting <n>
	printf '{"result":{"content":[{"text":"{\\"count\\":%s,\\"tables\\":[]}","type":"text"}],"isError":false}}' "$1"
}
node_text_rows() { # node_text_rows <text> — a query answer whose first cell is the text <text>
	printf '{"result":{"content":[{"text":"{\\"columns\\":[\\"t\\"],\\"rows\\":[[\\"%s\\"]]}","type":"text"}],"isError":false}}' "$1"
}
# The files a summary run leaves in state/, written by the claude shim's
# effect for that run: the topic run 6 drains to, the friction-batch run 7
# opens, and run 8's append to it — ten seed lines under the first heading
# each time, the opening date kept.
drained_to='demo/2026/09-21-probe-topic/'
batch_dir=$pstate/meta/2026/09-21-friction-batch
batch_body() { # batch_body <created> <seed lines> — a friction-batch request.md
	printf -- '---\nsource: kaizen-summary\ntask: 1\ncreated: %s\n---\n\n# friction-batch\n\n## Below the bar for their own topic\n\n' "$1"
	i=0
	while [ "$i" -lt "$2" ]; do
		i=$((i + 1))
		printf -- '- #%s seed friction %s below the bar\n' "$i" "$i"
	done
	printf '\n## Moot, or judged not worth doing\n'
}
batch_body 2026-09-21 10 >"$canned/batch-10.md"
batch_body 2026-09-21 20 >"$canned/batch-20.md"
batch_body 2026-09-22 20 >"$canned/batch-20-redated.md"
# summary_effects <run 3> <run 6> <run 7> <run 8> — what each summary run
# leaves on disk, replacing any queued before; `:` leaves nothing
summary_effects() {
	shim_drop effects 'claude -p /ymer:kaizen-summary'
	for e in "$@"; do effect 'claude -p /ymer:kaizen-summary' "$e"; done
}
effect_drain="mkdir -p '$pstate/$drained_to' && printf 'x\n' >'$pstate/${drained_to}request.md'"
effect_batch="mkdir -p '$batch_dir' && cp '$canned/batch-10.md' '$batch_dir/request.md'"
effect_append="cp '$canned/batch-20.md' '$batch_dir/request.md'"

# ── fixtures ──────────────────────────────────────────────────────────
# fixture <dir> — a marketplace shaped like this one: the plugin ymer
# (skills setup, kaizen-capture, kaizen-summary, tutor — each skill the
# live stage runs) and its README, the probe's
# scripts and KEEP file copied in, a one-token token file beside it (outside
# the corpus, as the real one is), as a git repo.
fixture() {
	mkdir -p "$1/.claude-plugin" "$1/scripts"
	mkdir -p "$1/plugins/ymer/.claude-plugin"
	printf '{ "name": "ymer", "version": "0.0.1" }\n' >"$1/plugins/ymer/.claude-plugin/plugin.json"
	printf 'Install it, then run /ymer:setup — see [installing](%s).\n' '../../README.md#installing' >"$1/plugins/ymer/README.md"
	for s in ymer/setup ymer/kaizen-capture ymer/kaizen-summary ymer/tutor; do
		mkdir -p "$1/plugins/${s%/*}/skills/${s#*/}"
		printf -- '---\nname: %s\n---\nA skill; its door is /ymer:setup.\n' "${s#*/}" >"$1/plugins/${s%/*}/skills/${s#*/}/SKILL.md"
	done
	printf '{ "name": "m", "plugins": [ { "name": "ymer", "source": "./plugins/ymer" } ] }\n' >"$1/.claude-plugin/marketplace.json"
	# the README links an address: a link the references check must not
	# count as relative, at a site the KEEP row below allows
	printf 'A readme.\n\n## Installing\n\nRun /ymer:setup; the node is [Ymer Node](%s).\n' 'http://example.invalid:9999/mcp' >"$1/README.md"
	printf 'evals/results/\n' >"$1/.gitignore"
	cp "$here/hermetic-probe" "$here/hermetic-probe-static" "$here/hermetic-probe-eval" "$here/hermetic-probe-live" "$here/hermetic-probe-keep" "$1/scripts/"
	# the static stage runs the marketplace's verifier test: a stub stands in,
	# since what it tests is not this probe's business
	printf '#!/bin/sh\necho "payload-verify-test: 1 passed, 0 failed"\n' >"$1/scripts/payload-verify-test"
	printf 'README.md\t%s\n' 'http://example.invalid:9999/mcp' >>"$1/scripts/hermetic-probe-keep"
	printf 'someone-token\n' >"$1.tokens"
	git -C "$1" init -q
	git -C "$1" add -A
	git -C "$1" -c user.name=t -c user.email=t@example.invalid commit -q -m fixture
}
fixture_cases() { # fixture_cases <dir> — two eval cases
	mkdir -p "$1/evals/a" "$1/evals/b"
	printf 'name: a\n' >"$1/evals/a/case.yaml"
	printf 'name: b\n' >"$1/evals/b/case.yaml"
}
# The isError:false body a seed's execute answers with.
seed_ok='{"result":{"content":[{"text":"{}","type":"text"}],"isError":false}}'
# The body a write the node refuses on a foreign key answers with.
node_fk_refused='{"result":{"content":[{"text":"SQLite error: FOREIGN KEY constraint failed","type":"text"}],"isError":true}}'
# live_queue [<frictions count>] — every answer the live stage's happy
# path consumes, in the order the stage asks, and every file its runs
# leave behind; the count capture leaves behind defaults to 1. A queue line
# is consumed by the first request carrying its key, an answer line stays;
# answers are searched after the queue and in order. The first summary run
# is the first arm's, which stops and leaves nothing; the install between
# the arms writes the option into cfg/, the way the CLI does.
live_queue() {
	queue 'curl -sS -o /dev/null' 'rc=7'
	answer 'claude auth status' "@$canned/auth-ok.json"
	queue 'claude plugin list --json' '[]'
	queue 'claude plugin marketplace list --json' '[]'
	queue 'claude mcp list' 'No MCP servers configured. Use `claude mcp add` to add a server.'
	answer 'docker ps' 'ymer-node-install-ymer-node-1 127.0.0.1:8012->8012/tcp'
	answer '"method":"tools/list"' '{"result":{}}'
	queue '"action":"tables"' "$(node_tables 0)"
	queue 'claude plugin list --json' '[ { "id": "ymer@ymer" } ]'
	queue 'claude mcp list' 'ymer-node: http://127.0.0.1:8112/mcp (HTTP) - ✔ Connected'
	queue 'claude -p /ymer:setup' "@$canned/run-setup1.jsonl"
	queue '"action":"tables"' "$(node_tables 7)"
	queue 'FROM fronts"' "$(node_rows 1)"
	queue "tbl_name = 'topics_history'" "$(node_rows 4)"
	queue "WHERE name = 'topics'" "$(node_rows 0)"
	queue 'INTO tutor_engagements' "$node_fk_refused"
	queue 'claude -p /ymer:kaizen-capture' "@$canned/run-capture.jsonl"
	queue "kind = 'friction'\"" "$(node_rows "${1:-1}")"
	queue 'claude -p /ymer:kaizen-summary' "@$canned/run-summary-stop.jsonl"
	queue "status = 'open'\"" "$(node_rows 1)"
	queue 'FROM tasks"' "$(node_rows 0)"
	queue 'FROM topics_history"' "$(node_rows 0)"
	effect 'claude plugin install ymer@ymer --config' "printf '{\n  \"pluginConfigs\": {\n    \"ymer@ymer\": {\n      \"options\": {\n        \"state_folder\": \"%s\"\n      }\n    }\n  }\n}\n' '$pstate' >'$tmp/probe/cfg/settings.json'"
	answer 'sqlite_master' "$(node_rows 5)"
	queue 'claude -p /ymer:setup' "@$canned/run-setup2.jsonl"
	queue 'FROM fronts"' "$(node_rows 1)"
	answer '"action":"execute"' "$seed_ok"
	queue 'pragma_table_info' "$(node_rows 0)"
	queue 'claude -p /ymer:setup' "@$canned/run-setup3.jsonl"
	queue 'pragma_table_info' "$(node_rows 1)"
	answer 'claude -p /ymer:kaizen-summary' "@$canned/run-summary.jsonl"
	summary_effects ':' "$effect_drain" "$effect_batch" "$effect_append"
	queue "FROM tasks WHERE status = 'new'" "$(node_rows 1)"
	queue "FROM topics_history WHERE artifact = 'request.md'" "$(node_rows 1)"
	queue 'JOIN topics_history h ON' "$(node_rows 1)"
	queue 'SELECT drained_to FROM frictions' "$(node_text_rows "$drained_to")"
	queue "SELECT count(DISTINCT area ||" "$(node_rows 1)"
	queue 'LIMIT 1 OFFSET 0' "$(node_rows 10)"
	queue "source = 'hermetic_probe' AND status = 'drained'" "$(node_rows 10)"
	queue "SELECT count(*) FROM topics_history WHERE topic LIKE" "$(node_rows 1)"
	queue "source = 'hermetic_probe' AND status = 'drained'" "$(node_rows 20)"
	queue "SELECT count(*) FROM topics_history WHERE topic LIKE" "$(node_rows 2)"
	queue 'LIMIT 1 OFFSET 0' "$(node_rows 20)"
	queue 'LIMIT 1 OFFSET 1' "$(node_rows 10)"
	queue 'claude -p /ymer:tutor' "@$canned/run-tutor-ymer.jsonl"
	queue 'FROM tutor_subjects"' "$(node_rows 0)"
	queue 'FROM tutor_engagements"' "$(node_rows 0)"
	queue "name LIKE 'tutor%'" "$(node_rows 0)"
	queue 'claude -p /ymer:tutor' "@$canned/run-tutor-stop.jsonl"
	queue "name LIKE 'tutor%'" "$(node_rows 0)"
}

probe() { # probe <fixture> <args...> — output in $out, exit status in $rc
	fx=$1
	shift
	out=$(cd "$fx" && HERMETIC_PROBE_TOKENS=$fx.tokens HERMETIC_PROBE_DIR=$tmp/probe sh scripts/hermetic-probe "$@" 2>&1)
	rc=$?
}
lines() { printf '%s\n' "$out" | grep -c -F -- "$1"; }
live_case() { # live_case — the eval answer, compose's resolved project name, and a fresh shim state every live case starts from
	shim_reset
	answer 'claude plugin eval' "@$canned/eval-ok.json"
	answer ' config' 'name: hermetic-probe'
}

live_seeded() { # live_seeded <slash command> <trace> — live_case, then live_queue with <trace> queued ahead of it as that command's run
	live_case
	queue "claude -p $1" "@$canned/$2"
	live_queue
}

