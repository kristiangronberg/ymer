run_trace 'read' Bash '{"command":"claude mcp get ymer 2>&1; echo done"}' >"$canned/run-capture-compound.jsonl"
# the same compound, refused: the run's result event names it under
# permission_denials, so it never ran — the record is the same whether the
# runs' hook or the permission layer refused it; and `true`, the habit the
# hook refuses where no allow rule would
trace_denied='{"tool_name":"Bash","tool_use_id":"t1","tool_input":{"command":"claude mcp get ymer 2>&1; echo done"}}'
run_trace 'read' Bash '{"command":"claude mcp get ymer 2>&1; echo done"}' >"$canned/run-capture-refused.jsonl"
trace_denied='{"tool_name":"Bash","tool_use_id":"t1","tool_input":{"command":"true","description":"d"}}'
run_trace 'read' Bash '{"command":"true","description":"d"}' >"$canned/run-capture-true-refused.jsonl"
# a refusal is read by its call's id: the compound refused and then run
# again, where the one refusal takes out the first call alone; the refused
# compound with its id moved off its place after the block's type, where
# the read does not take it, so the call is never taken out; and the habit
# refused with its description ahead of its command, which never ran
# either, whatever its input's key order
trace_denied='{"tool_name":"Bash","tool_use_id":"t1","tool_input":{"command":"claude mcp get ymer 2>&1; echo done"}}'
run_trace 'read' Bash '{"command":"claude mcp get ymer 2>&1; echo done"}' Bash '{"command":"claude mcp get ymer 2>&1; echo done"}' >"$canned/run-capture-refused-then-ran.jsonl"
sed 's/"id":"t1","name":"Bash"/"name":"Bash","id":"t1"/' "$canned/run-capture-refused.jsonl" >"$canned/run-capture-refused-id-moved.jsonl"
trace_denied='{"tool_name":"Bash","tool_use_id":"t1","tool_input":{"description":"d","command":"true"}}'
run_trace 'read' Bash '{"description":"d","command":"true"}' >"$canned/run-capture-description-refused.jsonl"
trace_denied=''
# a declared command that ran with its description ahead of it: the
# command is not first, so the read does not unwrap it, and it fails closed
run_trace 'read' Bash '{"description":"d","command":"claude mcp get ymer"}' >"$canned/run-capture-description.jsonl"
run_trace 'read' Read '{"file_path":"/Users/someone/state"}' >"$canned/run-capture-outside.jsonl"
# reads under the probe dir that state/ does not hold: a session
# transcript in cfg/projects/, the login's account record in cfg/, and a
# Glob over the probe dir itself
run_trace 'read' Read "{\"file_path\":\"$tmp/probe/cfg/projects/-w/s-run.jsonl\"}" >"$canned/run-capture-cfg-transcript.jsonl"
run_trace 'read' Read "{\"file_path\":\"$tmp/probe/cfg/.claude.json\"}" >"$canned/run-capture-cfg-account.jsonl"
run_trace 'globbed' Glob "{\"pattern\":\"*.jsonl\",\"path\":\"$tmp/probe\"}" >"$canned/run-capture-probe-dir.jsonl"
# two paths that open under an allowed prefix and climb out of it, and a
# Glob whose pattern is absolute — a call with no path key at all
run_trace 'read' Read "{\"file_path\":\"$pstate/../outside\"}" >"$canned/run-capture-climb.jsonl"
run_trace 'read' Read "{\"file_path\":\"$live/../outside\"}" >"$canned/run-capture-climb-root.jsonl"
# a `..` inside a file name under state/ climbs nowhere
run_trace 'read' Read "{\"file_path\":\"$pstate/x..md\"}" >"$canned/run-capture-dots-in-name.jsonl"
run_trace 'globbed' Glob '{"pattern":"/Users/someone/state"}' >"$canned/run-capture-glob.jsonl"
# a brace glob ahead of its path: the `}` inside the pattern would end a
# read cut at the first `}` before the path key
run_trace 'globbed' Glob '{"pattern":"*.{md,yaml}","path":"/Users/someone/state"}' >"$canned/run-capture-glob-brace.jsonl"
run_trace 'searched' mcp__foo__bar '{"query":"x"}' >"$canned/run-capture-reach.jsonl"
# a server call read by its result, paired by id: the CLI's answer that
# no such tool exists — a name with no tool part, beside a notebook call
# left unanswered — reaches nothing; a foreign tool that answered, that was
# refused, or whose no-such-tool answer names another tool reached its
# server; and the call above, with no result at all, is a reach too
trace_results=$(tool_result t1 '<tool_use_error>Error: No such tool available: mcp__ymer-node</tool_use_error>' true)
run_trace 'recorded' mcp__ymer-node '{}' $notebook '{"action":"execute","data":{"sql":"INSERT INTO pool VALUES (1)"}}' >"$canned/run-capture-no-such-tool.jsonl"
trace_results=$(tool_result t1 'found' false)
run_trace 'searched' mcp__foo__bar '{"query":"x"}' >"$canned/run-capture-reach-answered.jsonl"
trace_results=$(tool_result t1 'Claude requested permissions to use mcp__foo__bar, but you have not granted it yet.' true)
run_trace 'searched' mcp__foo__bar '{"query":"x"}' >"$canned/run-capture-reach-refused.jsonl"
trace_results=$(tool_result t1 '<tool_use_error>Error: No such tool available: mcp__ymer-node</tool_use_error>' true)
run_trace 'searched' mcp__foo__bar '{"query":"x"}' >"$canned/run-capture-reach-misnamed.jsonl"
trace_results=''
trace_init='{"type":"system","subtype":"init","session_id":"s-run","mcp_servers":[{"name":"ymer-node","status":"connected","source":"dynamic"},{"name":"other","status":"connected","source":"claudeai"}]}'
run_trace 'recorded' $notebook '{"action":"execute","data":{"sql":"INSERT INTO pool VALUES (1)"}}' >"$canned/run-capture-connector.jsonl"
trace_init=$trace_init_default
# a compound behind an escaped quote: the stage reads the command as the
# whole JSON string, so what it holds runs on past the quoted name to the `;`
run_trace 'read' Bash '{"command":"claude mcp get \"ymer\"; cat ~/things-private"}' >"$canned/run-capture-quoted.jsonl"
# capture's run ending in an error, its calls kept and its result line
# swapped for one the CLI writes: stopped at max turns, which carries no
# result text, and a login lapsed mid-stage, whose subtype reads success
sed '$d' "$canned/run-capture.jsonl" >"$canned/run-capture-failed.jsonl"
printf '%s\n' '{"type":"result","subtype":"error_max_turns","is_error":true,"terminal_reason":"max_turns","num_turns":2,"permission_denials":[]}' >>"$canned/run-capture-failed.jsonl"
sed '$d' "$canned/run-capture.jsonl" >"$canned/run-capture-expired.jsonl"
printf '%s\n' '{"type":"result","subtype":"success","is_error":true,"terminal_reason":"api_error","result":"Failed to authenticate: OAuth session expired and could not be refreshed","permission_denials":[]}' >>"$canned/run-capture-expired.jsonl"
# tutor at its guard: with no ymer, the docs' home named; with no tables,
# setup named — each having only read the node
run_trace "Tutor skill — stopped: no ymer docs tool in this session. The knowledge and engagement docs live in ymer, so nothing was opened." $notebook '{"action":"query","data":{"sql":"SELECT subject FROM tutor_subjects"}}' >"$canned/run-tutor-ymer.jsonl"
run_trace "Tutor skill — stopped: the notebook has no tutor_subjects or tutor_engagements table. Run /ymer:setup, which creates both." $notebook '{"action":"query","data":{"sql":"SELECT name FROM sqlite_master"}}' >"$canned/run-tutor-stop.jsonl"
# tutor's stop naming only the node, by its name and its server name:
# neither names ymer, the docs' home
run_trace "Tutor skill — stopped: no docs tool on the Ymer Node, and ymer-node has none." $notebook '{"action":"query","data":{"sql":"SELECT subject FROM tutor_subjects"}}' >"$canned/run-tutor-node-only.jsonl"
# tutor's stop opening its line on a word it names, and one naming ymer
# only behind a colon, which is no word of its own
run_trace "Docs live in ymer, which this session cannot reach, so tutor stopped before opening anything." $notebook '{"action":"query","data":{"sql":"SELECT subject FROM tutor_subjects"}}' >"$canned/run-tutor-line-start.jsonl"
run_trace "Tutor skill — stopped: no tutor tool answered; see docs:ymer for details." $notebook '{"action":"query","data":{"sql":"SELECT subject FROM tutor_subjects"}}' >"$canned/run-tutor-colon-before.jsonl"
# The session transcripts the instructions check reads, under the probe
# dir's cfg/projects/ and found by the session id on a trace's init line:
# the one every canned run names, recording its environment and no
# instructions file, and one per variant a case seeds — a file loaded
# after the first turn, a nested file reached through a read, no
# environment recorded, no transcript at all, and a clean main transcript
# whose subagent loads a file. The stage wipes cfg/projects/ at its
# start, so they are kept in canned/ and planted by the control call's
# effect: the first headless call, after the wipe.
transcripts=$tmp/probe/cfg/projects
kept=$canned/transcripts
env_line='{"type":"attachment","attachment":{"type":"environment","snapshot":{"workingDirectory":"/w"}}}'
instr_line='{"type":"attachment","attachment":{"type":"instructions","files":[{"path":"/someone/.claude/CLAUDE.md","type":"Project","content":"x"}]}}'
nested_line='{"type":"attachment","attachment":{"type":"nested_memory","path":"/someone/project/CLAUDE.md","content":{"path":"/someone/project/CLAUDE.md","type":"Project","content":"x"},"displayPath":"CLAUDE.md"}}'
mkdir -p "$kept/-w/s-subagent/subagents"
printf '%s\n' '{"type":"user"}' "$env_line" >"$kept/-w/s-run.jsonl"
printf '%s\n' "$env_line" '{"type":"user"}' "$instr_line" >"$kept/-w/s-loaded.jsonl"
printf '%s\n' "$env_line" '{"type":"user"}' "$nested_line" >"$kept/-w/s-nested.jsonl"
printf '%s\n' '{"type":"user"}' >"$kept/-w/s-noenv.jsonl"
printf '%s\n' "$env_line" >"$kept/-w/s-subagent.jsonl"
printf '%s\n' "$env_line" "$instr_line" >"$kept/-w/s-subagent/subagents/agent-1.jsonl"
for v in loaded nested noenv missing subagent; do
	sed "s/\"session_id\":\"s-run\"/\"session_id\":\"s-$v\"/" "$canned/run-capture.jsonl" >"$canned/run-capture-$v.jsonl"
done
# A mint that dispatched its scorers: the healthy mint trace under a
# session of its own, one subagent call pinned to haiku before its result
# line, and that session's transcripts kept with a subagent's beside it
mkdir -p "$kept/-w/s-scorer/subagents"
printf '%s\n' "$env_line" >"$kept/-w/s-scorer.jsonl"
printf '%s\n' "$env_line" >"$kept/-w/s-scorer/subagents/agent-1.jsonl"
{
	sed -e '$d' -e 's/"session_id":"s-run"/"session_id":"s-scorer"/' "$canned/run-mint.jsonl"
	printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t99","name":"Agent","input":{"description":"score drops","subagent_type":"general-purpose","model":"haiku","prompt":"x"}}]}}'
	tail -n 1 "$canned/run-mint.jsonl"
} >"$canned/run-mint-scorer.jsonl"
# The control call: its trace names a session of its own, and its effect —
# run in the control's working directory, as the call is — plants the
# runs' transcripts kept above and that session's own, recording the
# planted CLAUDE.md by its physical path alone, beside another file, or no
# file at all.
trace_init=$(printf '%s' "$trace_init_default" | sed 's/"s-run"/"s-control"/')
run_trace 'ok' >"$canned/run-control.jsonl"
trace_init=$trace_init_default
cat >"$canned/plant-control" <<EOF
# plant-control <planted | another | none> — the runs' transcripts, and the control session's
mkdir -p '$transcripts/-control'
cp -R '$kept/.' '$transcripts/'
f=\$(pwd -P)/CLAUDE.md
{
	printf '%s\n' '$env_line'
	case \$1 in
	planted) printf '{"type":"attachment","attachment":{"type":"instructions","files":[{"path":"%s","type":"Project"}]}}\n' "\$f" ;;
	another) printf '{"type":"attachment","attachment":{"type":"instructions","files":[{"path":"%s","type":"Project"},{"path":"/someone/CLAUDE.md","type":"Project"}]}}\n' "\$f" ;;
	esac
} >'$transcripts/-control/s-control.jsonl'
EOF
# A capture trace written where a headless call runs: its one call reads
# notes.md in that working directory by its physical path.
cat >"$canned/cwd-read-trace" <<'EOF'
# cwd-read-trace <init line> <trace file>
printf '%s\n' "$1" >"$2"
printf '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"Read","input":{"file_path":"%s/notes.md"}}]}}\n' "$(pwd -P)" >>"$2"
printf '%s\n' '{"is_error":false,"subtype":"success","type":"result","result":"recorded","permission_denials":[]}' >>"$2"
EOF
node_rows() { # node_rows <n> — a query answer whose first cell is <n>
	printf '{"result":{"content":[{"text":"{\\"columns\\":[\\"n\\"],\\"rows\\":[[%s]]}","type":"text"}],"isError":false}}' "$1"
}
node_tables() { # node_tables <n> — a tables answer counting <n>
	printf '{"result":{"content":[{"text":"{\\"count\\":%s,\\"tables\\":[]}","type":"text"}],"isError":false}}' "$1"
}
node_text_rows() { # node_text_rows <text> — a query answer whose first cell is the text <text>
	printf '{"result":{"content":[{"text":"{\\"columns\\":[\\"t\\"],\\"rows\\":[[\\"%s\\"]]}","type":"text"}],"isError":false}}' "$1"
}
# The files a mint run leaves in state/, written by the claude shim's
# effect for that run: the topic run 6 drains to, the bug's topic run 7
# opens — its line quoting the bug's title once — and run 8's fold of the
# bug's recurrence into it, the started date kept.
drained_to='demo/2026/09-21-probe-topic/'
bug_to='demo/2026/09-21-probe-bug/'
bug_dir=$pstate/$bug_to
bug_title='Probe gauge reads its dial backwards'
recur_clause='the gauge stuck at noon on the second seeded pass'
bug_body() { # bug_body <started> <recurrences> — the bug topic's request.md
	printf -- '---\nsource: mint\ntask: 2\nstarted: %s\n---\n\n# probe-bug\n\n**Root cause.** The gauge is wired in reverse.\n\nDrops, verbatim from the pool:\n\n- 2026-09-21 · hermetic_probe@probe/seed — bug: %s (#12)\n' "$1" "$bug_title"
	i=0
	while [ "$i" -lt "$2" ]; do
		i=$((i + 1))
		printf -- '- 2026-09-21 · hermetic_probe@probe/seed — bug: recurrence of #12 — %s (#%s)\n' "$recur_clause" $((12 + i))
	done
}
bug_body 2026-09-21 0 >"$canned/bug-0.md"
bug_body 2026-09-21 1 >"$canned/bug-1.md"
bug_body 2026-09-22 1 >"$canned/bug-1-redated.md"
# mint_effects <run 3> <run 6> <run 7> <run 8> — what each mint run
# leaves on disk, replacing any queued before; `:` leaves nothing
mint_effects() {
	shim_drop effects 'claude -p /ymer:mint'
	for e in "$@"; do effect 'claude -p /ymer:mint' "$e"; done
}
effect_drain="mkdir -p '$pstate/$drained_to' && printf 'x\n' >'$pstate/${drained_to}request.md'"
effect_bug="mkdir -p '$bug_dir' && cp '$canned/bug-0.md' '${bug_dir}request.md'"
effect_append="cp '$canned/bug-1.md' '${bug_dir}request.md'"

# ── fixtures ──────────────────────────────────────────────────────────
# fixture <dir> — a marketplace shaped like this one: the plugin ymer
# (skills setup, capture, mint, tutor — each skill the
# live stage runs) and its README, the probe's
# scripts and KEEP file copied in, a one-token token file beside it (outside
# the corpus, as the real one is), as a git repo.
fixture() {
	mkdir -p "$1/.claude-plugin" "$1/scripts"
	mkdir -p "$1/plugins/ymer/.claude-plugin"
	printf '{ "name": "ymer", "version": "0.0.1" }\n' >"$1/plugins/ymer/.claude-plugin/plugin.json"
	printf 'Install it, then run /ymer:setup — see [installing](%s).\n' '../../README.md#installing' >"$1/plugins/ymer/README.md"
	for s in ymer/setup ymer/capture ymer/mint ymer/tutor; do
		mkdir -p "$1/plugins/${s%/*}/skills/${s#*/}"
		printf -- '---\nname: %s\n---\nA skill; its door is /ymer:setup.\n' "${s#*/}" >"$1/plugins/${s%/*}/skills/${s#*/}/SKILL.md"
	done
	printf '{ "name": "m", "plugins": [ { "name": "ymer", "source": "./plugins/ymer" } ] }\n' >"$1/.claude-plugin/marketplace.json"
	# the README links an address: a link the references check must not
	# count as relative, at a site the KEEP row below allows
	printf 'A readme.\n\n## Installing\n\nRun /ymer:setup; the node is [Ymer Node](%s).\n' 'http://example.invalid:9999/mcp' >"$1/README.md"
	printf 'evals/results/\n' >"$1/.gitignore"
	cp "$here/hermetic-probe" "$here/hermetic-probe-static" "$here/hermetic-probe-eval" "$here/hermetic-probe-live" "$here/hermetic-probe-keep" "$1/scripts/"
	# the static stage runs the marketplace's verifier test: a stub stands in,
	# since what it tests is not this probe's business
	printf '#!/bin/sh\necho "payload-verify-test: 1 passed, 0 failed"\n' >"$1/scripts/payload-verify-test"
	printf 'README.md\t%s\n' 'http://example.invalid:9999/mcp' >>"$1/scripts/hermetic-probe-keep"
	printf 'someone-token\n' >"$1.tokens"
	git -C "$1" init -q
	git -C "$1" add -A
	git -C "$1" -c user.name=t -c user.email=t@example.invalid commit -q -m fixture
}
fixture_cases() { # fixture_cases <dir> — two eval cases
	mkdir -p "$1/evals/a" "$1/evals/b"
	printf 'name: a\n' >"$1/evals/a/case.yaml"
	printf 'name: b\n' >"$1/evals/b/case.yaml"
}
# The isError:false body a seed's execute answers with.
seed_ok='{"result":{"content":[{"text":"{}","type":"text"}],"isError":false}}'
# The body a write the node refuses on a foreign key answers with.
node_fk_refused='{"result":{"content":[{"text":"SQLite error: FOREIGN KEY constraint failed","type":"text"}],"isError":true}}'
# live_queue [<friction drops count>] — every answer the live stage's happy
# path consumes, in the order the stage asks, and every file its runs
# leave behind; the count capture leaves behind defaults to 1. A queue line
# is consumed by the first request carrying its key, an answer line stays;
# answers are searched after the queue and in order. The first mint run
# is the first arm's, which stops and leaves nothing; each install writes
# its options into cfg/, the way the CLI does — the first the front alone,
# the one between the arms the front and state/.
live_queue() {
	queue 'curl -sS -o /dev/null' 'rc=7'
	answer 'claude -p Say the single word' "@$canned/login-ok.jsonl"
	queue 'claude plugin list --json' '[]'
	queue 'claude plugin marketplace list --json' '[]'
	queue 'claude mcp list' 'No MCP servers configured. Use `claude mcp add` to add a server.'
	answer 'docker ps' 'ymer-node-install-ymer-node-1 127.0.0.1:8012->8012/tcp'
	answer '"method":"tools/list"' '{"result":{}}'
	queue '"action":"tables"' "$(node_tables 0)"
	queue 'claude plugin list --json' '[ { "id": "ymer@ymer" } ]'
	queue 'claude mcp list' 'ymer-node: http://127.0.0.1:8112/mcp (HTTP) - ✔ Connected'
	effect 'claude plugin install ymer@ymer --config front=probe_front' "printf '{\n  \"pluginConfigs\": {\n    \"ymer@ymer\": {\n      \"options\": {\n        \"front\": \"probe_front\"\n      }\n    }\n  }\n}\n' >'$tmp/probe/cfg/settings.json'"
	queue 'claude -p Reply with' "@$canned/run-control.jsonl"
	effect 'claude -p Reply with' "sh '$canned/plant-control' planted"
	queue 'claude -p /ymer:setup' "@$canned/run-setup1.jsonl"
	queue '"action":"tables"' "$(node_tables 9)"
	queue 'FROM fronts"' "$(node_rows 1)"
	queue "FROM fronts WHERE slug = 'probe_front'\"" "$(node_rows 1)"
	queue "tbl_name = 'topics_history'" "$(node_rows 4)"
	queue "WHERE name = 'topics'" "$(node_rows 0)"
	queue 'INTO tutor_engagements' "$node_fk_refused"
	queue 'claude -p /ymer:capture' "@$canned/run-capture.jsonl"
	queue "kind = 'friction'\"" "$(node_rows "${1:-1}")"
	queue "kind = 'friction' AND front = 'probe_front'\"" "$(node_rows "${1:-1}")"
	queue 'claude -p /ymer:mint' "@$canned/run-mint-stop.jsonl"
	queue "status = 'open'\"" "$(node_rows 1)"
	queue 'FROM tasks"' "$(node_rows 0)"
	queue 'FROM topics_history"' "$(node_rows 0)"
	queue 'FROM pool_scores"' "$(node_rows 0)"
	effect 'claude plugin install ymer@ymer --config' "printf '{\n  \"pluginConfigs\": {\n    \"ymer@ymer\": {\n      \"options\": {\n        \"front\": \"probe_front\",\n        \"state_folder\": \"%s\"\n      }\n    }\n  }\n}\n' '$pstate' >'$tmp/probe/cfg/settings.json'"
	answer 'sqlite_master' "$(node_rows 5)"
	queue 'claude -p /ymer:setup' "@$canned/run-setup2.jsonl"
	queue 'FROM fronts"' "$(node_rows 1)"
	answer '"action":"execute"' "$seed_ok"
	queue 'pragma_table_info' "$(node_rows 0)"
	queue 'claude -p /ymer:setup' "@$canned/run-setup3.jsonl"
	queue 'pragma_table_info' "$(node_rows 1)"
	answer 'claude -p /ymer:mint' "@$canned/run-mint.jsonl"
	mint_effects ':' "$effect_drain" "$effect_bug" "$effect_append"
	queue "FROM tasks WHERE status = 'claimed'" "$(node_rows 1)"
	queue "FROM topics_history WHERE artifact = 'request.md'\"" "$(node_rows 1)"
	queue "artifact = 'request.md' AND front = 'probe_front'\"" "$(node_rows 1)"
	queue 'f JOIN topics_history h ON' "$(node_rows 1)"
	queue "SELECT drained_to FROM pool WHERE status = 'drained' AND kind" "$(node_text_rows "$drained_to")"
	queue 'LEFT JOIN pool_scores' "$(node_rows 0)"
	queue "source = 'mint'\"" "$(node_rows 2)"
	queue "kind = 'bug' AND anchor_id IS NULL" "$(node_rows 12)"
	queue "SELECT drained_to FROM pool WHERE status = 'drained' AND id" "$(node_text_rows "$bug_to")"
	queue 'p JOIN topics_history h ON' "$(node_rows 1)"
	queue "kind = 'friction' AND source = 'hermetic_probe'" "$(node_rows 10)"
	queue 'LIMIT 1 OFFSET 0' "$(node_rows 1)"
	queue "SELECT count(*) FROM topics_history WHERE area ||" "$(node_rows 1)"
	queue "SELECT drained_to FROM pool WHERE status = 'drained' AND anchor_id" "$(node_text_rows "$bug_to")"
	queue "SELECT count(*) FROM topics_history WHERE area ||" "$(node_rows 2)"
	queue 'LIMIT 1 OFFSET 0' "$(node_rows 1)"
	queue 'LIMIT 1 OFFSET 1' "$(node_rows 0)"
	queue 'claude -p /ymer:tutor' "@$canned/run-tutor-ymer.jsonl"
	queue 'FROM tutor_subjects"' "$(node_rows 0)"
	queue 'FROM tutor_engagements"' "$(node_rows 0)"
	queue "name LIKE 'tutor%'" "$(node_rows 0)"
	queue 'claude -p /ymer:tutor' "@$canned/run-tutor-stop.jsonl"
	queue "name LIKE 'tutor%'" "$(node_rows 0)"
}

probe() { # probe <fixture> <args...> — output in $out, exit status in $rc
	fx=$1
	shift
	# the entry's temp dir, and the live runs' working directories in it,
	# under $tmp whatever TMPDIR the caller carries
	mkdir -p "$tmp/tmpdir"
	out=$(cd "$fx" && TMPDIR=$tmp/tmpdir HERMETIC_PROBE_TOKENS=$fx.tokens HERMETIC_PROBE_DIR=$tmp/probe sh scripts/hermetic-probe "$@" 2>&1)
	rc=$?
}
lines() { printf '%s\n' "$out" | grep -c -F -- "$1"; }
live_case() { # live_case — the eval answer, compose's resolved project name, and a fresh shim state every live case starts from
	shim_reset
	answer 'claude plugin eval' "@$canned/eval-ok.json"
	answer ' config' 'name: hermetic-probe'
}

live_seeded() { # live_seeded <slash command> <trace> — live_case, then live_queue with <trace> queued ahead of it as that command's run
	live_case
	queue "claude -p $1" "@$canned/$2"
	live_queue
}

