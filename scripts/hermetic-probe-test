# ── 15b · live, the runs' hook over its own events ────────────────────
# the files the happy path left in the probe dir: the settings file loads
# the hook on Bash, and the hook, fed a PreToolUse event the way the CLI
# writes one, lets a declared command run (exit 0) and refuses every other
# (exit 2) — a habit, a compound, another redirect, another folder, and an
# event whose input does not open with the command
hook_event() { # hook_event <command as its JSON string spells it> — the hook's exit status for a Bash event carrying it
	printf '{"session_id":"s","hook_event_name":"PreToolUse","tool_name":"Bash","tool_input":{"command":"%s","description":"d"},"tool_use_id":"t1"}' "$1" | sh "$tmp/probe/hook/bash" 2>/dev/null
	echo $?
}
hook_settings="{\"hooks\":{\"PreToolUse\":[{\"matcher\":\"Bash\",\"hooks\":[{\"type\":\"command\",\"command\":\"sh '$tmp/probe/hook/bash'\"}]}]}}"
check "live hook: the settings file loads it on Bash, and nothing else" "$hook_settings" "$(cat "$tmp/probe/hook/settings.json" 2>/dev/null)"
check "live hook: the declared commands run" '0 0 0 0' "$(printf '%s %s %s %s' "$(hook_event 'claude mcp get ymer')" "$(hook_event 'claude mcp get ymer 2>&1')" "$(hook_event "git -C $pstate rev-parse --is-inside-work-tree")" "$(hook_event "git -C \\\"$pstate\\\" rev-parse --is-inside-work-tree")")"
check "live hook: every other command is refused" '2 2 2 2 2' "$(printf '%s %s %s %s %s' "$(hook_event 'true')" "$(hook_event 'claude mcp get ymer 2>&1; echo \"---\"')" "$(hook_event 'claude mcp get ymer 2>/dev/null')" "$(hook_event 'git -C /Users/someone/state rev-parse --is-inside-work-tree')" "$(printf '{"tool_name":"Bash","tool_input":{"description":"d","command":"claude mcp get ymer"}}' | sh "$tmp/probe/hook/bash" 2>/dev/null; echo $?)")"
check "live hook: a refusal names the declared commands to the model" 1 "$(printf '{"tool_input":{"command":"true"}}' | sh "$tmp/probe/hook/bash" 2>&1 >/dev/null | grep -c -F '`claude mcp get <name>`')"

