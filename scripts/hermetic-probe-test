rm -rf "$eval_runs"

# ── 10b · eval, the runner writing no result ──────────────────────────
# no result names no failed run, so nothing is copied, and the dir the
# runner kept is still removed on the way out
shim_reset
answer 'claude plugin eval' 'rc=3'
effect 'claude plugin eval' "sh '$canned/keep-runs' 1"
probe "$fx" eval
check "eval no result exits 2" 2 "$rc"
check "eval no result: the runner line" 1 "$(lines "✘ runner       claude plugin eval wrote no result (exit 3) — read $fx/evals/results/hermetic-probe.log")"
check "eval no result: the kept dir removed" 0 "$(ls "$evals_kept" | wc -l | tr -d ' ')"
check "eval no result: no trace copied" 0 "$(test -e "$eval_runs" && echo 1 || echo 0)"

# ── 10c · eval, a kept dir that outlives its removal ──────────────────
# a kept dir its parent will not let go is named with the commands that
# remove it; a notice naming a directory not shaped like the runner's own
# never has it removed, nor one whose e- name sits above its last component
shim_reset
answer 'claude plugin eval' "@$canned/eval-ok.json"
effect 'claude plugin eval' "sh '$canned/keep-runs' 1 2 && chmod 500 '$evals_kept' && mkdir -p '$tmp/precious/out' '$tmp/e-mail/y/out' && echo '⚠ kept $tmp/precious: sealed' >&2 && echo '⚠ kept $tmp/e-mail/y: sealed' >&2"
probe "$fx" eval
chmod 700 "$evals_kept"
check "eval kept dir left exits 1" 1 "$rc"
check "eval kept dir left: the kept line names both dirs" 1 "$(lines "✘ kept         the runner's kept temp dir(s) $evals_kept/e-1 $evals_kept/e-2 outlived their removal — remove each: chmod 700 <dir> <dir>/sealed && rm -rf <dir>")"
check "eval kept dir left: a directory not shaped like the runner's is never removed" 1 "$(test -d "$tmp/precious/out" && echo 1)"
check "eval kept dir left: a directory named e- only above its last component is never removed" 1 "$(test -d "$tmp/e-mail/y/out" && echo 1)"
rm -rf "$evals_kept"/e-* "$tmp/precious" "$tmp/e-mail"

# ── 10d · eval, interrupted while the runner runs ─────────────────────
# a run ended by a signal before the stage removed what the runner kept:
# the exit trap removes the kept dirs on its way out
shim_reset
answer 'claude plugin eval' "@$canned/eval-ok.json"
effect 'claude plugin eval' "sh '$canned/keep-runs' 1 2 && kill -TERM \$(ps -o ppid= -p \$PPID | tr -d ' ')"
probe "$fx" eval
check "eval interrupted exits 143" 143 "$rc"
check "eval interrupted: every kept dir removed" 0 "$(ls "$evals_kept" | wc -l | tr -d ' ')"

# ── 10e · eval, a result in a layout the stage does not read ──────────
# each miss alone turns the layout line red and keeps every dir the runner
# kept, named on that line; a re-indented result is caught on an all-green
# run too, and on a partial run the layout line comes ahead of the runner
# line; a result with no root start time copies nothing anywhere, and one
# with no casesTotal, or two, is a miss rather than a count that passes
eval_layout() { # eval_layout <canned result> — run it with both runs kept
	shim_reset
	answer 'claude plugin eval' "@$canned/$1"
	effect 'claude plugin eval' "sh '$canned/keep-runs' 1 2"
	probe "$fx" eval
}
eval_unkeep() { # eval_unkeep — open and remove the dirs a layout red kept
	chmod 700 "$evals_kept"/e-* "$evals_kept"/e-*/sealed
	rm -rf "$evals_kept"/e-*
}
layout_kept="the runner's kept temp dir(s) $evals_kept/e-1 $evals_kept/e-2 are left for inspection — remove each after: chmod 700 <dir> <dir>/sealed && rm -rf <dir>"
eval_layout eval-reindented.json
check "eval re-indented exits 1" 1 "$rc"
check "eval re-indented: the layout line names the miss, the result and the kept dirs" 1 "$(lines "✘ layout       the runner's result is not in the layout this stage reads (0 run-level tracePath line(s) for 2 run(s)), so no failed run's trace can be found — read $fx/evals/results/hermetic-probe.json and bring the reads in scripts/hermetic-probe-eval to it; $layout_kept")"
check "eval re-indented: the cases still read green" 1 "$(lines '✔ cases        2 cases, 2 passed on claude-sonnet-5')"
check "eval re-indented: both kept dirs survive" 2 "$(ls "$evals_kept" | wc -l | tr -d ' ')"
eval_unkeep
eval_layout eval-reindented-partial.json
check "eval re-indented partial exits 1" 1 "$rc"
check "eval re-indented partial: the layout line, then the runner line" 'layout runner' "$(printf '%s\n' "$out" | awk '/✘ layout/ { s = s " layout" } /✘ runner/ { s = s " runner" } END { print substr(s, 2) }')"
check "eval re-indented partial: both kept dirs survive" 2 "$(ls "$evals_kept" | wc -l | tr -d ' ')"
eval_unkeep
rm -rf "$eval_runs"
eval_layout eval-schema2.json
check "eval schemaVersion 2 exits 1" 1 "$rc"
check "eval schemaVersion 2: the layout line names the miss" 1 "$(lines '(schemaVersion 2, not 1), so no failed run')"
check "eval schemaVersion 2: both kept dirs survive" 2 "$(ls "$evals_kept" | wc -l | tr -d ' ')"
check "eval schemaVersion 2: no trace copied into the results dir" 0 "$(find "$fx/evals/results" -name '*.trace.jsonl' | wc -l | tr -d ' ')"
check "eval schemaVersion 2: no line names a trace" 0 "$(lines 'traces kept in')"
eval_unkeep
eval_layout eval-noschema.json
check "eval no schemaVersion exits 1" 1 "$rc"
check "eval no schemaVersion: the layout line names the miss" 1 "$(lines '(no schemaVersion at its root), so no failed run')"
check "eval no schemaVersion: both kept dirs survive" 2 "$(ls "$evals_kept" | wc -l | tr -d ' ')"
eval_unkeep
rm -rf "$eval_runs"
eval_layout eval-nostart.json
check "eval no startedAt exits 1" 1 "$rc"
check "eval no startedAt: the layout line names the miss" 1 "$(lines '(no startedAt at its root), so no failed run')"
check "eval no startedAt: both kept dirs survive" 2 "$(ls "$evals_kept" | wc -l | tr -d ' ')"
check "eval no startedAt: no trace copied into the results dir" 0 "$(find "$fx/evals/results" -name '*.trace.jsonl' | wc -l | tr -d ' ')"
eval_unkeep
eval_layout eval-nototal.json
check "eval no casesTotal exits 1" 1 "$rc"
check "eval no casesTotal: the layout line names the miss" 1 "$(lines '(no single casesTotal to count its runs by), so no failed run')"
check "eval no casesTotal: both kept dirs survive" 2 "$(ls "$evals_kept" | wc -l | tr -d ' ')"
eval_unkeep
eval_layout eval-twototals.json
check "eval two casesTotal exits 1" 1 "$rc"
check "eval two casesTotal: the layout line names the miss" 1 "$(lines '(no single casesTotal to count its runs by), so no failed run')"
check "eval two casesTotal: both kept dirs survive" 2 "$(ls "$evals_kept" | wc -l | tr -d ' ')"
eval_unkeep

