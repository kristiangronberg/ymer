check "eval fail: the failed run's trace, copied whole" '{"type":"result","result":"case-2 trace"}' "$(cat "$eval_runs/case-2.trace.jsonl" 2>/dev/null)"
check "eval fail: the passed run's trace not copied" 0 "$(test -e "$eval_runs/case-1.trace.jsonl" && echo 1 || echo 0)"
check "eval fail: every kept dir removed" 0 "$(ls "$evals_kept" | wc -l | tr -d ' ')"
rm -rf "$eval_runs"

