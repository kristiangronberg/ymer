#!/bin/sh
# hermetic-probe-test — self-test for hermetic-probe and its stage files.
# Run it after any edit to them: it works in a temp directory, calls no
# model and touches no real node or config — `claude`, `docker`,
# `docker-compose` and `curl` are shims first on PATH that record their
# argv and replay canned output, and a shimmed call can leave files behind
# the way a real run leaves them in state/, so what is tested is the
# probe's own logic: the sweeps and their KEEP filter (a value beside an
# allowed one, a value running on past one, a binary file, a nested
# checkout in the corpus, an empty corpus, the token file's shape), the
# reference rules, the runner's result read — a failed run's trace kept,
# every temp dir the runner kept removed, and every one kept when the
# result is in a layout the read does not know — the login call — no login, an
# error of another kind, no result line, a long text cut — the scrub,
# prompt-before-flags and the strict MCP config, the node read-back,
# teardown on failure — a failed `up` included — the compose copy's
# project name checked before `up` and again before `down`, a wrong one
# refused at either end, each live precondition's exit 2, a run that
# ended in an error — stopped at max turns, or its login lapsed — the two
# arms and the option between them, the seeded
# steps' not-run lines, the state reads' deltas over the node and state/,
# the history read, setup's report read for its facts — dressed, its
# role lines carried onto the lines under them, a word inside a longer
# one, and naming a wrong node address or another port — tutor's stop
# naming the node alone, the behaviour checks — an input carrying a
# brace or an escaped quote included, a server call read by its result, a
# refusal read by its call's id —
# the runs' working directory outside the home tree — a TMPDIR under it
# refused — and a read under that directory, a read under the probe dir
# outside state/, the wipe of cfg/projects/ — a set left by earlier
# sessions, none, and a wipe that cannot finish — the instructions check — a
# file loaded in a run or in its subagent, a transcript missing or with
# no environment, the control recording its planted file, none, or
# another beside it — the runs' hook over its own events, the one model
# pin, the static
# stage's verifier check — its test passing, failing and missing — and
# the exit codes.
#
#   scripts/hermetic-probe-test
#
# Exit 0 = every case passed.

set -u

here=$(cd "$(dirname "$0")" && pwd)
# physical, as the live stage normalises its probe dir: mktemp's path sits
# under a symlink on macOS, and the report lines the cases read spell $tmp
tmp=$(cd "$(mktemp -d)" && pwd -P)
# opened first: a kept dir a red case leaves behind is sealed read-only
trap 'chmod -R u+rwx "$tmp" 2>/dev/null; rm -rf "$tmp"' EXIT

pass=0
fail=0

check() { # check <name> <expected> <actual>
	if [ "$2" = "$3" ]; then
		pass=$((pass + 1))
		echo "ok   — $1"
	else
		fail=$((fail + 1))
		echo "FAIL — $1"
		echo "       expected: $2"
		echo "       actual:   $3"
	fi
}

# ── shims ─────────────────────────────────────────────────────────────
# One body for all four: log `<command> <argv>`, then answer from
# $SHIM_DIR/queue (first line whose key is a substring of the argv,
# consumed) or $SHIM_DIR/answers (the same, kept), where a line is
# `<key><TAB><response>` and a response is text, `@<file>` or `rc=<n>`.
# A `-o <file>`/`--json <file>` argument receives the text instead of
# stdout.
SHIM_DIR=$tmp/shim
export SHIM_DIR
mkdir -p "$tmp/bin" "$SHIM_DIR"
for cmd in claude docker docker-compose curl; do
	cat >"$tmp/bin/$cmd" <<'EOF'
#!/bin/sh
me=$(basename "$0")
printf '%s %s\n' "$me" "$*" >>"$SHIM_DIR/log"
# a headless call's working directory, physical, as the CLI records it
[ "$me $1" = 'claude -p' ] && pwd -P >>"$SHIM_DIR/cwds"
[ -n "${ANTHROPIC_API_KEY+x}" ] && echo "$me: ANTHROPIC_API_KEY is set" >>"$SHIM_DIR/log"
key=$(printf '%s %s' "$me" "$*" | tr '\n' ' ')
out=''
json=''
prev=''
for a in "$@"; do
	case $prev in
	-o) out=$a ;;
	--json) json=$a ;;
	esac
	prev=$a
done
resp=''
for src in queue answers; do
	f=$SHIM_DIR/$src
	[ -f "$f" ] || continue
	n=$(awk -v k="$key" -F'\t' '{ if (index(k, $1) > 0) { print NR; exit } }' "$f")
	[ -n "$n" ] || continue
	resp=$(sed -n "${n}p" "$f" | cut -f2-)
	if [ "$src" = queue ]; then
		sed "${n}d" "$f" >"$f.new" && mv "$f.new" "$f"
	fi
	break
done
# a call's side effect: the first line of $SHIM_DIR/effects whose key is a
# substring of the argv, consumed, run as a shell command — what a real
# run leaves on disk, a run that then exits non-zero included
if [ -f "$SHIM_DIR/effects" ]; then
	n=$(awk -v k="$key" -F'\t' '{ if (index(k, $1) > 0) { print NR; exit } }' "$SHIM_DIR/effects")
	if [ -n "$n" ]; then
		eff=$(sed -n "${n}p" "$SHIM_DIR/effects" | cut -f2-)
		sed "${n}d" "$SHIM_DIR/effects" >"$SHIM_DIR/effects.new" && mv "$SHIM_DIR/effects.new" "$SHIM_DIR/effects"
		sh -c "$eff"
	fi
fi
case $resp in
rc=*) exit "${resp#rc=}" ;;
@*) body=$(cat "${resp#@}") ;;
*) body=$resp ;;
esac
if [ -n "$out" ]; then
	printf '%s\n' "$body" >"$out"
elif [ -n "$json" ]; then
	printf '%s\n' "$body" >"$json"
else
	printf '%s\n' "$body"
fi
exit 0
EOF
	chmod +x "$tmp/bin/$cmd"
done
PATH=$tmp/bin:$PATH
export PATH

shim_reset() { # shim_reset — empty log, working directories, queue, answers and effects
	: >"$SHIM_DIR/log"
	: >"$SHIM_DIR/cwds"
	: >"$SHIM_DIR/queue"
	: >"$SHIM_DIR/answers"
	: >"$SHIM_DIR/effects"
}
queue() { printf '%s\t%s\n' "$1" "$2" >>"$SHIM_DIR/queue"; }
answer() { printf '%s\t%s\n' "$1" "$2" >>"$SHIM_DIR/answers"; }
effect() { printf '%s\t%s\n' "$1" "$2" >>"$SHIM_DIR/effects"; }
# requeue/reanswer <key> [<response>]... — drop every line keyed exactly
# <key>, then add one line per response: how a case replaces what
# live_queue put there
shim_drop() { # shim_drop <queue|answers|effects> <key> — the one drop-by-key they share
	awk -F'\t' -v k="$2" '$1 != k' "$SHIM_DIR/$1" >"$SHIM_DIR/$1.new" && mv "$SHIM_DIR/$1.new" "$SHIM_DIR/$1"
}
requeue() {
	k=$1
	shift
	shim_drop queue "$k"
	for r in "$@"; do queue "$k" "$r"; done
}
reanswer() {
	k=$1
	shift
	shim_drop answers "$k"
	for r in "$@"; do answer "$k" "$r"; done
}
logged() { grep -c -F -- "$1" "$SHIM_DIR/log"; }
# The live stage's compose call, from its own copy of the compose file, and
# the bash-commands failure's text up to its run list — each spelled once
scratch_dc="docker-compose -p hermetic-probe -f $tmp/probe/compose/docker-compose.yml"
bash_other='✘ bash-commands a Bash command other than `claude mcp get <name>` or the state folder'"'"'s `rev-parse` in run(s)'

# ── canned output ─────────────────────────────────────────────────────
canned=$tmp/canned
mkdir -p "$canned"
# The login call's traces, each its result line alone as the CLI writes
# one: a login that answered; no login, an error whose subtype still reads
# success; an error of another kind whose text runs onto a second line;
# one whose text runs past the 200 characters the red line quotes; and an
# error whose line names no terminal_reason. Three leave no result line:
# an empty trace, one ending on a tool result that carries
# "is_error":false, and one whose result line was cut off after its
# "is_error":false.
printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"terminal_reason":"completed","result":"ok"}' >"$canned/login-ok.jsonl"
printf '%s\n' '{"type":"result","subtype":"success","is_error":true,"terminal_reason":"api_error","result":"Not logged in · Please run /login"}' >"$canned/login-none.jsonl"
printf '%s\n' '{"type":"result","subtype":"success","is_error":true,"terminal_reason":"api_error","result":"API Error: 529 Overloaded\nretry later"}' >"$canned/login-outage.jsonl"
long200=$(printf '%200s' '' | tr ' ' y)
printf '{"type":"result","subtype":"success","is_error":true,"terminal_reason":"api_error","result":"%s%s\\nsecond line"}\n' "$long200" yyyyy >"$canned/login-long.jsonl"
printf '%s\n' '{"type":"result","subtype":"success","is_error":true,"result":"Something went wrong"}' >"$canned/login-no-reason.jsonl"
: >"$canned/login-empty.jsonl"
printf '%s\n' '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","content":"ok","is_error":false,"tool_use_id":"t1"}]}}' >"$canned/login-tool-last.jsonl"
printf '%s' '{"type":"result","subtype":"success","is_error":false,"dura' >"$canned/login-cut.jsonl"
# `claude mcp list` under a logged-in config dir: the login's own claude.ai
# connectors, listed whether or not anything was ever added
printf 'Checking MCP server health…\n\nclaude.ai Docs: %s - ✔ Connected\n' 'http://example.invalid:9999/mcp' >"$canned/mcp-list-connectors.txt"
# The runner's result, pretty-printed one key per line as the real one is,
# at the real indents: the run's start time at the top, then per case its
# dir, and per run its own `passed`, start time, `error` and `tracePath`
# ahead of its graders, whose `passed` sits deeper. Case i passes when i
# is within <passed> and ends normally when within <runs ending normally>;
# a failed run's one grader passed, so only the run's own key says it
# failed. Its trace is $evals_kept/e-<i>/out/trace.jsonl.
evals_kept=$tmp/kept
eval_result() { # eval_result <partial> <total> <passed> <runs ending normally>
	printf '{\n  "schemaVersion": 1,\n  "startedAt": "2026-10-01T20:28:13.747Z",\n  "partial": %s,\n  "cases": [\n' "$1"
	i=0
	while [ "$i" -lt "$2" ]; do
		i=$((i + 1))
		if [ "$i" -le "$3" ]; then ok=true; else ok=false; fi
		if [ "$i" -le "$4" ]; then err=null; else err='"timed out after 300s"'; fi
		[ "$i" = 1 ] || printf '    },\n'
		printf '    {\n      "name": "case-%s",\n      "dir": "evals/case-%s",\n      "arms": {\n        "with": [\n          {\n            "passed": %s,\n            "startedAt": "2026-10-01T20:28:14.001Z",\n            "error": %s,\n            "tracePath": "%s/e-%s/out/trace.jsonl",\n            "graders": [\n              {\n                "name": "door-named",\n                "passed": true\n              }\n            ]\n          }\n        ]\n      }\n' "$i" "$i" "$ok" "$err" "$evals_kept" "$i"
	done
	printf '    }\n  ],\n  "aggregates": {\n    "casesTotal": %s,\n    "casesPassed": %s\n  }\n}\n' "$2" "$3"
}
eval_result false 2 2 2 >"$canned/eval-ok.json"
eval_result false 2 1 2 >"$canned/eval-fail.json"
eval_result true 2 1 1 >"$canned/eval-partial.json"
eval_result false 1 1 1 >"$canned/eval-short.json"
eval_result false 2 0 1 >"$canned/eval-error.json"
# The same result in a layout the stage does not read, one miss each: every
# key below the root four spaces deeper, all green and again on a partial
# run; a schemaVersion of 2, and none at all; no startedAt at the root, the
# runs' own start times left in place; and no casesTotal, and two of them
sed 's/^    /        /' "$canned/eval-ok.json" >"$canned/eval-reindented.json"
sed 's/^    /        /' "$canned/eval-partial.json" >"$canned/eval-reindented-partial.json"
sed 's/^  "schemaVersion": 1,$/  "schemaVersion": 2,/' "$canned/eval-fail.json" >"$canned/eval-schema2.json"
sed '/^  "schemaVersion": /d' "$canned/eval-ok.json" >"$canned/eval-noschema.json"
sed '/^  "startedAt": /d' "$canned/eval-fail.json" >"$canned/eval-nostart.json"
sed '/^    "casesTotal": /d' "$canned/eval-ok.json" >"$canned/eval-nototal.json"
sed '/^    "casesTotal": /p' "$canned/eval-ok.json" >"$canned/eval-twototals.json"
# keep-runs <i>... — what --keep-temp leaves for runs <i>: the run's dir
# under $evals_kept with its trace in out/, what the plugin wrote sealed at
# mode 000 in sealed/, the dir itself read-only, and the runner's notice
# naming it on stderr
cat >"$canned/keep-runs" <<EOF
for i in "\$@"; do
	d=$evals_kept/e-\$i
	mkdir -p "\$d/out" "\$d/sealed/home" "\$d/sealed/tmp"
	printf '{"type":"result","result":"case-%s trace"}\n' "\$i" >"\$d/out/trace.jsonl"
	chmod 000 "\$d/sealed"
	chmod 500 "\$d"
	echo "⚠ kept \$d: home/ and tmp/ in it were written by the plugin under test and are sealed in \$d/sealed (mode 000; the kept directory is read-only) — open them with \\\`chmod 700 \$d \$d/sealed\\\` to inspect" >&2
done
EOF
# stream-json runs: an init line naming the servers the run saw, one
# tool_use block per <tool> <input> pair, the tool_result lines a case
# sets, an optional narration line, and the result line last — the shape
# the live stage reads
trace_init_default='{"type":"system","subtype":"init","session_id":"s-run","mcp_servers":[{"name":"ymer-node","status":"connected","source":"dynamic"}]}'
trace_init=$trace_init_default
trace_narration=''
run_trace() { # run_trace <result text> [<tool> <input json>]...
	printf '%s\n' "$trace_init"
	r=$1
	shift
	i=0
	while [ $# -ge 2 ]; do
		i=$((i + 1))
		printf '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t%s","name":"%s","input":%s}]}}\n' "$i" "$1" "$2"
		shift 2
	done
	[ -n "$trace_results" ] && printf '%s\n' "$trace_results"
	[ -n "$trace_narration" ] && printf '{"type":"assistant","message":{"content":[{"type":"text","text":"%s"}]}}\n' "$trace_narration"
	printf '{"is_error":false,"subtype":"success","type":"result","result":"%s","permission_denials":[%s]}\n' "$r" "$trace_denied"
}
trace_denied='' # the result event's permission_denials entries, for a trace whose calls were refused
trace_results='' # tool_result lines, one per answered call: a call a case leaves out has no result
tool_result() { # tool_result <id> <content> <is_error> — a user line answering tool_use <id>, as the CLI writes one
	printf '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","content":"%s","is_error":%s,"tool_use_id":"%s"}]}}' "$2" "$3" "$1"
}
notebook=mcp__ymer-node__notebook
live=$tmp/live # the live cases' fixture, named here so a canned trace can read under it
pstate=$tmp/probe/state # the live stage's state/, under the probe dir every live case uses
# setup's report with no state folder named, in the lines the skill's own
# grammar gives; the second variant is the wording a denied read
# produced, which the report check must not accept
setup_report="Setup — ymer environment\n\n  ✔ node          reachable — 9 tables created\n  ✔ front         \`probe_front\` added\n  ✘ state_folder  not set — set it with /plugin configure ymer@ymer\n  ✔ ymer          no connection in this session — work tracked in the node's \`tasks\` table\n  – Meta Roadmap  not checked"
run_trace "$setup_report" $notebook '{"action":"execute","data":{"sql":"CREATE TABLE fronts (slug TEXT)"}}' Read "{\"file_path\":\"$live/plugins/ymer/skills/setup/SKILL.md\"}" >"$canned/run-setup1.jsonl"
# the first run's report with no front line, and the re-run's with the
# node's line alone: the front's own line is a fact each check reads
run_trace "$(printf '%s' "$setup_report" | sed 's/\\n  ✔ front         `probe_front` added//')" $notebook '{"action":"execute","data":{"sql":"CREATE TABLE fronts (slug TEXT)"}}' >"$canned/run-setup1-no-front.jsonl"
run_trace "  ✔ node          reachable — 9 tables\n  ✔ state_folder  $pstate — not a git work tree, history in the node's \`topics_history\`" $notebook '{"action":"query","data":{"sql":"SELECT 1"}}' >"$canned/run-setup2-no-front.jsonl"
run_trace "$(printf '%s' "$setup_report" | sed 's/not set — set it/not readable from this session — set it/')" $notebook '{"action":"execute","data":{"sql":"CREATE TABLE fronts (slug TEXT)"}}' >"$canned/run-setup1-unreadable.jsonl"
run_trace 'recorded' $notebook '{"action":"execute","data":{"sql":"INSERT INTO pool VALUES (1)"}}' >"$canned/run-capture.jsonl"
# mint with no state folder: it reads the pool and stops naming setup
run_trace 'No state folder is named, so nothing was drained. Run /ymer:setup.' $notebook '{"action":"query","data":{"sql":"SELECT slug FROM fronts"}}' >"$canned/run-mint-stop.jsonl"
# mint's healthy trace in the second arm carries the declared commands
# — the state folder's rev-parse bare and with its path quoted — reads
# inside state/, one path under it, one naming state/ itself and one
# relative, a write under state/, and the history row it saves
save_sql="INSERT INTO topics_history (topic, area, artifact, body, phase, front) SELECT 't', 'meta', 'request.md', new.body, 'mint', 'probe_front' FROM (SELECT 'b' AS body) AS new"
run_trace 'drained' $notebook '{"action":"execute","data":{"sql":"UPDATE pool SET status = 1"}}' $notebook "{\"action\":\"execute\",\"data\":{\"sql\":\"$save_sql\"}}" Bash '{"command":"claude mcp get ymer"}' Bash '{"command":"claude mcp get ymer 2>&1"}' Bash "{\"command\":\"git -C $pstate rev-parse --is-inside-work-tree\"}" Bash "{\"command\":\"git -C \\\"$pstate\\\" rev-parse --is-inside-work-tree\"}" Write "{\"file_path\":\"$pstate/demo/2026/09-21-probe-bug/request.md\",\"content\":\"x\"}" Read "{\"file_path\":\"$pstate/demo/2026/09-21-probe-bug/request.md\"}" Glob "{\"pattern\":\"*.md\",\"path\":\"$pstate\"}" Glob '{"pattern":"*.md"}' >"$canned/run-mint.jsonl"
# the same mint writing beside state/ rather than into it
run_trace 'drained' $notebook '{"action":"execute","data":{"sql":"UPDATE pool SET status = 1"}}' Write "{\"file_path\":\"$tmp/probe/cwd/request.md\",\"content\":\"x\"}" >"$canned/run-mint-outside.jsonl"
# the re-run's report, healthy on the result line while a narration line
# mid-run says `tables created`: only a read of the result line passes it
trace_narration='All nine tables created earlier are present; composing the report.'
run_trace "Setup — ymer environment\n\n  ✔ node          reachable — 9 tables\n  ✔ front         \`probe_front\`\n  ✔ state_folder  $pstate — not a git work tree, history in the node's \`topics_history\`" $notebook '{"action":"query","data":{"sql":"SELECT 1"}}' >"$canned/run-setup2.jsonl"
trace_narration=''
run_trace "Setup — ymer environment\n\n  ✔ node          reachable — 9 tables\n  ✔ front         \`probe_front\`\n  ✔ state_folder  $pstate — git work tree, history in git" $notebook '{"action":"query","data":{"sql":"SELECT 1"}}' >"$canned/run-setup2-git.jsonl"
run_trace "  ✔ node          reachable — 9 tables created\n  ✔ front         \`probe_front\` added" $notebook '{"action":"query","data":{"sql":"SELECT 1"}}' >"$canned/run-setup2-created.jsonl"
# setup's reports dressed the way a model dresses them — a sentence
# before, bold role names, ` — ` separators, backticked values, a code
# fence, a Details section after, a decoration or a double blank inside a
# phrase the check reads — right in every fact, so the report checks must
# pass them; the re-run's Details line says created and added, off the
# node's line, and does not decide the node's line
run_trace "Now compiling the full report.\n\n**Setup — ymer environment**\n\n\`\`\`\n✔ **node** — reachable — 9 tables created\n✔ **front** — \`probe_front\` added\n✘ **state_folder** — not **set** — set it with /plugin configure ymer@ymer\n✔ **ymer** — no  connection in this session (no \`ymer\` MCP server configured) — work tracked in the node's \`tasks\` table\n– **Meta Roadmap** — not checked\n\`\`\`\n\nDetails:\n- **state_folder**: the option is unset." $notebook '{"action":"execute","data":{"sql":"CREATE TABLE fronts (slug TEXT)"}}' >"$canned/run-setup1-decorated.jsonl"
run_trace "Setup — ymer environment\n\n✔ **node** — reachable, 9 tables present (fronts, kinds, pool, pool_scores, tasks, tasks_log, topics_history, tutor_subjects, tutor_engagements), all columns/indexes/triggers verified, no changes needed\n✔ **front** — \`probe_front\` — already registered\n✔ **state_folder** — \`$pstate\` — not a git work tree, history in the node's \`topics_history\`\n✔ **ymer** — no connection in this session (no \`ymer\` MCP server configured; only \`ymer-node\`) — work tracked in the node's \`tasks\` table\n– **Meta Roadmap** — not checked — no ymer; process work routes to \`Meta Roadmap\` in \`tasks\`\n\nDetails:\n- nothing was created or added this run." $notebook '{"action":"query","data":{"sql":"SELECT 1"}}' >"$canned/run-setup2-decorated.jsonl"
# no coordinator line, and the Meta Roadmap line naming ymer's missing
# connection and tasks in its place: the coordinator is not reported
run_trace "Setup — ymer environment\n\n  ✔ node          reachable — 9 tables created\n  ✔ front         \`probe_front\` added\n  ✘ state_folder  not set — set it with /plugin configure ymer@ymer\n  – Meta Roadmap  not checked — no connection to ymer; process work routes to \`Meta Roadmap\` in \`tasks\`" $notebook '{"action":"execute","data":{"sql":"CREATE TABLE fronts (slug TEXT)"}}' >"$canned/run-setup1-no-ymer.jsonl"
# the re-run's node line naming a change the re-run never made: tables
# created, or a front row added — and the line saying created beside a
# Details line that restates the node's facts without it
run_trace "  ✔ node          reachable — 9 tables created\n  ✔ front         \`probe_front\`\n  ✔ state_folder  $pstate — not a git work tree, history in the node's \`topics_history\`" $notebook '{"action":"query","data":{"sql":"SELECT 1"}}' >"$canned/run-setup2-created-only.jsonl"
run_trace "  ✔ node          reachable — 9 tables\n  ✔ front         \`probe_front\` added\n  ✔ state_folder  $pstate — not a git work tree, history in the node's \`topics_history\`" $notebook '{"action":"query","data":{"sql":"SELECT 1"}}' >"$canned/run-setup2-added.jsonl"
run_trace "  ✔ node          reachable — 9 tables created\n  ✔ front         \`probe_front\`\n  ✔ state_folder  $pstate — not a git work tree, history in the node's \`topics_history\`\n\nDetails:\n- ✔ **node**: reachable, 9 tables" $notebook '{"action":"query","data":{"sql":"SELECT 1"}}' >"$canned/run-setup2-created-recap.jsonl"
# the re-run's report naming the node by address: a port the node does
# not run on, as a URL, as a bare port and after the node's server name,
# and the probe's own port
run_trace "  ✔ node          reachable at http://127.0.0.1:8012/mcp — 9 tables\n  ✔ front         \`probe_front\`\n  ✔ state_folder  $pstate — not a git work tree, history in the node's \`topics_history\`" $notebook '{"action":"query","data":{"sql":"SELECT 1"}}' >"$canned/run-setup2-wrong-url.jsonl"
run_trace "  ✔ node          reachable on port 8012 — 9 tables\n  ✔ front         \`probe_front\`\n  ✔ state_folder  $pstate — not a git work tree, history in the node's \`topics_history\`" $notebook '{"action":"query","data":{"sql":"SELECT 1"}}' >"$canned/run-setup2-wrong-port.jsonl"
run_trace "  ✔ node          reachable at ymer-node:8012 — 9 tables\n  ✔ front         \`probe_front\`\n  ✔ state_folder  $pstate — not a git work tree, history in the node's \`topics_history\`" $notebook '{"action":"query","data":{"sql":"SELECT 1"}}' >"$canned/run-setup2-wrong-host.jsonl"
