# ── 5 · static, seeded values, one KEEP site, a CRLF token, a binary file ─
fx=$tmp/f5
fixture "$fx"
printf 'a path /Users/someone/state here\na tree ~/things here\na host http://example.invalid:9999/mcp here\na call mcp__foo__bar here\na token someone-token here\na kept ~/things beside /Users/someone/state here\na longer ~/things-private here\na kept ~/things.\n' >"$fx/plugins/ymer/skills/setup/notes.md"
printf 'a path /Users/someone/state here\n' >"$fx/plugins/ymer/skills/setup/a note.md"
printf 'blob\0%s\n' '/Users/someone/state' >"$fx/plugins/ymer/skills/setup/blob.bin"
printf 'someone-token\r\n' >"$fx.tokens"
printf 'plugins/ymer/skills/setup/notes.md\t~/things\n' >>"$fx/scripts/hermetic-probe-keep"
# a KEEP'd URL standing alone, and the same URL running on through a query
u=http://example.invalid:9999/mcp
printf 'a kept %s here\na longer %s?token=x here\n' "$u" "$u" >"$fx/plugins/ymer/skills/setup/url.md"
printf 'plugins/ymer/skills/setup/url.md\t%s\n' "$u" >>"$fx/scripts/hermetic-probe-keep"
# a record id the way a doc handle carries it, lower and upper case —
# assembled at run time, so this file carries none
printf 'a handle doc-%s-%s here\nan upper handle doc-%s-%s here\n' 0000aaaa 1111-2222-3333-444455556666 0000AAAA 1111-2222-3333-444455556666 >"$fx/plugins/ymer/skills/setup/ids.md"
shim_reset
