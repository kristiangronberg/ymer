#!/bin/sh
# hermetic-probe-live — the live stage, sourced by hermetic-probe: a scratch
# Ymer Node whose notebook starts empty, the README's own install lines
# inside the probe dir's cfg/, and the plugins run headless against that
# node in three arms. With the probe's front named and no state folder,
# setup creates the store skeletons, registers the front, fails its
# state-folder check and reports the coordinator by reach, capture records
# a friction in the pool under that front, and mint stops at its guard. With the probe dir's state/ — a plain folder, in no git repository
# — named as the state folder, setup converges on a re-run and repairs
# drift, and mint drains into state/, draws a bug ahead of open frictions
# and folds the bug's recurrence into its unstarted topic, every line the
# topic held kept, each save a file in state/ alone — the files are the
# record, and the setup run leaves no topics_history table in the node.
# Then tutor stops at its guard twice and writes nothing: with no ymer,
# and with its subject-index tables dropped.
# Last, with state/encl/plans — a folder inside another git repository,
# encl/ — named as the state folder, setup fails its state-folder check
# naming the `git init` fix and mint stops at its guard, each having read
# the folder's kind, and nothing is drained, saved or written.
# State is asserted through the scratch node's own MCP over curl, never
# through the bind-mounted database file (a stale decoy under a VM-backed
# Docker), and through the files in state/; behaviour through each run's
# stream-json.
#
# In order: the login call (one model call under cfg/; a call that does
# not answer names the `claude auth login` line and exits 2), the scrub
# (marketplace, plugins, plugin cache, MCP server removed through the CLI
# and each list asserted empty — the login's own claude.ai connectors
# excepted, which the CLI lists under a logged-in config dir and which the
# runs below keep out by flag), the node (a copy of the compose file in
# compose/, never the named file itself, run under the probe's own project
# name and port — the name asserted as the probe's own before up and again
# before down — data/ fresh and world-writable — the container runs as
# another uid — and state/ fresh beside it, asserted no git work tree),
# the install path (the README's lines with the
# marketplace by working-tree path and the node on the probe's port),
# the instructions check's control call, then twelve headless runs — eight
# in the first two arms, tutor's two, then the third arm's two — each from
# a working directory outside the home tree and under the probe's own hook,
# written into hook/, which refuses every Bash command but the declared
# ones, and the install line re-run before the second and third arms with
# the front and that arm's state folder as the plugin's options — then
# teardown — at the
# end of the stage, or by the EXIT trap on any earlier exit — and the
# install's containers asserted
# untouched. runs/ keeps each run's stream-json, the install and compose
# logs, 8-preimage.md — the bug topic's request.md as run 8 found it —
# and node.log: every request the stage made to the node with the raw
# response, the record to read before a red line is taken as a finding
# about a skill. The traces, the pre-image and node.log are this
# invocation's alone: the previous run's are removed at the start of the
# stage.
# cfg/projects/, where Claude Code keeps the transcript of every session
# run under the config dir, is the probe's own as well: wiped whole at the
# start of the stage, beside the traces, on a line of its own. The last
# invocation's transcripts stay until the next one, for the post-mortem a
# red line sends the reader to; a hand probe that wants its transcripts
# kept runs under a config dir of its own. A run is handed state/ alone
# of the probe dir: cfg/ holds the login, its account record and those
# transcripts, and a read there fails `isolation`.
#
# Exit 2 on any precondition, 1 on a failed step.

live_project=hermetic-probe
# The front every run names, through the plugin's front option: a slug no
# release ever defaulted to. setup's, capture's and mint's checks read the
# rows back under this slug, so a pass proves the option named them
probe_front=probe_front

# The node over its MCP, protocol 2026-07-28: no initialize handshake and
# no session — every request carries the protocol fields in params._meta
# and mirrors them in the mcp-* headers, a tools/call its tool name and
# action besides; the notebook tool takes {action, data} arguments. A
# query's rows come back as escaped JSON inside result.content[0].text;
# node_count reads the first cell of the first row, node_body the whole
# response. Every request and its raw response are appended to
# runs/node.log, which outlives the node: a red line's number can be
# checked against what the node said.
# A number the response does not carry reads UNPARSEABLE, never blank —
# a blank compares false and looks like a skill finding; the marker says
# the probe's own read failed.
node_version=2026-07-28
node_meta="\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"$node_version\",\"io.modelcontextprotocol/clientCapabilities\":{}}"

node_init() { # node_init — true once the node answers a tools/list with a result
	rm -f "$tmp/init.json"
	curl -sS -o "$tmp/init.json" -X POST "$url" \
		-H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream' \
		-H "mcp-protocol-version: $node_version" -H 'mcp-method: tools/list' \
		--data "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\",\"params\":{$node_meta}}" \
		2>/dev/null || return 1
	grep -q '"result"' "$tmp/init.json"
}

node_body() { # node_body <action> <data json> — the response body on stdout, curl's status
	printf '>> %s %s\n' "$1" "$2" >>"$runs/node.log"
	rm -f "$tmp/node.out"
	rc=0
	curl -sS -o "$tmp/node.out" -X POST "$url" \
		-H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream' \
		-H "mcp-protocol-version: $node_version" -H 'mcp-method: tools/call' \
		-H 'mcp-name: notebook' -H "mcp-param-action: $1" \
		--data "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{$node_meta,\"name\":\"notebook\",\"arguments\":{\"action\":\"$1\",\"data\":$2}}}" \
		2>>"$runs/node.log" || rc=$?
	if [ -f "$tmp/node.out" ]; then
		cat "$tmp/node.out" >>"$runs/node.log"
		cat "$tmp/node.out"
	fi
	printf '\n<< curl exit %s\n' "$rc" >>"$runs/node.log"
	return $rc
}

node_number() { # node_number <text> — the text when it is an integer, else UNPARSEABLE
	case $1 in
	'' | *[!0-9]*) echo UNPARSEABLE ;;
	*) echo "$1" ;;
	esac
}

node_count() { # node_count <sql selecting one integer> — the integer, or UNPARSEABLE
	node_number "$(node_body query "{\"sql\":\"$1\"}" | grep -o '\\"rows\\":\[\[[0-9]*' | sed 's/.*\[\[//')"
}

node_tables() { # node_tables — the notebook's table count, or UNPARSEABLE
	node_number "$(node_body tables '{}' | grep -o '\\"count\\":[0-9]*' | sed 's/.*://')"
}

node_execute() { # node_execute <sql> — true when the node reports no error
	node_body execute "{\"sql\":\"$1\"}" | grep -q '"isError":false'
}

node_text() { # node_text <sql selecting one text> — the text, or UNPARSEABLE
	t=$(node_body query "{\"sql\":\"$1\"}" | grep -o '\\"rows\\":\[\[\\"[^\\]*' | sed 's/.*\[\[\\"//')
	if [ -n "$t" ]; then echo "$t"; else echo UNPARSEABLE; fi
}

# The files in state/, read straight from disk: the half of a save the node
# cannot show. A file that is not there reads UNPARSEABLE, never 0 — a 0
# would pass a "no more than" and look like a skill finding.
file_occurrences() { # file_occurrences <file> <text> — how often <text> occurs in <file>
	if [ -f "$1" ]; then
		grep -o -F -- "$2" "$1" | wc -l | tr -d ' '
	else
		echo UNPARSEABLE
	fi
}

file_length() { # file_length <file> — how many lines <file> holds, a last line with no newline counted, or UNPARSEABLE
	if [ -f "$1" ]; then
		awk 'END { print NR }' "$1" 2>/dev/null || echo UNPARSEABLE
	else
		echo UNPARSEABLE
	fi
}

# A file read against an earlier copy of itself: how much of the copy
# survives, line by line from its first, in order — lines inserted
# anywhere between them pass, a line changed or dropped stops the count.
# Each line is compared byte for byte, as a string: awk compares two
# lines that both read as numbers numerically, and `1.0` would match `1`.
file_kept() { # file_kept <before> <after> — how many of <before>'s lines, from its first, occur in <after> in order, or UNPARSEABLE
	if [ -f "$1" ] && [ -f "$2" ]; then
		awk 'NR == FNR { before[++n] = $0; next } k < n && $0 "" == before[k + 1] "" { k++ } END { print k + 0 }' "$1" "$2" 2>/dev/null || echo UNPARSEABLE
	else
		echo UNPARSEABLE
	fi
}

file_started() { # file_started <file> — the file's `started:` date as YYYYMMDD, or UNPARSEABLE
	node_number "$(sed -n 's/^started: //p' "$1" 2>/dev/null | head -n 1 | tr -d '-')"
}

topic_files() { # topic_files <drained_to> — every request.md in that topic's folder under state/, one per line
	find "$state/$1" -type f -name request.md 2>/dev/null || true
}

# The declared commands — the Bash commands a run may run — one ERE per
# line in hook/declared, each matched against a command as its JSON string
# spells it, escaped quotes included, so a separator, any other redirect, a
# substitution or an escaped newline anywhere in it fails the match:
# `claude mcp get <name>` whole, a trailing `2>&1` admitted, and the
# reading of the state folder's kind, `git -C <folder> rev-parse
# --is-inside-work-tree --show-prefix`, for either folder an arm names —
# state/, or the third arm's encl/plans — its path bare or quoted — and
# mint's two searches of state/, the listing of unstarted topics
# `grep -rl --include='request.md' 'source: mint' <folder>` and the
# recurrence search `grep -r --exclude-dir=pre-image '<term>' <folder>`,
# each spelled as mint/mechanics.md spells it, its quotes single or double,
# the folder bare or quoted with an optional trailing slash, and the term
# quoted, not opening with `-` — grep reads a word opening with one as an
# option, whatever its quotes — and with no quote, backslash, `$`,
# backtick, `;`, `|`, `&`, `<` or `>` inside — and `ls`, bare or with
# flags from `aAlR1`, of state/ or a folder under it, the listing mint
# needs to tell a folder holding nothing but its `request.md`. The
# listing's path is one operand: each name under state/ is letters,
# digits, `_`, `-` and `.`, never opening with a dot, so no space starts
# a second operand, no `~`, brace or bracket expands to another path, and
# no `..` climbs out. A session
# on this CLI has no file search but its shell (no Glob or Grep tool in
# the init line's tools: CLI 2.1.295, measured), so a run refused these
# finds no topic to fold a recurrence into. The
# file is the one home of the patterns: the runs' hook
# refuses every other command against it, and bash-commands reads every
# command that ran against it — a mint run's against the whole file, any
# other run's against hook/declared-base, its first three lines, since
# the hook cannot tell which skill runs and the check can. The hook's
# refusal message and
# bash-commands' pass and fail lines spell the set in words, so a change to
# the set moves those three texts with it. The hook is sh, reading the PreToolUse event on
# stdin — one JSON line, tool_input's command its first key (CLI 2.1.283,
# measured); an event it cannot read that way is refused, as bash-commands
# fails closed on such an input that ran. Its exit 2 is the refusal, which lands in
# the result's permission_denials like the permission layer's own, and its
# message is what the model reads, so it names the declared commands and
# that each runs alone. hook/ is written fresh each run.
live_hook() {
	rm -rf "$hook"
	mkdir -p "$hook"
	state_re=$(printf '%s' "$state" | sed 's/[][\.*^$()+?{}|]/\\&/g')
	encl_re=$(printf '%s' "$encl" | sed 's/[][\.*^$()+?{}|]/\\&/g')
	q="'"
	path="(\\\\\"|$q)?$state_re/?(\\\\\"|$q)?\$"
	term="[^-$q\"\\\\\$\`;|&<>][^$q\"\\\\\$\`;|&<>]*"
	seg="(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*"
	printf '%s\n' '^claude mcp get [A-Za-z0-9_.-]+( 2>&1)?$' "^git -C (\\\\\"|')?$state_re(\\\\\"|')? rev-parse --is-inside-work-tree --show-prefix\$" "^git -C (\\\\\"|')?$encl_re(\\\\\"|')? rev-parse --is-inside-work-tree --show-prefix\$" >"$hook/declared-base"
	cp "$hook/declared-base" "$hook/declared"
	printf '%s\n' "^grep -rl --include=(${q}request\\.md$q|request\\.md|\\\\\"request\\.md\\\\\") (${q}source: mint$q|\\\\\"source: mint\\\\\") $path" "^grep -r --exclude-dir=pre-image ($q$term$q|\\\\\"$term\\\\\") $path" "^ls( -[aAlR1]+)? (\\\\\"|$q)?$state_re$seg/?(\\\\\"|$q)?\$" >>"$hook/declared"
	cat >"$hook/bash" <<'EOF'
#!/bin/sh
# The hermetic probe's PreToolUse hook on Bash: a command matching a line
# of the declared file beside this one runs, and every other is refused.
cmd=$(sed -E -n 's/.*"tool_input":\{"command":"(([^"\\]|\\.)*)".*/\1/p')
if [ -n "$cmd" ] && printf '%s\n' "$cmd" | grep -q -E -f "$(dirname "$0")/declared"; then
	exit 0
fi
echo 'Refused: only five shell commands run here, each on its own with nothing before or after it — `claude mcp get <name>`, optionally ending in `2>&1`; `git -C <the state folder> rev-parse --is-inside-work-tree --show-prefix`; and two searches of the state folder, `grep -rl --include='\''request.md'\'' '\''source: mint'\'' <the state folder>` and `grep -r --exclude-dir=pre-image '\''<term>'\'' <the state folder>`, the term in quotes, not starting with a dash, with no quote, backslash, `$`, backtick, `;`, `|`, `&`, `<` or `>` inside; and `ls` of the state folder or a folder at any depth inside it, a single path whose names are letters, digits, `_`, `-` and `.`, none starting with a dot, with flags from `-aAlR1` at most.' >&2
exit 2
EOF
	printf '{"hooks":{"PreToolUse":[{"matcher":"Bash","hooks":[{"type":"command","command":"sh %s"}]}]}}\n' "'$hook/bash'" >"$hook/settings.json"
}

# One headless run in an empty working directory outside the home tree, its
# stream-json kept in runs/. Prompt before flags; the notebook tool
# allowed, and Bash for the declared commands, each by an allow rule —
# `claude mcp get`, the read the skills name on Claude Code before they
# take a missing ymer as absent (the rule shape is the CLI's own `--help`
# example, `Bash(git *)`), and `git -C <folder> rev-parse
# --is-inside-work-tree --show-prefix`, the reading that says what kind of
# folder the state folder is and whether git keeps its history (a `*` in the
# middle of a rule admits the path and nothing
# else: CLI 2.1.282, measured), and mint's two searches of the state
# folder and its listing, each by its leading words. The allow rules do not bound the shell:
# under acceptEdits a read-only command such as `true` or `echo` runs with
# no rule matching it (CLI 2.1.283, measured), so every run also loads
# hook/settings.json, and its hook is what makes the declared commands
# binding. Reads of the plugins' own files are allowed by one rule over
# the checkout's plugins/ — a skill reads the files beside its SKILL.md,
# mint its scorer's prompt, and the runs' working directory is outside
# the checkout, where a read is otherwise asked (`//` roots the rule at
# the filesystem: CLI 2.1.289, measured). Agent is allowed, so mint's
# scorers can be dispatched. A tool call no rule and no mode admits is
# asked, and an unattended run denies it; either way the attempt stays in
# the trace for the checks below. The arm's state folder — state/, or the
# third arm's encl/plans — sits outside the working directory, where
# acceptEdits denies a write, so it is added as a directory the run may
# edit (measured the same way); run_dir names it. The MCP servers are
# the flag's alone: a logged-in config dir carries the organisation's
# claude.ai connectors, which `claude mcp remove` cannot reach and which
# would give the skills a ymer to find, so --strict-mcp-config keeps every
# configured server out and --mcp-config passes the scratch node in. A run
# whose result line says it ended in an error (live_error) gets a fail
# line of its own here, naming why; the state and behaviour reads below
# still run over what it left, and the function returns 0 so that `set -e`
# never ends the stage on a run.
nl='
'
live_run() { # live_run <n> <prompt>
	rm -rf "$cwd"
	mkdir -p "$cwd"
	(cd "$cwd" && claude -p "$2" --output-format stream-json --verbose \
		--permission-mode acceptEdits \
		--allowedTools 'Bash(claude mcp get *)' 'Bash(git -C * rev-parse --is-inside-work-tree --show-prefix)' 'Bash(grep -rl *)' 'Bash(grep -r --exclude-dir=pre-image *)' 'Bash(ls *)' mcp__ymer-node__notebook "Read(/$root/plugins/**)" Agent \
		--add-dir "$run_dir" --model "$probe_model" --max-turns 60 \
		--strict-mcp-config --mcp-config "$mcp" --settings "$hook/settings.json") </dev/null >"$runs/$1.jsonl" 2>"$runs/$1.err" || true
	ran="$ran $1"
	if ! call_err=$(live_error "$1"); then
		fail "run-$1" "run $1 (${2%%"$nl"*}) $call_err — read $runs/$1.jsonl and $runs/$1.err"
	fi
	return 0
}

# A call's result line — the last line of its trace in runs/, carrying the
# model's answer as `result` where there is one: the one place a skill's
# report is read from, so narration mid-run never decides a line.
live_result() { # live_result <n> — run <n>'s, or the login call's as login
	tail -n 1 "$runs/$1.jsonl"
}

# Whether a headless call ended without error, read from its result line
# and nothing else: the line must be the result event, closed by its `}`,
# and carry "is_error":false — a positive match, so an empty trace, one cut
# off mid-stream, the result line itself included, or one ending on any
# other line reads as an error. Neither
# the CLI's subtype nor the exit status of `claude -p` is read: a call
# that never reached the model writes subtype success beside is_error
# true, an expired login and a missing one alike (the missing one at CLI
# 2.1.291, measured). On an error it prints what the line says: its
# terminal_reason — api_error when the call never reached the model,
# max_turns when it reached it and stopped — then the first line of its
# `result`, cut to 200 characters (bytes under a C locale, which can split
# a character at the cut), where the line carries one. The one read of a
# result line's outcome, shared by the login call and every run.
live_error() { # live_error <n> — true and silent when call <n> ended without error, else false and the error in words
	rl=$(live_result "$1")
	case $rl in
	*'"type":"result"'*'}') ;;
	*)
		echo 'left no result line'
		return 1
		;;
	esac
	case $rl in
	*'"is_error":false'*) return 0 ;;
	esac
	reason=$(printf '%s\n' "$rl" | sed -n 's/.*"terminal_reason":"\([^"]*\)".*/\1/p')
	rtext=$(printf '%s\n' "$rl" | sed -E -n 's/.*"result":"(([^"\\]|\\.)*)".*/\1/p' | sed 's/\\n.*//' | cut -c 1-200)
	printf 'ended in an error — %s%s\n' "${reason:-no terminal_reason}" "${rtext:+: $rtext}"
	return 1
}

# A skill's report is read for the facts its lines carry, never for its
# form. The model running a skill keeps a report's content and varies its
# dress from run to run — bold role names, backticked values, ` — `
# between the parts, a code fence, a sentence before or after the lines,
# a role line wrapped onto the lines under it — and a check that matched
# the dress would read red on a right report and send the reader into the
# trace for nothing. So every check on a report's lines reads them through
# report_lines, which takes the result out of its JSON string into lines
# of its own, drops the fence lines, strips Markdown's backslash escapes,
# `*`, backticks and the emoji-presentation selector U+FE0F (so `✔️`
# is the mark `✔`), collapses runs of blanks, and joins each role line's
# continuation lines onto it (both terms: the glossary). A role line opens
# with a role mark — ✔, ✘ or – — past any indent and list bullet; each
# non-blank line under it with no mark there continues it, and a blank
# line or the next role line ends the run. A fence opening at the line's
# start is the block's own and ends the run like a blank; an indented
# fence sits inside a list item and is dropped without ending it — so a
# block whose own closing fence is indented reads that fence as nested,
# and prose straight after it joins the last role line: a known gap, unseen
# in real reports, worth covering once a run writes one. A
# report with no role line reads as its plain lines. The check then asks
# for its words on one line through report_words, case aside, and a red
# names a wrong or missing fact. A read that looks for one token anywhere
# in the result line — whether the call ended in error, mint's door — keeps the
# raw line, which no decoration splits.
# The reads run in the C locale: the marks and the ` — ` separator share
# their leading bytes, so each mark is matched as its whole byte sequence,
# never inside a bracket expression.
report_lines() { # report_lines <n> — run <n>'s report, one line per role line or plain line, undressed
	live_result "$1" | sed -E -n 's/.*"result":"(([^"\\]|\\.)*)".*/\1/p' |
		awk '{
			s = $0
			out = ""
			n = length(s)
			for (i = 1; i <= n; i++) {
				c = substr(s, i, 1)
				if (c == "\\" && i < n) {
					i++
					c = substr(s, i, 1)
					if (c == "n") c = "\n"
					else if (c == "t") c = " "
					else if (c == "r") c = ""
				}
				out = out c
			}
			print out
		}' |
		sed -E '/^```/s/.*//; /^[[:space:]]+```/d' |
		sed -E 's/\\([[:punct:]])/\1/g; s/️//g; s/[*`]//g; s/[[:space:]]+/ /g' |
		LC_ALL=C awk '
			/^ ?$/ { if (run != "") print run; run = ""; print ""; next }
			/^ ?(- )?(✔|✘|–)/ { if (run != "") print run; run = $0; next }
			run != "" { sub(/^ /, ""); run = run " " $0; next }
			{ print }
			END { if (run != "") print run }
		' || true
}

# The lines on stdin carrying every word, case aside, each where no name
# character touches either end: letters, digits, `_`, `-` and `/` on
# either side, and `:` before the word only — so `8 tables` is not read
# in `18 tables`, `reachable` not in `unreachable`, `ymer` not in
# `ymer-node` or a skill's `/ymer:<skill>`, while a dressed `node:` still
# reads as `node`. A word may hold a space; the report's blanks are
# collapsed to one.
report_words() { # report_words <word>... — stdin's lines carrying every word on its own
	printf '%s\n' "$@" >"$tmp/report.words"
	LC_ALL=C awk '
		# a word on the first byte of a line has nothing before it: a
		# substr from 0 is read as from 1 by this awk, and would return
		# the first letter of the word itself
		function has(s, x,    p, i, b, a, rest) {
			rest = s
			p = 0
			while ((i = index(rest, x)) > 0) {
				b = (p + i > 1) ? substr(s, p + i - 1, 1) : ""
				a = substr(s, p + i + length(x), 1)
				if (b !~ /[a-z0-9_\/:-]/ && a !~ /[a-z0-9_\/-]/) return 1
				p += i
				rest = substr(s, p + 1)
			}
			return 0
		}
		NR == FNR { w[++nw] = tolower($0); next }
		{
			line = tolower($0)
			for (k = 1; k <= nw; k++) if (!has(line, w[k])) next
			print
		}
	' "$tmp/report.words" - || true
}

report_match() { # report_match <n> <word>... — the lines of run <n>'s report carrying every word, case aside
	rpt_n=$1
	shift
	report_lines "$rpt_n" | report_words "$@"
}

# The node ports run <n>'s report names, one per line: a port after a
# host naming this machine — loopback by IPv4, IPv6 or by name, or the
# any-address form — or after the node's registered server name, in a URL
# or bare, read anywhere in the report, since a wrong address in the prose
# after the lines is the one a user copies; and a port given as a port,
# read from the node's own role line alone, so a container's port or a
# `db_port` elsewhere is never taken for the node's. Known gaps, each
# worth covering once a run writes one: a number standing alone, with
# neither a host nor the word before it; a port given as `port — N`,
# `Port=N` or `port number N`, or as the second number of `ports A and B`;
# a port after this machine's `<hostname>.local`; and a container's port
# named on the node's own role line, which reads as the node's — loud,
# never a silent pass.
report_ports() { # report_ports <n>
	report_lines "$1" >"$tmp/report"
	LC_ALL=C grep -o -i -E '(127\.0\.0\.1|local[h]ost|0\.0\.0\.0|\[::1\]|ymer-node):[0-9]+' "$tmp/report" | sed 's/.*://' || true
	LC_ALL=C grep -i -E '^ ?(- )?(✔|✘|–) node([^[:alnum:]_/-]|$)' "$tmp/report" |
		LC_ALL=C grep -o -i -E '(^|[^[:alnum:]_/-])ports?:? *[0-9]+' | sed -E 's/.*[^0-9]//' || true
}

# Tool calls a run made, one per line as `<tool> <input>`, read from the
# assistant messages' tool_use blocks. The input is taken whole, from its
# opening brace to the brace that balances it: a brace inside a string
# value — a Glob's `*.{md,yaml}`, a `{}` in a Bash command — is a byte of
# the string, and an escaped quote stays inside it, so no key after such
# a byte is lost to the reads below (a cut at the first `}` lost them).
live_calls() { # live_calls <n>
	awk '
		{
			s = $0
			for (;;) {
				p = index(s, "\"type\":\"tool_use\",")
				if (p == 0) break
				s = substr(s, p)
				q = index(s, "\"name\":\"")
				r = index(s, "\"input\":{")
				if (q == 0 || r == 0) break
				name = substr(s, q + 8)
				name = substr(name, 1, index(name, "\"") - 1)
				n = length(s)
				depth = 0
				quoted = 0
				for (j = r + 8; j <= n; j++) {
					c = substr(s, j, 1)
					if (quoted) {
						if (c == "\\") j++
						else if (c == "\"") quoted = 0
					} else if (c == "\"") quoted = 1
					else if (c == "{") depth++
					else if (c == "}") {
						depth--
						if (depth == 0) break
					}
				}
				print name " " substr(s, r + 8, j - r - 7)
				s = substr(s, j + 1)
			}
		}' "$runs/$1.jsonl"
}

denied_bash() { # denied_bash <n> — the tool_use_id of each Bash call refused in run <n>, by the runs' hook or the permission layer, one per line: the result event's permission_denials, the run's own record of what never ran, read by tool name and id alone
	grep '"type":"result"' "$runs/$1.jsonl" |
		grep -o -E '"tool_name":"Bash","tool_use_id":"[^"]+"' |
		sed -E 's/.*"tool_use_id":"//; s/"$//' || true
}

# Whether run <n> made an execute call through the node's notebook tool.
live_executed() { # live_executed <n>
	live_calls "$1" | grep '^mcp__ymer-node__notebook' | grep -q '"action":"execute"'
}

# The mcp__ calls a run made, one per line as `reached <tool>` or
# `unreached <tool>`, each call paired with its tool_result by id. A call is
# unreached only where the CLI answered that no such tool exists: the result's
# content, first after its type, is exactly `<tool_use_error>Error: No
# such tool available: <tool></tool_use_error>` naming the call's own
# tool. Every other answer — a server's error, a refusal — and a call with
# no result at all is a reach, so a form the read does not know fails
# closed.
live_mcp() { # live_mcp <n>
	awk -v pre='"content":"<tool_use_error>Error: No such tool available: ' '
		NR == FNR {
			s = $0
			for (;;) {
				p = index(s, "\"type\":\"tool_result\",")
				if (p == 0) break
				s = substr(s, p + 21)
				q = index(s, "\"tool_use_id\":\"")
				if (q == 0) break
				id = substr(s, q + 15)
				id = substr(id, 1, index(id, "\"") - 1)
				if (index(s, pre) == 1) {
					t = substr(s, length(pre) + 1)
					e = index(t, "</tool_use_error>\"")
					if (e > 0) unreached[id] = substr(t, 1, e - 1)
				}
			}
			next
		}
		{
			s = $0
			for (;;) {
				p = index(s, "\"type\":\"tool_use\",")
				if (p == 0) break
				s = substr(s, p + 18)
				i = index(s, "\"id\":\"")
				q = index(s, "\"name\":\"")
				if (i == 0 || q == 0) break
				id = substr(s, i + 6)
				id = substr(id, 1, index(id, "\"") - 1)
				name = substr(s, q + 8)
				name = substr(name, 1, index(name, "\"") - 1)
				if (index(name, "mcp__") == 1) print ((id in unreached && unreached[id] == name) ? "unreached " : "reached ") name
			}
		}' "$runs/$1.jsonl" "$runs/$1.jsonl"
}

# The Bash calls that ran in run <n>, one per line as each call's input:
# every Bash tool_use block the run made, less each call the result
# event's permission_denials names by its tool_use_id — a denial takes out
# the one call it names and nothing else, whatever that call's input
# holds, and a denial naming no call takes out nothing. The input is read
# whole, as live_calls reads it. A call's id is read only where the CLI
# writes it, straight after the block's type (CLI 2.1.283, measured): a
# call whose id is not there is never taken out, so a record the read
# does not know fails closed.
live_bash() { # live_bash <n>
	awk '
		NR == FNR {
			if (index($0, "\"type\":\"result\"") == 0) next
			s = $0
			for (;;) {
				p = index(s, "\"tool_name\":\"Bash\",\"tool_use_id\":\"")
				if (p == 0) break
				s = substr(s, p + 34)
				id = substr(s, 1, index(s, "\"") - 1)
				if (id != "") denied[id] = 1
			}
			next
		}
		{
			s = $0
			for (;;) {
				p = index(s, "\"type\":\"tool_use\",")
				if (p == 0) break
				s = substr(s, p)
				q = index(s, "\"name\":\"")
				r = index(s, "\"input\":{")
				if (q == 0 || r == 0) break
				name = substr(s, q + 8)
				name = substr(name, 1, index(name, "\"") - 1)
				id = ""
				if (index(s, "\"type\":\"tool_use\",\"id\":\"") == 1) {
					id = substr(s, 25)
					id = substr(id, 1, index(id, "\"") - 1)
				}
				n = length(s)
				depth = 0
				quoted = 0
				for (j = r + 8; j <= n; j++) {
					c = substr(s, j, 1)
					if (quoted) {
						if (c == "\\") j++
						else if (c == "\"") quoted = 0
					} else if (c == "\"") quoted = 1
					else if (c == "{") depth++
					else if (c == "}") {
						depth--
						if (depth == 0) break
					}
				}
				if (name == "Bash" && !(id != "" && id in denied)) print substr(s, r + 8, j - r - 7)
				s = substr(s, j + 1)
			}
		}' "$runs/$1.jsonl" "$runs/$1.jsonl"
}

# The command each Bash call of run <n> carried, unwrapped from its input
# as the runs' hook reads it: the calls that ran, or with `all` every
# call, refused or run. An input whose first key is not the command stays
# whole, so it matches no declared line and fails closed.
bash_commands() { # bash_commands <n> [all]
	if [ "${2:-}" = all ]; then
		live_calls "$1" | sed -n 's/^Bash //p'
	else
		live_bash "$1"
	fi | sed -E 's/^\{"command":"(([^"\\]|\\.)*)".*/\1/'
}

# The paths a run's Read, Glob and Grep calls named, one per line: each
# call's file_path or path, and a Glob's pattern besides — an absolute
# pattern names its own root, with no path key at all, and only Glob's
# pattern is a path (Grep's is a regex over content), so it is read in a
# pass of its own. A call naming none reads the run's working directory,
# which isolation admits beside state/ and the checkout.
live_reads() { # live_reads <n>
	live_calls "$1" | grep -E '^(Read|Glob|Grep) ' | sed -E -n 's/.*"(file_path|path)":"([^"]*)".*/\2/p'
	live_calls "$1" | grep -E '^Glob ' | sed -E -n 's/.*"pattern":"([^"]*)".*/\1/p'
}

# The session transcripts behind one headless call, one path per line: the
# main transcript, found under cfg/projects/ by the session_id on the
# trace's init line in whichever project directory holds it — the name
# the CLI derives for that directory from the working directory is never
# spelled here — and every transcript in its subagents/ beside it. An
# init line carrying no session id, or an id no transcript carries,
# prints `MISSING <what was looked for>`, so the check fails closed.
live_transcripts() { # live_transcripts <trace>
	sid=$(head -n 1 "$1" 2>/dev/null | grep -o '"session_id":"[^"]*"' | head -n 1 | sed 's/^"session_id":"//; s/"$//')
	if [ -z "$sid" ]; then
		echo "MISSING a session_id on the init line of $1"
		return 0
	fi
	main=$(find "$cfg/projects" -mindepth 2 -maxdepth 2 -type f -name "$sid.jsonl" 2>/dev/null || true)
	if [ -z "$main" ]; then
		echo "MISSING $cfg/projects/*/$sid.jsonl"
		return 0
	fi
	printf '%s\n' "$main"
	printf '%s\n' "$main" | while IFS= read -r m; do
		find "${m%.jsonl}/subagents" -type f -name '*.jsonl' 2>/dev/null || true
	done
}

# The instructions check's read of one headless call, one tab-separated
# line per finding: `read <transcript>` for each transcript recording an
# environment attachment — the record every session and every subagent
# but a fork writes at its start (CLI 2.1.286, measured), so its presence
# says the read parsed that transcript's attachments; `unseen
# <transcript>` for one missing or recording none; and `loaded <file>
# <transcript>` for each file Claude Code records as loaded — a CLAUDE.md,
# CLAUDE.local.md or rules file: every path an instructions attachment
# lists (the files loaded at startup, or after the first turn), and the
# one path a nested_memory attachment names (a CLAUDE.md reached later
# through a read, whose record repeats that path inside its content, so
# only the first is taken). Every line is read, and either attachment
# whose path the read cannot find names UNPARSEABLE, so it still counts.
live_instructions() { # live_instructions <trace>
	live_transcripts "$1" | while IFS= read -r t; do
		case $t in
		'MISSING '*)
			printf 'unseen\t%s\n' "${t#MISSING }"
			continue
			;;
		esac
		if grep -q -F '"attachment":{"type":"environment"' "$t" 2>/dev/null; then
			printf 'read\t%s\n' "$t"
		else
			printf 'unseen\t%s\n' "$t"
		fi
		awk -v t="$t" '
			index($0, "\"attachment\":{\"type\":\"instructions\"") {
				s = $0
				n = 0
				while ((p = index(s, "\"path\":\"")) > 0) {
					s = substr(s, p + 8)
					printf "loaded\t%s\t%s\n", substr(s, 1, index(s, "\"") - 1), t
					n++
				}
				if (n == 0) printf "loaded\tUNPARSEABLE\t%s\n", t
			}
			(a = index($0, "\"attachment\":{\"type\":\"nested_memory\"")) {
				s = substr($0, a)
				if ((p = index(s, "\"path\":\"")) > 0) {
					s = substr(s, p + 8)
					printf "loaded\t%s\t%s\n", substr(s, 1, index(s, "\"") - 1), t
				} else printf "loaded\tUNPARSEABLE\t%s\n", t
			}' "$t" 2>/dev/null || true
	done
}

# The instructions check's positive control: one headless call from a
# working directory holding a CLAUDE.md the probe plants, whose transcript
# must record exactly that file — the proof that the read which finds
# nothing in the runs can see a load at all, in the record Claude Code
# writes today. An instrument, not a scenario run: it is not in $ran, and
# only the instructions check reads it. One short prompt and one turn,
# since the load is recorded before the model answers (CLI 2.1.286,
# measured at about $0.06), no server, and the runs' hook in force.
live_control() {
	rm -rf "$control"
	mkdir -p "$control"
	printf '%s\n' '# Planted by the hermetic probe' '' 'The instructions check expects this file, and only this one, in the control run'"'"'s transcript.' >"$control/CLAUDE.md"
	(cd "$control" && claude -p 'Reply with the single word ok.' --output-format stream-json --verbose \
		--model "$probe_model" --max-turns 1 \
		--strict-mcp-config --mcp-config '{"mcpServers":{}}' --settings "$hook/settings.json") </dev/null >"$runs/control.jsonl" 2>"$runs/control.err" || true
	return 0
}

# The scratch node's compose invocation, one spelling for up, down and the
# name check: always the probe dir's own copy of the compose file, never the
# file the variable names. That file's directory may pin another project in
# a .env beside it — a Ymer Node install's does — and the copy in compose/,
# which holds no .env, has no such name to fall back to.
live_compose() {
	PORT=$port NODE_DATA_DIR=$data docker-compose -p "$live_project" -f "$scratch_compose" "$@"
}

# live_resolves <label> — true only when compose resolves the copy's project
# name to the probe's own; no up and no down runs otherwise. Everything
# config printed, its errors included, is kept in runs/ as
# compose-config-<label>.log, one log per check, for a refusal to point at.
live_resolves() {
	[ "$(live_compose config 2>&1 | tee "$runs/compose-config-$1.log" | sed -n 's/^name: //p')" = "$live_project" ]
}

live_teardown() {
	echo
	echo "hermetic probe — live teardown"
	if live_resolves before-down; then
		live_compose down >"$runs/compose-down.log" 2>&1 || true
		rm -rf "$data" "$state"
	else
		fail install "refused docker-compose down — the project does not resolve to $live_project — read $runs/compose-config-before-down.log; $data and $state are kept for inspection; bring the scratch node down by hand with \`PORT=$port NODE_DATA_DIR='$data' docker-compose -p $live_project -f '$scratch_compose' down\`"
	fi
	docker ps --format '{{.Names}} {{.Ports}}' | sort >"$tmp/docker-after"
	if cmp -s "$tmp/docker-before" "$tmp/docker-after"; then
		pass install "untouched — docker ps lists the same containers and ports as before"
	else
		fail install "docker ps differs from before the run — compare:
$(diff "$tmp/docker-before" "$tmp/docker-after" | sed 's/^/                 /')"
	fi
	node_up=0
}

stage_live() {
	echo "hermetic probe — live"

	# the probe dir in physical form: the CLI reports a run's paths physical
	# and normalised, and `isolation` compares them against $state by prefix,
	# so a trailing slash or a symlinked parent in the override would
	# redden every legitimate read under it
	dir=${HERMETIC_PROBE_DIR:-$HOME/.hermetic-probe}
	mkdir -p "$dir"
	dir=$(cd "$dir" && pwd -P)
	cfg=$dir/cfg
	data=$dir/data
	runs=$dir/runs
	state=$dir/state
	encl=$state/encl/plans
	scratch_compose=$dir/compose/docker-compose.yml
	hook=$dir/hook
	port=${HERMETIC_PROBE_PORT:-8112}
	compose=${HERMETIC_PROBE_COMPOSE_FILE:-}
	url=http://127.0.0.1:$port/mcp
	mcp="{\"mcpServers\":{\"ymer-node\":{\"type\":\"http\",\"url\":\"$url\"}}}"
	ran=''
	run_dir=$state # the folder a run is handed: state/, until the third arm names its own
	# The runs' working directories sit outside the home tree: for any
	# directory under it, Claude Code loads the home directory's own
	# .claude/CLAUDE.md as the home directory's project instructions,
	# whatever CLAUDE_CONFIG_DIR names — the config dir moves only where
	# the user's own instructions are read from. Both live in the entry's
	# temp dir, which its EXIT trap removes on every exit path, and both
	# are physical, as $dir is: isolation compares a run's reads against
	# the one, and the instructions check the path a transcript records
	# against the other.
	cwd=$(cd "$tmp" && pwd -P)/cwd
	control=$(cd "$tmp" && pwd -P)/control
	home=$(cd "$HOME" && pwd -P)

	# preconditions
	for d in "$cwd" "$control"; do
		case $d in
		"$home" | "$home"/*) abort cwd "the runs' working directory $d sits under $HOME, where every run would load the home directory's .claude/CLAUDE.md — point TMPDIR outside the home directory" ;;
		esac
	done
	[ -n "$compose" ] || abort compose "HERMETIC_PROBE_COMPOSE_FILE is unset — export it naming your Ymer Node's docker-compose.yml"
	[ -f "$compose" ] || abort compose "no file at $compose — point HERMETIC_PROBE_COMPOSE_FILE at your Ymer Node's docker-compose.yml"
	command -v docker-compose >/dev/null 2>&1 || abort docker "docker-compose is not on PATH — install the standalone docker-compose binary"
	docker info >/dev/null 2>&1 || abort docker "docker is not running — start it"
	docker image inspect ymer-node:latest >/dev/null 2>&1 || abort image "no ymer-node:latest image — build or pull the Ymer Node image the compose file runs"
	if curl -sS -o /dev/null "$url" >/dev/null 2>&1; then
		abort port "something already answers on 127.0.0.1:$port — set HERMETIC_PROBE_PORT to a free port"
	fi
	mkdir -p "$cfg" "$runs"
	rm -f "$runs"/*.jsonl "$runs"/*.err "$runs/node.log" "$runs/8-preimage.md"
	# cfg/projects/ is the probe's own: every session the config dir has
	# seen keeps its transcript there, a hand probe's and an older live
	# run's alike, and nothing else removes them. Wiped whole, before any
	# call writes this invocation's, and counted on a line of its own; the
	# login and the rest of cfg/ stay. A wipe that cannot finish fails its
	# line and the stage runs on: the checks read this invocation's
	# transcripts by session id, which nothing left behind can carry
	gone_files=$(find "$cfg/projects" -type f -name '*.jsonl' 2>/dev/null | wc -l | tr -d ' ')
	gone_dirs=$(find "$cfg/projects" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
	rm -rf "$cfg/projects" 2>/dev/null || true
	if [ -e "$cfg/projects" ]; then
		fail transcripts "could not remove all of $cfg/projects — remove it by hand (\`rm -rf '$cfg/projects'\`), checking why the probe could not"
	else
		pass transcripts "removed $gone_files transcript(s) in $gone_dirs project dir(s) from $cfg/projects — the probe's own, wiped at each live stage"
	fi
	export CLAUDE_CONFIG_DIR=$cfg

	# 1. login — the login call: one turn on the stage's model from the
	# runs' working directory, with no MCP server and no hook (hook/ is
	# written at step 5), its trace kept as runs/login.jsonl and its stderr
	# as runs/login.err — the cause, when the call wrote no result line —
	# and a red line names both. It runs before the scrub, the node and
	# the install, so a login that cannot answer
	# stops the stage before any of them. `claude auth status` is not the
	# read: it reported a login whose OAuth session had expired as logged
	# in, and every run under it then failed to authenticate, at $0. A call
	# that never reaches the model writes subtype success beside is_error
	# true and terminal_reason api_error, so live_error decides. The call
	# runs on whatever credential the CLI finds under cfg/: the claude.ai
	# login there, or one the maintainer's environment hands it — a token,
	# or a cloud provider's switch — which the stage leaves as set; only
	# the key is kept out, by the entry. So a pass says a call answered,
	# not which credential answered it. The
	# previous invocation's plugin is still enabled here, the scrub being
	# next; it ships no hook and no server, so the call loads a skill
	# listing and nothing that runs. An instrument like the control call:
	# not in $ran, and its transcript is never read. Its prompt differs from
	# the control call's, since the self-test answers each headless call by
	# its prompt. The command the abort names runs outside the probe, where
	# the key may be set: with it set, `auth login` reports success and
	# lands nothing
	rm -rf "$cwd"
	mkdir -p "$cwd"
	(cd "$cwd" && claude -p 'Say the single word ok.' --output-format stream-json --verbose \
		--model "$probe_model" --max-turns 1 \
		--strict-mcp-config --mcp-config '{"mcpServers":{}}') </dev/null >"$runs/login.jsonl" 2>"$runs/login.err" || true
	if call_err=$(live_error login); then
		pass login "a one-turn call under $cfg answered"
	else
		abort login "the login call $call_err — read $runs/login.jsonl and $runs/login.err — if the login lapsed, run: env -u ANTHROPIC_API_KEY CLAUDE_CONFIG_DIR=$cfg claude auth login --claudeai"
	fi

	# 2. scrub — every list empty afterwards; the MCP list may still carry
	# the login's claude.ai connectors, which no `mcp remove` reaches and
	# which the runs keep out by flag, so those lines are the one allowance.
	# The cache: `plugin uninstall` leaves the version directory behind
	# with an `.orphaned_at` marker (CLI 2.1.278, measured), and a later
	# install replaces such a directory whole — so a marked one is not a
	# lagging copy and does not count; an unmarked one does
	claude plugin uninstall ymer@ymer >/dev/null 2>&1 || true
	claude plugin marketplace remove ymer >/dev/null 2>&1 || true
	claude mcp remove ymer-node >/dev/null 2>&1 || true
	left=''
	claude plugin list --json 2>/dev/null | grep -q '"id": ".*@ymer"' && left="$left plugins"
	claude plugin marketplace list --json 2>/dev/null | grep -q '"name": "ymer"' && left="$left marketplace"
	claude mcp list 2>/dev/null | grep -v -e '^Checking MCP' -e '^claude\.ai ' -e '^No MCP servers configured\.' -e '^$' | grep -q . && left="$left mcp"
	[ "$(find "$cfg/plugins/cache/ymer" -mindepth 2 -maxdepth 2 -type d ! -exec test -e {}/.orphaned_at \; -print 2>/dev/null | wc -l | tr -d ' ')" = 0 ] || left="$left cache"
	if [ -z "$left" ]; then
		pass scrub "no ymer marketplace, plugins, plugin cache or MCP server in $cfg"
	else
		abort scrub "still present after the scrub:$left — remove them by hand under $cfg (\`claude plugin list\`, \`claude plugin marketplace list\`, \`claude mcp list\`, plugins/cache/ymer)"
	fi

	# 3. the scratch node — node_up goes to 1 before `up` runs, not after
	# it succeeds: a failed `up` can leave the project's network and
	# container behind, and the EXIT trap's teardown is what removes them
	# (it needs docker-before and data/ to exist, so it is set after both).
	# state/ fresh, and a plain folder: inside some git work tree, state/
	# would be refused as inside another git repository, and the second
	# arm would drain nothing
	rm -rf "$state"
	mkdir -p "$state"
	if git -C "$state" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
		abort state "$state is inside a git work tree — set HERMETIC_PROBE_DIR to a directory outside every git checkout"
	fi
	# compose/ fresh: the named compose file copied in, and the project name
	# the copy resolves to asserted as the probe's own before anything runs
	rm -rf "${scratch_compose%/*}"
	mkdir -p "${scratch_compose%/*}"
	cp "$compose" "$scratch_compose"
	live_resolves before-up || abort compose "docker-compose does not resolve the project to $live_project from $scratch_compose — read $runs/compose-config-before-up.log; nothing was brought up"
	docker ps --format '{{.Names}} {{.Ports}}' | sort >"$tmp/docker-before"
	rm -rf "$data"
	mkdir -p "$data"
	chmod -R a+rwX "$data"
	node_up=1
	if ! live_compose up -d >"$runs/compose-up.log" 2>&1; then
		abort node "docker-compose up failed — read $runs/compose-up.log"
	fi
	i=0
	until node_init; do
		i=$((i + 1))
		[ "$i" -lt 30 ] || abort node "the scratch node did not answer a tools/list on $url within 30 s — read \`docker-compose -p $live_project -f $scratch_compose logs\`"
		sleep 1
	done
	tables=$(node_tables)
	if [ "$tables" = 0 ]; then
		pass node "up on $url, notebook empty"
	else
		abort node "the scratch node's notebook holds $tables tables — its data/ ($data) was not empty at bring-up"
	fi

	# 4. the install path — the README's lines, the marketplace by path,
	# the plugin with the front alone; each tolerant, so a failed line is
	# reported by the list reads below rather than ending the script with
	# the CLI's own exit status
	claude mcp add --transport http --scope user ymer-node "$url" >"$runs/install.log" 2>&1 || true
	claude plugin marketplace add "$root" >>"$runs/install.log" 2>&1 || true
	claude plugin install ymer@ymer --config "front=$probe_front" >>"$runs/install.log" 2>&1 || true
	missing=''
	claude plugin list --json 2>/dev/null | grep -q '"id": "ymer@ymer"' || missing="$missing ymer@ymer"
	claude mcp list 2>/dev/null | grep -q "^ymer-node: $url" || missing="$missing ymer-node"
	if [ -z "$missing" ]; then
		pass install "marketplace from $root, ymer@ymer, ymer-node on $url"
	else
		abort install "not installed:$missing — read $runs/install.log"
	fi
	# the option is read back from cfg/ rather than trusted, as state/'s is
	# between the arms
	if grep -q -F "\"front\": \"$probe_front\"" "$cfg/settings.json" 2>/dev/null; then
		pass front "front set to $probe_front"
	else
		abort front "the install did not set front to $probe_front — read $runs/install.log and $cfg/settings.json"
	fi

	# 5. the runs — state from the node and from state/, behaviour from the
	# trace. The first arm names no state folder: the install above set the
	# front alone, so every skill reads the state folder's placeholder. The hook every
	# run loads is written first, from state/'s own path; the instructions
	# check's control call runs next, under the same hook.
	live_hook
	live_control
	live_run 1 '/ymer:setup'
	tables=$(node_tables)
	fronts=$(node_count 'SELECT count(*) FROM fronts')
	named=$(node_count "SELECT count(*) FROM fronts WHERE slug = '$probe_front'")
	if [ "$tables" = 8 ] && [ "$fronts" = 1 ] && [ "$named" = 1 ]; then
		pass setup "8 tables created, 1 front row, its slug $probe_front"
	else
		fail setup "after /ymer:setup the node holds $tables tables and $fronts front rows, $named of them $probe_front (expected 8, 1 and 1) — read $runs/1.jsonl"
	fi
	if live_calls 1 | grep -q '^mcp__ymer-node__notebook'; then
		pass setup-node "setup wrote through the node's notebook tool"
	else
		fail setup-node "no notebook call in $runs/1.jsonl — the run never reached the node"
	fi
	# the retired tables never arrive: no topics_history — no table, index
	# or trigger on it, every sqlite_master entry it would carry — and no
	# topics table
	history=$(node_count "SELECT count(*) FROM sqlite_master WHERE tbl_name = 'topics_history'")
	retired=$(node_count "SELECT count(*) FROM sqlite_master WHERE name = 'topics'")
	if [ "$history" = 0 ] && [ "$retired" = 0 ]; then
		pass setup-retired "no topics_history and no topics table"
	else
		fail setup-retired "after /ymer:setup sqlite_master holds $history topics_history entries and $retired topics tables (expected 0 and 0) — read $runs/1.jsonl"
	fi
	# the subject index arrives with its foreign key enforced: an engagement
	# row naming a subject tutor_subjects does not hold is refused by the
	# node on that key — a refusal for any other reason, no such table
	# among them, is no pass
	if node_body execute "{\"sql\":\"INSERT INTO tutor_engagements (title, subject, engagement_doc) VALUES ('probe engagement', 'probe-no-subject', 'probe-engagement')\"}" | grep -q 'FOREIGN KEY constraint failed'; then
		pass setup-tutor "tutor_engagements refuses an engagement whose subject has no row"
	else
		fail setup-tutor "an engagement row naming no subject was not refused on its foreign key — read the last execute in $runs/node.log"
		# an accepted probe row would read as tutor's write at run 9
		node_execute "DELETE FROM tutor_engagements WHERE title = 'probe engagement'" || true
	fi
	# the front named passes its own line, its row added; no state folder
	# named fails its line; and the coordinator is reported by reach — each
	# read as the facts its line carries. The coordinator's line is the one
	# that passed: the Meta Roadmap line, marked not checked, may name ymer,
	# its missing connection and tasks too
	if report_match 1 '✔' front "$probe_front" added | grep -q . &&
		report_match 1 '✘' state_folder 'not set' | grep -q . &&
		report_match 1 '✔' ymer 'no connection' tasks | grep -q .; then
		pass setup-report "front $probe_front added, state_folder not set and failed, ymer no connection — the coordinator reported by reach"
	else
		fail setup-report "the report has no line carrying \`✔\`, \`front\`, \`$probe_front\` and \`added\`, none carrying \`✘\`, \`state_folder\` and \`not set\`, or none carrying \`✔\`, \`ymer\`, \`no connection\` and \`tasks\` — read the result line of $runs/1.jsonl"
	fi

	# the prompt seeds a real friction, so the drop is one mint can drain:
	# an empty capture is a correct drop that nothing drains
	live_run 2 '/ymer:capture

Source: `readme_edit`. The work just finished, in the repo `demo`: one
README paragraph was reworded. It had to be done twice — the first
rewrite linked a heading, "Installing", that the README does not have,
and the broken link was found only by re-reading the file afterwards; a
link check before the edit would have caught it.'
	drops=$(node_count "SELECT count(*) FROM pool WHERE kind = 'friction'")
	filed=$(node_count "SELECT count(*) FROM pool WHERE kind = 'friction' AND front = '$probe_front'")
	if [ "$drops" = 1 ] && [ "$filed" = 1 ]; then
		pass capture "1 pool drop of kind friction, filed under $probe_front"
	else
		fail capture "after /ymer:capture the node holds $drops pool drops of kind friction, $filed of them under $probe_front (expected 1 and 1 — the prompt names a real friction, so an empty drop is a miss, and the drop is filed under the front the option named) — read $runs/2.jsonl"
	fi

	# mint with no state folder stops at its guard naming setup, and
	# drains, creates and scores nothing: the friction stays open for the
	# second arm's drain, and no pool_scores row is written — a row is
	# written once, so one laid down by a run that then stopped would stand
	# for good
	live_run 3 '/ymer:mint'
	open=$(node_count "SELECT count(*) FROM pool WHERE kind = 'friction' AND status = 'open'")
	minted=$(node_count 'SELECT count(*) FROM tasks')
	scores=$(node_count 'SELECT count(*) FROM pool_scores')
	if live_result 3 | grep -q -F '/ymer:setup'; then named=names; else named='does not name'; fi
	if [ "$open" = 1 ] && [ "$minted" = 0 ] && [ "$scores" = 0 ] && [ "$named" = names ]; then
		pass mint-stop "stopped naming /ymer:setup — the friction still open in the pool, no task, no pool_scores row"
	else
		fail mint-stop "after /ymer:mint with no state folder: $open open friction drops, $minted tasks, $scores pool_scores rows, and the result line $named /ymer:setup (expected 1, 0, 0, names) — read $runs/3.jsonl"
	fi

	# The second arm: state/ named as the state folder through the line the
	# README gives for it, the front beside it. Re-running the install over
	# the installed plugin rewrites the option (CLI 2.1.282, measured); the
	# setting is read back from cfg/ rather than trusted.
	claude plugin install ymer@ymer --config "front=$probe_front" --config "state_folder=$state" >>"$runs/install.log" 2>&1 || true
	if grep -q -F "\"state_folder\": \"$state\"" "$cfg/settings.json" 2>/dev/null &&
		grep -q -F "\"front\": \"$probe_front\"" "$cfg/settings.json" 2>/dev/null; then
		pass state-folder "state_folder set to $state"
	else
		abort state-folder "the install did not set state_folder to $state with front still $probe_front — read $runs/install.log and $cfg/settings.json"
	fi

	# the two schema reads are tolerant: a lost node fails the fronts
	# conjunct below (UNPARSEABLE against the count before) instead of
	# ending the script
	node_body query '{"sql":"SELECT name FROM sqlite_master ORDER BY name"}' >"$tmp/schema-before" || true
	fronts_before=$fronts
	live_run 4 '/ymer:setup'
	node_body query '{"sql":"SELECT name FROM sqlite_master ORDER BY name"}' >"$tmp/schema-after" || true
	fronts=$(node_count 'SELECT count(*) FROM fronts')
	if cmp -s "$tmp/schema-before" "$tmp/schema-after" && [ "$fronts" != UNPARSEABLE ] && [ "$fronts" = "$fronts_before" ]; then
		pass converge "sqlite_master and the fronts count unchanged by the re-run"
	else
		fail converge "the re-run changed the node (schema or fronts count) — read $runs/4.jsonl"
	fi
	if live_executed 4; then
		fail converge-calls "the re-run made an execute call — read $runs/4.jsonl"
	else
		pass converge-calls "no execute call in the re-run"
	fi
	# the node's and the front's lines on a healthy re-run: the node
	# reachable with the tables it holds, the front named, and nothing
	# created or added — converge-calls shows the re-run executed nothing,
	# so a line carrying either line's facts that says either word states a
	# change that never happened. Every such line is read, and one saying
	# either word fails the check even beside a clean one. Known gap: the check reads the words' presence, not what the line
	# asserts, so a healthy line that names either word only to deny it
	# (`nothing added`) reads red too; setup's own grammar gives a healthy
	# re-run the bare line, and a red here is loud, never a silent pass.
	# And the reverse, through report_words' boundary: `-` and `/` are name
	# characters, so a line saying `re-added`, `auto-created` or
	# `created/added` reads neither word and passes — a false claim only,
	# since converge and converge-calls read the node itself.
	node_lines=$(report_match 4 '✔' node reachable '8 tables')
	front_lines=$(report_match 4 '✔' front "$probe_front")
	if [ -n "$node_lines" ] && [ -n "$front_lines" ] && ! { printf '%s\n%s\n' "$node_lines" "$front_lines" | report_words created; printf '%s\n%s\n' "$node_lines" "$front_lines" | report_words added; } | grep -q .; then
		pass converge-report "the node line reads reachable and 8 tables, the front line $probe_front, nothing created or added"
	else
		fail converge-report "the re-run's report does not read a node line carrying \`✔\`, \`reachable\` and \`8 tables\` and a front line carrying \`✔\`, \`front\` and \`$probe_front\`, or a line carrying them also reads \`created\` or \`added\` — read the result line of $runs/4.jsonl"
	fi
	# the folder's own line: state/ printed as configured, read as a folder
	# in no git repository, passed, the files named as the record on the
	# same line
	if report_match 4 '✔' state_folder "$state" 'in no git repository' 'the files are the record' | grep -q .; then
		pass setup-folder "state/ reported as in no git repository, the files the record"
	else
		fail setup-folder "the re-run's report does not read \`✔\`, \`state_folder\`, $state, \`in no git repository\` and \`the files are the record\` on one line — read the result line of $runs/4.jsonl"
	fi

	# Each of the three seeded steps runs only when its seed took: a step
	# whose seed failed is reported not run, never asserted over state the
	# seed left as it was — a due_date never dropped reads "put back" on
	# its own, and a recurrence never inserted leaves the bug's topic as it
	# was. A seed the node refused: its own fail line, and the step not run.
	seed_failed() {
		fail "$1-seed" "$2"
		notrun "$1" "its seed failed — see $1-seed"
	}
	due_pragma="SELECT count(*) FROM pragma_table_info('tasks') WHERE name = 'due_date'"
	if node_execute 'ALTER TABLE tasks DROP COLUMN due_date' && [ "$(node_count "$due_pragma")" = 0 ]; then
		live_run 5 '/ymer:setup'
		due=$(node_count "$due_pragma")
		if [ "$due" = 1 ]; then
			pass drift "tasks.due_date put back"
		else
			fail drift "tasks.due_date is still missing after /ymer:setup — read $runs/5.jsonl"
		fi
	else
		seed_failed drift "DROP COLUMN due_date did not remove tasks.due_date on the node — read $runs/node.log"
	fi

	# the drain into state/, read as the artefacts it deposits: a task at
	# claimed in the project the area derives, the one friction drained to
	# a topic — its drained_to the topic's folder, <area>/YYYY/MM-DD-<topic>/
	# — and the file itself at state/<drained_to>request.md, mint's own
	# save, carrying `source: mint`. The file is the whole of the save: the
	# folder alone finds the topic
	live_run 6 '/ymer:mint'
	tasks=$(node_count "SELECT count(*) FROM tasks WHERE status = 'claimed' AND project LIKE '% Roadmap'")
	drained=$(node_count "SELECT count(*) FROM pool WHERE status = 'drained' AND kind = 'friction'")
	to=$(node_text "SELECT drained_to FROM pool WHERE status = 'drained' AND kind = 'friction'")
	if [ -f "$state/${to}request.md" ]; then file=present; else file=absent; fi
	sourced=$(file_occurrences "$state/${to}request.md" 'source: mint')
	if [ "$tasks" != UNPARSEABLE ] && [ "$tasks" -ge 1 ] && [ "$drained" = 1 ] && [ "$file" = present ] &&
		[ "$sourced" != UNPARSEABLE ] && [ "$sourced" -ge 1 ]; then
		pass mint "$tasks tasks row(s) at claimed in a Roadmap project, the friction drained to $to, its request.md in state/ carrying source: mint"
	else
		fail mint "after /ymer:mint: $tasks tasks at claimed in a Roadmap project, $drained friction drops drained, request.md at state/$to $file, \`source: mint\` $sourced time(s) in it (expected ≥1, 1, present, ≥1) — read $runs/6.jsonl"
	fi

	# scoring runs first: after the mint, every drop that is not empty holds
	# a pool_scores row — written by a scorer, or by the run's own session
	# where it could dispatch none — so the draw never ranked a drop it had
	# not scored. The drops the mint's own capture wrote at its close, after
	# scoring, carry source mint and wait for the next run's scoring
	unscored=$(node_count "SELECT count(*) FROM pool p LEFT JOIN pool_scores s ON s.drop_id = p.id WHERE p.kind <> 'empty' AND p.source <> 'mint' AND s.drop_id IS NULL")
	if [ "$unscored" = 0 ]; then
		pass scored "every drop that is not empty holds a pool_scores row after /ymer:mint"
	else
		fail scored "after /ymer:mint $unscored drop(s) that are not empty hold no pool_scores row (expected 0) — read $runs/6.jsonl"
	fi
	# which path wrote those rows: a subagent call pinned to haiku in run 6
	# and a subagent transcript beside the run's own is the scorer path. A
	# run that scored in-session instead took the fallback the skill allows
	# where no subagent can be dispatched — reported, never passed and never
	# failed: the rows are the same rows, but the scorer path went unexercised
	agents=$(live_calls 6 | grep '^Agent ' | grep -c -F '"model":"haiku"' || true)
	subs=$(live_transcripts "$runs/6.jsonl" | grep -c '/subagents/' || true)
	if [ "$agents" -ge 1 ] && [ "$subs" -ge 1 ]; then
		pass dispatch "$agents haiku subagent call(s) in run 6, $subs subagent transcript(s)"
	else
		notrun dispatch "run 6 scored in-session — $agents haiku subagent call(s), $subs subagent transcript(s); the fallback is allowed, so the scorer path is unverified — read $runs/6.jsonl"
	fi
	# the mint's capture block ran at its close: capture writes at least one
	# drop on every run, an empty one where it observed nothing, so a source
	# mint drop after run 6 is the block's mark on the node
	captured=$(node_count "SELECT count(*) FROM pool WHERE source = 'mint'")
	if [ "$captured" != UNPARSEABLE ] && [ "$captured" -ge 1 ]; then
		pass mint-capture "$captured source mint drop(s) after /ymer:mint — its capture block ran"
	else
		fail mint-capture "after /ymer:mint the node holds $captured source mint drops (expected ≥1 — capture writes at least an empty drop) — read $runs/6.jsonl"
	fi

	# The bug on top, by score: ten open frictions and one open bug seeded
	# together, each with a pool_scores row seeded beside it — the bug 5,
	# 5, 5 over size 1, each friction 1, 1, 1 over size 5 — so the ranking,
	# never the scorer's model, decides the draw; and the mint after them
	# draws the bug — drained to a topic of its own,
	# the frictions left open. The bug's topic is read as its save: the
	# file in state/, found by the bug's drained_to as run 6's is. The bug's
	# title is what its line in request.md quotes (capture's drop-as-a-line
	# grammar: a drop with a title renders as `bug: <title> (#id)`), so it
	# is counted once in the file. The topic is addressed by its folder,
	# never by a count of drained drops: run 8's fold drains into the same
	# topic.
	bug_title='Probe gauge reads its dial backwards'
	bug_body='The probe gauge showed every seeded reading reversed.'
	recur_clause='the gauge stuck at noon on the second seeded pass'
	front_sql='(SELECT slug FROM fronts LIMIT 1)'
	seed="INSERT INTO pool (front, source, context, kind, title, body) VALUES"
	i=0
	while [ "$i" -lt 10 ]; do
		i=$((i + 1))
		seed="$seed ($front_sql, 'hermetic_probe', 'probe/seed', 'friction', NULL, 'seed friction $i below the bar'),"
	done
	seed="$seed ($front_sql, 'hermetic_probe', 'probe/seed', 'bug', '$bug_title', '$bug_body')"
	bug_id_sql="SELECT id FROM pool WHERE source = 'hermetic_probe' AND kind = 'bug' AND anchor_id IS NULL"
	score_seed="INSERT INTO pool_scores (drop_id, direction_value, time_criticality, risk_reduction, size, why) SELECT id, CASE kind WHEN 'bug' THEN 5 ELSE 1 END, CASE kind WHEN 'bug' THEN 5 ELSE 1 END, CASE kind WHEN 'bug' THEN 5 ELSE 1 END, CASE kind WHEN 'bug' THEN 1 ELSE 5 END, 'probe seed' FROM pool WHERE source = 'hermetic_probe' AND status = 'open' AND kind IN ('bug', 'friction')"
	seeds_open_sql="SELECT count(*) FROM pool WHERE status = 'open' AND kind = 'friction' AND source = 'hermetic_probe'"
	bug_ok=0
	bug_id=UNPARSEABLE
	if node_execute "$seed" && bug_id=$(node_count "$bug_id_sql") && [ "$bug_id" != UNPARSEABLE ] && node_execute "$score_seed"; then
		live_run 7 '/ymer:mint'
		bug_to=$(node_text "SELECT drained_to FROM pool WHERE status = 'drained' AND id = $bug_id")
		seeds_open=$(node_count "$seeds_open_sql")
		files=$(topic_files "$bug_to" | wc -l | tr -d ' ')
		f=$state/${bug_to}request.md
		if [ -f "$f" ]; then file=present; else file=absent; fi
		file_lines=$(file_occurrences "$f" "$bug_title")
		if [ "$bug_to" != UNPARSEABLE ] && [ "$file" = present ] && [ "$files" = 1 ] && [ "$seeds_open" = 10 ] &&
			[ "$file_lines" = 1 ]; then
			pass bug-first "the bug drawn ahead of ten open frictions, drained to $bug_to — one request.md there in state/, quoting its title once — the ten seed frictions still open"
			bug_ok=1
		else
			fail bug-first "after /ymer:mint over ten seed frictions and one bug: the bug drained to $bug_to, request.md at state/$bug_to $file, $files request.md file(s) in that folder, $seeds_open seed frictions open, the bug's title $file_lines time(s) in the file (expected a topic folder, present, 1, 10, 1) — read $runs/7.jsonl"
		fi
	else
		seed_failed bug-first "the node refused the seed drops — ten frictions and a bug — or holds no bug id for them, or refused their pool_scores rows — read $runs/node.log"
	fi

	# The fold is read as a delta over the bug's topic: a recurrence of the
	# bug, anchored on it by id, drained by the next mint into the same
	# topic — nobody has started it, so the drop is folded into its
	# request.md — still one file, the recurrence's clause in it where it
	# was not before, the started date kept.
	# The fold inserts and never rewrites: the file as run 8 found it, kept
	# in runs/ as 8-preimage.md, is read against the file after — every
	# line of it still there, in order and byte for byte, new lines
	# anywhere between them, since a friction-batch's append lands under a
	# heading mid-file and is the same append. A run that rewords or drops
	# a line the file held fails, whichever tool wrote it.
	# The `_before` reads follow the seed: it inserts one open drop, which
	# does not move the file.
	recur_seed="INSERT INTO pool (front, source, context, kind, anchor_id, body) VALUES ($front_sql, 'hermetic_probe', 'probe/seed', 'bug', $bug_id, '$recur_clause')"
	recur_score_seed="INSERT INTO pool_scores (drop_id, direction_value, time_criticality, risk_reduction, size, why) SELECT id, 5, 5, 5, 1, 'probe seed' FROM pool WHERE source = 'hermetic_probe' AND anchor_id = $bug_id"
	if [ "$bug_ok" != 1 ]; then
		notrun append "the bug-first step did not pass — see bug-first"
		notrun append-keep "the append step did not run — see append"
	elif ! { node_execute "$recur_seed" && node_execute "$recur_score_seed"; }; then
		seed_failed append "the node refused the recurrence seed drop or its pool_scores row — read $runs/node.log"
		notrun append-keep "the append step did not run — see append"
	else
		lines_before=$(file_occurrences "$f" "$recur_clause")
		started_before=$(file_started "$f")
		pre=$runs/8-preimage.md
		cp "$f" "$pre" 2>/dev/null || true
		live_run 8 '/ymer:mint'
		files=$(topic_files "$bug_to" | wc -l | tr -d ' ')
		recur_to=$(node_text "SELECT drained_to FROM pool WHERE status = 'drained' AND anchor_id = $bug_id")
		lines_after=$(file_occurrences "$f" "$recur_clause")
		started_after=$(file_started "$f")
		if [ "$files" = 1 ] && [ "$recur_to" = "$bug_to" ] &&
			[ "$lines_before" != UNPARSEABLE ] && [ "$lines_after" != UNPARSEABLE ] && [ "$lines_after" -gt "$lines_before" ] &&
			[ "$started_before" != UNPARSEABLE ] && [ "$started_after" = "$started_before" ]; then
			pass append "still one request.md in $bug_to, started $started_before kept, the recurrence drained to the bug's topic, its clause in the file $lines_before → $lines_after"
		else
			fail append "$files request.md file(s) in $bug_to, started $started_before → $started_after, the recurrence drained to $recur_to, its clause in the file $lines_before → $lines_after (expected 1, unchanged, $bug_to, more) — read $runs/8.jsonl"
		fi
		pre_lines=$(file_length "$pre")
		kept=$(file_kept "$pre" "$f")
		if [ "$pre_lines" != UNPARSEABLE ] && [ "$kept" = "$pre_lines" ]; then
			pass append-keep "every one of the $pre_lines line(s) the file held before the fold still in it, in order, byte for byte — $(file_length "$f") line(s) now"
		else
			case $kept in
			UNPARSEABLE) lost=UNPARSEABLE ;;
			*) lost="line $((kept + 1)): '$(sed -n "$((kept + 1))p" "$pre" 2>/dev/null || true)'" ;;
			esac
			fail append-keep "$kept of the $pre_lines line(s) the file held before the fold still in it, in order, the first not found $lost (expected all $pre_lines, byte for byte) — the pre-image is at $pre, read $runs/8.jsonl"
		fi
	fi

	# Tutor stops at its guard where a store it needs is missing, and
	# writes nothing on the way: first with its tables in place and no
	# ymer — every run loads the scratch node alone — then with the tables
	# dropped, a node set up before they existed. The drop is a seed,
	# engagements first since its foreign key names the subjects table, and
	# a drop the node refused leaves the step not run.
	live_run 9 '/ymer:tutor git'
	subjects=$(node_count 'SELECT count(*) FROM tutor_subjects')
	engagements=$(node_count 'SELECT count(*) FROM tutor_engagements')
	if live_executed 9; then wrote=wrote; else wrote='no write'; fi
	# ymer as a word of its own: report_words leaves out ymer-node and
	# /ymer:<skill>, and the Ymer Node, two words, is taken out first
	if report_lines 9 | sed 's/[Yy][Mm][Ee][Rr] [Nn][Oo][Dd][Ee]//g' | report_words ymer docs | grep -q .; then named=names; else named='does not name'; fi
	if [ "$subjects" = 0 ] && [ "$engagements" = 0 ] && [ "$wrote" = 'no write' ] && [ "$named" = names ]; then
		pass tutor-ymer "stopped naming ymer as its docs' home — no execute call, both tutor tables empty"
	else
		fail tutor-ymer "after /ymer:tutor with no ymer: $subjects tutor_subjects rows, $engagements tutor_engagements rows, $wrote, and the report $named ymer and docs on one line (expected 0, 0, no write, names) — read $runs/9.jsonl"
	fi
	tutor_tables="SELECT count(*) FROM sqlite_master WHERE name LIKE 'tutor%'"
	if node_execute 'DROP TABLE tutor_engagements' && node_execute 'DROP TABLE tutor_subjects' && [ "$(node_count "$tutor_tables")" = 0 ]; then
		live_run 10 '/ymer:tutor git'
		tutor_left=$(node_count "$tutor_tables")
		if live_executed 10; then wrote=wrote; else wrote='no write'; fi
		if live_result 10 | grep -q -F '/ymer:setup'; then named=names; else named='does not name'; fi
		if [ "$tutor_left" = 0 ] && [ "$wrote" = 'no write' ] && [ "$named" = names ]; then
			pass tutor-stop "stopped naming /ymer:setup — no execute call, no tutor table created"
		else
			fail tutor-stop "after /ymer:tutor with no tutor tables: $tutor_left tutor tables, $wrote, and the result line $named /ymer:setup (expected 0, no write, names) — read $runs/10.jsonl"
		fi
	else
		seed_failed tutor-stop "DROP TABLE did not remove the tutor tables on the node — read $runs/node.log"
	fi

	# The third arm: state/encl/plans named as the state folder, encl/ a git
	# repository of its own, made here with no commit — so the reading
	# answers `true` and the prefix `plans/` for the folder, while state/
	# itself stays in no git repository, since git looks for a repository
	# upward from a folder and never down into one. It runs last, so no
	# earlier run meets the nested repository and the run numbers above
	# keep their meaning; its runs are handed the arm's folder in place of
	# state/. Setup must fail its state-folder check naming the folder, its
	# prefix and the `git init` fix, and mint must stop at its guard naming
	# /ymer:setup — no drop drained, no task, no pool_scores row and no
	# file in the folder. Each run must have read
	# the folder's kind: a run that never looked would pass by accident.
	# Their writes and commits fall under the checks below, which count both
	# runs. Only the mark, the role and the folder are bound to the
	# state-folder line; the prefix and the fix are facts of the whole
	# report, wherever the model puts them.
	encl_repo=${encl%/plans}
	rm -rf "$encl_repo"
	mkdir -p "$encl"
	git -C "$encl_repo" init -q 2>"$runs/encl-init.err" || abort encl "git init failed in $encl_repo — read $runs/encl-init.err"
	encl_read=$(git -C "$encl" rev-parse --is-inside-work-tree --show-prefix 2>"$runs/encl-read.err" | tr '\n' ' ')
	[ "$encl_read" = 'true plans/ ' ] || abort encl "the reading on $encl printed '$encl_read', not true and plans/ — the third arm needs a folder inside another git repository; read $runs/encl-read.err"
	claude plugin install ymer@ymer --config "front=$probe_front" --config "state_folder=$encl" >>"$runs/install.log" 2>&1 || true
	if grep -q -F "\"state_folder\": \"$encl\"" "$cfg/settings.json" 2>/dev/null &&
		grep -q -F "\"front\": \"$probe_front\"" "$cfg/settings.json" 2>/dev/null; then
		pass encl-folder "state_folder set to $encl"
	else
		abort encl-folder "the install did not set state_folder to $encl with front still $probe_front — read $runs/install.log and $cfg/settings.json"
	fi
	run_dir=$encl
	# whether run <n> ran the reading on the arm's folder: a Bash call that
	# ran, never one refused, naming the folder and the whole reading
	read_kind() { # read_kind <n>
		live_bash "$1" | grep -F -- "$encl" | grep -q -F -- 'rev-parse --is-inside-work-tree --show-prefix'
	}
	live_run 11 '/ymer:setup'
	if read_kind 11; then looked=read; else looked='did not read'; fi
	if report_lines 11 | report_words 'plans/' | grep -q .; then prefix=names; else prefix='does not name'; fi
	if report_lines 11 | report_words 'git init' | grep -q .; then fix=names; else fix='does not name'; fi
	if report_match 11 '✘' state_folder "$encl" | grep -q .; then role='a line'; else role='no line'; fi
	if [ "$role" = 'a line' ] && [ "$prefix" = names ] && [ "$fix" = names ] && [ "$looked" = read ]; then
		pass setup-enclosed "$encl failed as inside another git repository, its prefix plans/ and the git init fix named, the folder's kind read"
	else
		fail setup-enclosed "the report has $role carrying \`✘\`, \`state_folder\` and $encl, $prefix the prefix \`plans/\`, $fix the \`git init\` fix, and the run $looked the folder's kind (expected a line, names, names, read) — read the result line and the Bash calls of $runs/11.jsonl"
	fi
	drained_sql="SELECT count(*) FROM pool WHERE status = 'drained'"
	drained_before=$(node_count "$drained_sql")
	tasks_before=$(node_count 'SELECT count(*) FROM tasks')
	scores_before=$(node_count 'SELECT count(*) FROM pool_scores')
	live_run 12 '/ymer:mint'
	drained_after=$(node_count "$drained_sql")
	tasks_after=$(node_count 'SELECT count(*) FROM tasks')
	scores_after=$(node_count 'SELECT count(*) FROM pool_scores')
	encl_files=$(find "$encl" -type f 2>/dev/null | wc -l | tr -d ' ')
	if live_result 12 | grep -q -F '/ymer:setup'; then named=names; else named='does not name'; fi
	if read_kind 12; then looked=read; else looked='did not read'; fi
	if [ "$drained_before" != UNPARSEABLE ] && [ "$drained_after" = "$drained_before" ] &&
		[ "$tasks_before" != UNPARSEABLE ] && [ "$tasks_after" = "$tasks_before" ] &&
		[ "$scores_before" != UNPARSEABLE ] && [ "$scores_after" = "$scores_before" ] &&
		[ "$encl_files" = 0 ] && [ "$named" = names ] && [ "$looked" = read ]; then
		pass mint-enclosed "stopped naming /ymer:setup, the folder's kind read — $drained_after drained drops, $tasks_after tasks and $scores_after pool_scores rows, each as before, no file in $encl"
	else
		fail mint-enclosed "after /ymer:mint with the state folder inside another git repository: drained drops $drained_before → $drained_after, tasks $tasks_before → $tasks_after, pool_scores rows $scores_before → $scores_after, $encl_files file(s) in $encl, the run $looked the folder's kind, and the result line $named /ymer:setup (expected each count unchanged, 0 files, read, names) — read $runs/12.jsonl"
	fi

	# Behaviour across every run that ran: the servers each run saw, the
	# files it read and wrote, the node ports a setup run's report names,
	# and every Bash command — the tool name alone cannot tell a declared
	# command from a shell redirect, so the whole command is read, and a
	# command with anything after it (a `;`, a pipe, a redirect) is not it.
	servers=''
	unreached=''
	outside=''
	writes=''
	shell=''
	refused=''
	commits=''
	write_runs=' 6 7 8 '
	mint_runs=' 3 6 7 8 12 '
	setup_runs=' 1 4 5 11 '
	addressed=''
	loaded=''
	loaded_first=''
	unseen=''
	unseen_first=''
	transcripts=0
	for n in $ran; do
		# the init line is the trace's first; every server it names must
		# be ymer-node, and no other server's tool may have been reached
		# past it — ToolSearch finds a connector's tools whether or not
		# the init line listed the connector. A call the CLI answered
		# with no such tool reached nothing: it is left out here and named
		# on the pass line with its tool, as a refused command is
		named=$(head -n 1 "$runs/$n.jsonl" | grep -o '"mcp_servers":\[[^]]*\]' | grep -o '"name":"[^"]*"' | sort -u | tr '\n' ' ')
		live_mcp "$n" >"$tmp/mcp"
		if [ "$named" != '"name":"ymer-node" ' ] || grep '^reached ' "$tmp/mcp" | grep -v -q '^reached mcp__ymer-node__'; then
			servers="$servers $n"
		fi
		tools=$(sed -n 's/^unreached //p' "$tmp/mcp" | sort -u | tr '\n' ' ' | sed 's/ $//')
		[ -z "$tools" ] || unreached="$unreached $n ($tools)"
		# every path a Read, Glob or Grep named sits under the probe dir's
		# state/, the run's own working directory, or the marketplace
		# checkout the plugins load from; a relative one resolves under the
		# run's working directory. The rest of the probe dir is no root a
		# run is handed: cfg/ holds the login, its account record and every
		# session's transcript. An allow-list, so a read a skill
		# legitimately needs elsewhere fails here, named, and is admitted by
		# widening this arm.
		# `..` is read before the two prefixes: a path under an allowed
		# prefix that then climbs is outside, and the prefix arm — case
		# takes its first match — would keep it as inside
		live_reads "$n" | while IFS= read -r p; do
			case $p in
			'~/'*) p=$HOME/${p#'~/'} ;;
			esac
			case $p in
			.. | ../* | */.. | */../*) echo "$p" ;;
			"$state" | "$state"/* | "$cwd" | "$cwd"/* | "$root" | "$root"/*) ;;
			/* | '~'*) echo "$p" ;;
			esac
		done | grep -q . && outside="$outside $n"
		# a file write belongs to the second arm's mint runs alone, and
		# lands under state/: any other run's write, a write naming a path
		# outside state/ or climbing out of it, and a write whose path the
		# read cannot find all count
		wcalls=$(live_calls "$n" | grep -E '^(Write|Edit|NotebookEdit) ' || true)
		if [ -n "$wcalls" ]; then
			case $write_runs in
			*" $n "*)
				printf '%s\n' "$wcalls" | while IFS= read -r c; do
					p=$(printf '%s\n' "$c" | sed -E -n 's/.*"(file_path|notebook_path)":"([^"]*)".*/\2/p')
					case $p in
					.. | ../* | */.. | */../*) echo "$c" ;;
					"$state"/*) ;;
					*) echo "$c" ;;
					esac
				done | grep -q . && writes="$writes $n"
				;;
			*) writes="$writes $n" ;;
			esac
		fi
		# every command that ran is a declared one, read as the runs'
		# hook reads it: the command is the whole JSON string, escaped
		# quotes included. A mint run's are read against hook/declared,
		# every other run's against hook/declared-base, so a capture or
		# setup run that searches or lists the state folder is named
		# here although the hook let it run. A refused call never
		# ran, whatever its input's shape: live_bash leaves it out by its
		# id, and the run is named on the pass line. An input that ran
		# whose first key is not the command is not unwrapped, and fails
		# closed. A grep that cannot read its file (status 2) counts
		# the run, so a lost file fails closed rather than passing every
		# command
		case $mint_runs in
		*" $n "*) set_file=declared ;;
		*) set_file=declared-base ;;
		esac
		bash_commands "$n" |
			grep -v -E -f "$hook/$set_file" >"$tmp/other" || [ $? -eq 1 ] || echo "hook/$set_file unreadable" >>"$tmp/other"
		grep -q . "$tmp/other" && shell="$shell $n"
		denied_bash "$n" | grep -q . && refused="$refused $n"
		# a commit attempt is any Bash call of a mint run, refused or
		# run, whose command carries `git commit` — less the declared
		# commands, whose search term is free text and may name it. A
		# grep that cannot read hook/declared keeps every command, so a
		# lost file still counts a real commit
		case $mint_runs in
		*" $n "*) bash_commands "$n" all >"$tmp/calls"
			{ grep -v -E -f "$hook/declared" "$tmp/calls" || [ $? -eq 1 ] || cat "$tmp/calls"; } | grep -q 'git commit' && commits="$commits $n" ;;
		esac
		# a setup report names the node only where it runs: a port it
		# gives other than the probe's own is an address the node is not on
		case $setup_runs in
		*" $n "*) report_ports "$n" | grep -v -x -F "$port" | grep -q . && addressed="$addressed $n" ;;
		esac
		# every transcript the run left, its subagents' included, read for
		# the instructions check: a file any of them records as loaded, and
		# a transcript missing or recording no environment — one the read
		# cannot vouch for — each names the run, the first of each kept for
		# the fail line
		live_instructions "$runs/$n.jsonl" >"$tmp/instructions"
		first=$(awk -F '\t' '$1 == "loaded" { print $2 " in " $3; exit }' "$tmp/instructions")
		[ -z "$first" ] || loaded="$loaded $n"
		[ -n "$loaded_first" ] || loaded_first=$first
		first=$(awk -F '\t' '$1 == "unseen" { print $2; exit }' "$tmp/instructions")
		[ -z "$first" ] || unseen="$unseen $n"
		[ -n "$unseen_first" ] || unseen_first=$first
		transcripts=$((transcripts + $(grep -c '^read' "$tmp/instructions" || true)))
	done
	if [ -z "$servers" ]; then
		pass servers "every run's init line names ymer-node alone, and no other server's tool was called${unreached:+ — a call to no such tool, reaching nothing, in run(s)$unreached}"
	else
		fail servers "run(s)$servers reached a server beyond ymer-node — read the init line's mcp_servers and the mcp__ calls in $runs/<n>.jsonl"
	fi
	if [ -z "$outside" ]; then
		pass isolation "every Read, Glob and Grep stayed under $state, $root or the runs' working directory $cwd"
	else
		fail isolation "run(s)$outside read outside $state, $root and the runs' working directory $cwd, the only roots a run is handed — read the call and its permission_denials in $runs/<n>.jsonl; a read a skill legitimately needs elsewhere is admitted by widening isolation's arm in scripts/hermetic-probe-live"
	fi
	if [ -z "$writes" ]; then
		pass writes "file writes only in the second arm's mint runs, and only under $state"
	else
		fail writes "a file write outside the second arm's mint runs or outside $state in run(s)$writes — read $runs/<n>.jsonl"
	fi
	if [ -z "$shell" ]; then
		pass bash-commands "no Bash command beyond \`claude mcp get <name>\`, the state folder's \`rev-parse\` and, in a mint run, the mint reads of it ran in any run${refused:+ — refused, never run, in run(s)$refused}"
	else
		fail bash-commands "a Bash command other than \`claude mcp get <name>\`, the state folder's \`rev-parse\` or, in a mint run, the mint reads of it in run(s)$shell — read its command in $runs/<n>.jsonl"
	fi
	if [ -z "$commits" ]; then
		pass mint-git "no git commit attempted in any mint run"
	else
		fail mint-git "mint attempted a git commit, with no state folder that is its own git repository, in run(s)$commits — read $runs/<n>.jsonl"
	fi
	if [ -z "$addressed" ]; then
		pass setup-address "every setup report names the node at its own port or at no address"
	else
		fail setup-address "a setup report names a node port other than $port in run(s)$addressed — read the result line of $runs/<n>.jsonl"
	fi
	# instructions: no run loads an instructions file, and the read that
	# says so proves its sight twice — every transcript it read records an
	# environment attachment, and the control call's transcript records the
	# CLAUDE.md the probe planted, nothing more and nothing less. A red
	# control reddens the line whatever the runs showed: the read it vouches
	# for is the one they were read by
	live_instructions "$runs/control.jsonl" >"$tmp/instructions"
	control_files=$(awk -F '\t' '$1 == "loaded" { print $2 }' "$tmp/instructions" | sort -u | tr '\n' ' ' | sed 's/ $//')
	control_unseen=$(awk -F '\t' '$1 == "unseen" { print $2; exit }' "$tmp/instructions")
	why=''
	[ -z "$loaded" ] || why="run(s)$loaded loaded an instructions file — first $loaded_first"
	[ -z "$unseen" ] || why="${why:+$why; }run(s)$unseen left a transcript the check cannot vouch for, missing or recording no environment — first $unseen_first"
	if [ -n "$control_unseen" ]; then
		why="${why:+$why; }the control run left a transcript the check cannot vouch for — $control_unseen; read $runs/control.jsonl and its transcript"
	elif [ "$control_files" != "$control/CLAUDE.md" ]; then
		why="${why:+$why; }the control run recorded ${control_files:-no instructions file} where it planted $control/CLAUDE.md alone, so the read cannot be trusted to see a load; read $runs/control.jsonl and its transcript"
	fi
	if [ -z "$why" ]; then
		pass instructions "no run loaded an instructions file — $transcripts transcript(s) read, each recording its environment, and the control run recorded its planted CLAUDE.md alone"
	else
		fail instructions "$why"
	fi

	# 6. teardown — here on the way through, so its install line lands
	# before the summary; the EXIT trap runs it instead on any earlier exit.
	live_teardown
}
