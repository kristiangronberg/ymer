#!/bin/sh
# hermetic-probe-eval — the eval stage, sourced by hermetic-probe: every
# case under evals/ run once through `claude plugin eval`, each a skill
# fired with no Ymer Node reachable, asserting from the runner's own JSON
# result that every case loaded, ran to its own end, and passed.
#
# What a case asserts is in its case.yaml: the skill fired (the child's
# init event names the plugin and the slash command, and the skill's own
# announce line appears in the trace), it stopped (no write tool, no MCP
# tool, and — read here — no run error such as the turn cap), and it named
# its door — setup anywhere in the run, the others in their last message.
# The model is the entry script's pin, so a model rollout is never
# mistaken for a plugin regression; the run uses the credential of the
# config dir this script runs under, in the runner's own isolation.
#
# The runner writes its own results under evals/results/ (ignored by git),
# one directory per run named for its start time; this stage keeps its
# JSON result and the runner's output there too, as
# evals/results/hermetic-probe.json and hermetic-probe.log. A red keeps
# its evidence: the runner keeps every run's temp dir, the trace of each
# run that did not pass is copied into the run's own results directory as
# <case>.trace.jsonl, and every kept temp dir is removed, green or red,
# and on an interrupted run too: when the stage is ended before its own
# removal pass, the entry script's EXIT trap removes them instead. The one
# exception is a result this stage cannot read: then no trace can be told
# from another, so every kept temp dir stays, and the layout line names
# them.

# Every temp dir the runner kept, each named on its own `⚠ kept <dir>:`
# line in <log>, whether or not a result was written. The log is read in
# the C locale, so a byte that is not valid UTF-8 never stops the read.
eval_kept_dirs() { # eval_kept_dirs <log> — each kept dir <log> names, one per line
	LC_ALL=C sed -n 's/^⚠ kept \([^ ]*\): .*/\1/p' "$1"
}

# Removes every temp dir the runner kept. The runner seals what the plugin
# under test wrote in <dir>/sealed at mode 000 and leaves <dir> read-only,
# so both are opened before the removal. Only a directory shaped like the
# runner's own — a last component named e-* or claude-eval-*, holding
# out/ — is ever removed. Runs once the runner returns, or instead from
# the EXIT trap when the stage was ended before that. The dirs that
# outlived their removal are named on a `kept` fail line.
eval_remove_kept() { # eval_remove_kept <log>
	left=''
	[ -f "$1" ] || return 0
	eval_kept_dirs "$1" >"$tmp/eval-kept"
	while IFS= read -r d; do
		case ${d##*/} in
		e-?* | claude-eval-?*) ;;
		*) continue ;;
		esac
		if [ -d "$d/out" ]; then
			chmod 700 "$d" 2>/dev/null || true
			if [ -d "$d/sealed" ]; then chmod 700 "$d/sealed" 2>/dev/null || true; fi
			rm -rf "$d" 2>/dev/null || true
			if [ -e "$d" ]; then left="$left $d"; fi
		fi
	done <"$tmp/eval-kept"
	if [ -n "$left" ]; then
		fail kept "the runner's kept temp dir(s)$left outlived their removal — remove each: chmod 700 <dir> <dir>/sealed && rm -rf <dir>"
	fi
}

stage_eval() {
	echo "hermetic probe — eval"

	# One case.yaml per case directory, directly under evals/ — the shape
	# this marketplace keeps; the runner would also find nested and
	# prompt.md-form cases, and then the count here would disagree with it.
	cases=0
	for c in "$root"/evals/*/case.yaml; do
		[ -f "$c" ] && cases=$((cases + 1))
	done
	if [ "$cases" = 0 ]; then
		abort cases "no evals/*/case.yaml under $root — the eval stage has nothing to run"
	fi

	mkdir -p "$root/evals/results"
	result=$root/evals/results/hermetic-probe.json
	log=$root/evals/results/hermetic-probe.log
	rm -f "$result" "$log"
	# from here until the removal below, the EXIT trap removes the dirs
	# this log names, so an interrupted run leaves none behind
	eval_log=$log
	if claude plugin eval "$root" --trust-plugin --ablation none --runs 1 \
		--model "$probe_model" --no-publish --max-cost-usd 5 --keep-temp --json "$result" \
		>"$log" 2>&1; then
		rc=0
	else
		rc=$?
	fi

	# Each run that did not pass — a grader red or a run error — keeps its
	# trace, copied before its temp dir goes. The result is pretty-printed
	# one key per line, and the indent tells a run's own keys from its
	# graders': a run's `passed`, `error` and `tracePath` sit at twelve
	# spaces, in that order, its graders' `passed` deeper, and the case's
	# `dir` at six. The run's own results directory is the `startedAt` at
	# the result's root, two spaces in, with `:` and `.` made `-`, as the
	# runner names it; with none read, no trace is copied, and none on any
	# other layout miss below either.
	#
	# Those indents are the runner's layout, not a contract, so every
	# result is checked against it, green or red: a `schemaVersion` of 1 at
	# the root, a `startedAt` read there, and a run-level `tracePath` read
	# for every run the result says ran — `casesTotal`, one run per case.
	# Any miss is the layout red: the kept temp dirs stay for inspection
	# instead of going, and once the line naming them has printed the EXIT
	# trap is told to leave them too.
	copied=0
	traces=''
	layout=''
	if [ -f "$result" ]; then
		schema=$(sed -n 's/^  "schemaVersion": \([0-9]*\),*$/\1/p' "$result")
		ts=$(sed -n 's/^  "startedAt": "\(.*\)",*$/\1/p' "$result" | sed 's/[:.]/-/g')
		total=$(sed -n 's/^ *"casesTotal": \([0-9]*\),*$/\1/p' "$result")
		awk -v count="$tmp/eval-trace-count" '
			/^      "dir": "/ { c = $0; sub(/^      "dir": "evals\//, "", c); sub(/",*$/, "", c) }
			/^            "passed": / { p = ($0 ~ /true/); e = 0 }
			/^            "error": / { e = ($0 !~ /"error": null,*$/) }
			/^            "tracePath": "/ {
				n++
				t = $0
				sub(/^            "tracePath": "/, "", t)
				sub(/",*$/, "", t)
				if (!p || e) print c "\t" t
			}
			END { print n + 0 > count }
		' "$result" >"$tmp/eval-red"
		found=$(cat "$tmp/eval-trace-count")
		if [ -z "$schema" ]; then
			layout="$layout; no schemaVersion at its root"
		elif [ "$schema" != 1 ]; then
			layout="$layout; schemaVersion $schema, not 1"
		fi
		[ -n "$ts" ] || layout="$layout; no startedAt at its root"
		# one casesTotal, all digits: an empty read, or two reads on two
		# lines, has no count to compare and must not read as a pass
		case $total in
		'' | *[!0-9]*) layout="$layout; no single casesTotal to count its runs by" ;;
		*) [ "$found" -ge "$total" ] || layout="$layout; $found run-level tracePath line(s) for $total run(s)" ;;
		esac
		# the traces are told apart by the reads above, so a layout miss
		# copies none
		if [ -z "$layout" ]; then
			traces=$root/evals/results/$ts
			while IFS='	' read -r case_name trace; do
				if [ -f "$trace" ]; then
					mkdir -p "$traces"
					cp "$trace" "$traces/$case_name.trace.jsonl"
					copied=$((copied + 1))
				fi
			done <"$tmp/eval-red"
		fi
	fi

	if [ -n "$layout" ]; then
		# a result this stage cannot read: the kept dirs stay, named on the
		# layout line below, and eval_log is cleared only once that line has
		# printed, so an interrupt before it still has the EXIT trap remove them
		kept_dirs=$(eval_kept_dirs "$log" | tr '\n' ' ')
	else
		# every kept temp dir goes now, ahead of every line below; one that
		# outlives its removal is named here, and the EXIT trap has nothing
		# left to do
		eval_remove_kept "$log"
		eval_log=''
	fi

	if [ ! -f "$result" ]; then
		abort runner "claude plugin eval wrote no result (exit $rc) — read $log"
	fi

	passed=$(sed -n 's/^ *"casesPassed": \([0-9]*\),*$/\1/p' "$result")
	errors=$(grep -c '^ *"error": null,*$' "$result" || true)
	kept_note=''
	[ "$copied" = 0 ] || kept_note=" — traces kept in $traces/"

	if [ -n "$layout" ]; then
		if [ -n "$kept_dirs" ]; then
			kept_line="the runner's kept temp dir(s) ${kept_dirs% } are left for inspection — remove each after: chmod 700 <dir> <dir>/sealed && rm -rf <dir>"
		else
			kept_line="the runner named no kept temp dir in $log"
		fi
		fail layout "the runner's result is not in the layout this stage reads (${layout#; }), so no failed run's trace can be found — read $result and bring the reads in scripts/hermetic-probe-eval to it; $kept_line"
		# the dirs are named now, so the EXIT trap leaves them
		eval_log=''
	else
		pass layout "schemaVersion 1, its start time read, a trace located for each of its $total run(s)"
	fi

	if grep -q '^ *"partial": true' "$result"; then
		fail runner "the run is partial — read $result (partialReason) and run again$kept_note"
	elif [ "$total" != "$cases" ]; then
		fail cases "$cases case.yaml files, $total cases ran — a case failed to load; read $log$kept_note"
	elif [ "$errors" != "$cases" ]; then
		fail runs "$((cases - errors)) of $cases runs ended abnormally (a turn cap or timeout) — read the error fields in $result$kept_note"
	elif [ "$rc" != 0 ] || [ "$passed" != "$cases" ]; then
		fail cases "$passed of $cases cases passed (exit $rc) — each failed grader's explanation is in $result$kept_note"
	else
		pass cases "$cases cases, $cases passed on $probe_model — fired, stopped, door named"
	fi
}
