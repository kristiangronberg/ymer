#!/bin/sh
# payload-verify — prove every payload's arrival for one topic.
#
#   sh payload-verify <topic-dir> [--exempt <tree>]...
#
# <topic-dir> is a topic folder, laid out <state folder>/<repo>/YYYY/MM-DD-<topic>.
# Pass one --exempt per machinery tree the front binds — none when it binds
# none. The state folder is read off the topic directory's own shape, so it
# is never an argument.
#
# Reads <topic-dir>/payloads/manifest and <topic-dir>/plan.md, evaluates
# one payload gate per manifest line, and reports each as
#
#   PASS     box ticked, payload bytes present as expected
#   PENDING  not yet at its final state — box unticked and bytes not
#            (fully) there, or a final-state count only partially
#            reached mid-plan. Mid-plan is the whole of its life: with
#            the plan complete, no gate reads PENDING.
#   FAIL     box ticked but the bytes absent or drifted — or a
#            final-state count still short with the plan complete — or
#            the payload fully present under an unticked box (early
#            arrival: pre-existing content or an out-of-order apply,
#            worth a look)
#
# Progress truth is the plan's own ticked boxes (`- [x] **T4S2: …`) —
# the verifier takes no progress argument, so a wrong one cannot
# silently skip gates. Backtick-fenced code in plan.md is skipped when
# scanning boxes, so an illustrative checkbox in such a fence never joins
# a gate; a `~~~` fence is not recognised.
#
# **Plan complete** is derived, never declared: every gate's checkbox is
# ticked. It is the terminal moment — "not yet" is only honest before
# it — so a final-state count still short there is FAIL, and no gate
# reads PENDING at all. Only gated boxes enter the predicate: the
# verifier step itself, and any close step after it, are unticked when
# the gate runs. Accepted edge — an occurrence a later payload-less step
# adds by hand, a command or a manual edit, trips the rule early: such
# an occurrence should carry a gate of its own, and the early FAIL says
# so.
#
# Manifest grammar — one gate per line; `#` comments and blank lines
# are ignored:
#
#   <step-id> <target> [expected]
#
#   step-id      lowercase t<task>s<step>, optional letter suffix
#                (t4s2, t4s2a). Names the payload file
#                payloads/<step-id>.<ext> (exactly one must exist, and it
#                must not be empty) and joins the checkbox T<task>S<step>
#                (suffix stripped). The suffix belongs to payload files
#                alone: a checkbox is always bare.
#   target       a file target: a path, absolute or rooted at ~/. A
#                ~user spelling is refused, never expanded. Or a record
#                target: a ymer record or a notebook row, written
#                <store>:<collection>/<key>[/<field>], the store `ymer`
#                or `notebook`, each part non-empty and free of `/`. The
#                verifier never reaches a store and knows no collection
#                or field: it checks the shape alone, and judges the
#                record's read-back card, readback/<payload file name> in
#                the topic directory, as it would a file target. The gate
#                is reported under the record target.
#   expected     positive integer occurrence count (default 1) — the
#                count in the plan's FINAL state, so repeated-content
#                gates read PENDING mid-plan — or the word `whole`:
#                the payload is the target's entire intended content
#                (a Create payload), gated by byte equality.
#
# One step writes a record target: lines of one step (letter-suffixed
# step-ids) may share one, and two steps naming the same one is an
# authoring defect. A card is a reading taken once, so a second step's
# write would leave the first gate green over a record it no longer
# matches.
#
# readback/ holds the read-back cards of record targets and their before
# cards, readback/<step-id>.before.<ext>, which no gate reads. Any other
# entry there — a card whose gate has a file target or no gate at all, a
# before card with no record gate, a stray file — is an authoring defect,
# as an orphan payload is.
#
# Everything is validated before any gate is judged: a malformed line,
# a bad record target, a record target two steps name, a step-id with
# no checkbox, a suffixed checkbox, no (or several) payload files, an
# empty or unreadable payload file, a payload file with no extension, a
# payload file with no manifest line, or a readback/ entry that is no
# record target's card is an authoring defect — reported with exit 2
# and the fix, never folded into a gate verdict. So is a file the
# verifier cannot read or an awk that fails on it: a scan that did not
# run never reads as a clean one.
#
# A payload bound for a **project repository** carries no
# workflow-internal reference: a topic ID, a state-store path, an
# artifact basename, a step ID, a bare `spec D5`-style label, or the
# placeholder spelling of one of those classes (wir_placeholders below).
# Every gate's payload bytes are scanned for those, and a hit is an
# authoring defect too — reported as `<payload>:<line>: <class> —
# <token>`. Targets under the state folder or an --exempt tree, after
# symlinks resolve, are process machinery talking about the process and
# are skipped. Two markers are exempt wherever they sit: a line carrying
# a remediation marker's `#`-opened `plan: <topic id>` is exempt whole;
# on a line where `Redefinition in flight — ` stands ahead of a topic
# ID, that topic ID is exempt and every other class still reads. Prose
# that merely writes the same token is not a marker.
# A record target is skipped as well: no project repository holds it.
#
# The state-store class keys on the state folder's own directory name:
# `../<name>` and `<name>/<dir>/`. A state folder named with a common
# word — docs, notes, work — therefore also flags a project's own
# `docs/guides/`. Name the state folder distinctively; --exempt takes a
# whole tree, never one file.
#
# Bytes, not characters: every file is read under LC_ALL=C and no
# encoding is required. A line ends at a newline byte, and a word
# character is an ASCII letter, digit or `_`. A count gate reads its
# payload and target as text, and the reference scan reads each payload
# as text, so all of them are assumed free of NUL bytes; a whole-file
# gate compares raw bytes.
#
# HOME must be set: a home-rooted path is read from it, and an
# environment that lacks it is refused up front rather than read as a
# verdict.
#
# Exit: 0 no FAIL · 1 at least one FAIL · 2 usage, environment or
# authoring defect.

set -u
LC_ALL=C
export LC_ALL
unset CDPATH

tab=$(printf '\t')

tmp=$(mktemp -d) || {
	echo "payload-verify: cannot make a temp directory — set TMPDIR to a writable directory" >&2
	exit 2
}
trap 'rm -rf "$tmp"' EXIT
trap 'exit 2' HUP INT TERM

die() {
	printf 'payload-verify: %s\n' "$1" >&2
	exit 2
}

usage() {
	die "usage: payload-verify <topic-dir> [--exempt <tree>]... — the topic directory, then one --exempt per machinery tree the front binds"
}

# The placeholder spellings of the workflow-internal-reference classes,
# one `<class><TAB><spelling>` per line. The plugin glossary's
# `workflow-internal reference` entry lists the same spellings, and the
# marketplace's own test fails when the two sets differ.
wir_placeholders() {
	cat <<'EOF'
topic ID	<topic ID>
state-store path	<state folder>
state-store path	<topic folder>
step ID	T<task>S<step>
step ID	<step-id>
phase name	<phase>
EOF
}

# expand <path> — a leading ~ is $HOME, for the topic argument; the
# manifest awk below expands its targets by the same rule
expand() {
	case $1 in
	\~) printf '%s\n' "$HOME" ;;
	\~/*) printf '%s%s\n' "$HOME" "${1#\~}" ;;
	*) printf '%s\n' "$1" ;;
	esac
}

# resolve <path> — the physical absolute path, every symlink followed; a
# tail that does not exist yet stays as written. A relative path is read
# from the working directory first, so every parent step is a real
# parent and the walk ends at / at the latest. Always called through
# $( ), so its variables never reach the caller.
resolve() {
	r=$1
	case $r in
	/*) ;;
	*) r=$(pwd -P)/$r ;;
	esac
	n=0
	while [ -h "$r" ] && [ "$n" -lt 40 ]; do
		n=$((n + 1))
		l=$(readlink "$r")
		case $l in
		/*) r=$l ;;
		*) r=${r%/*}/$l ;;
		esac
	done
	if [ -d "$r" ]; then
		(cd -P "$r" && pwd -P)
		return
	fi
	d=${r%/*}
	b=${r##*/}
	[ -n "$d" ] || d=/
	d=$(resolve "$d")
	case $d in
	*/) printf '%s%s\n' "$d" "$b" ;;
	*) printf '%s/%s\n' "$d" "$b" ;;
	esac
}

# exempt <physical path> — true under the state folder or an --exempt tree
exempt() {
	while IFS= read -r root; do
		case $1 in
		"$root" | "$root"/*) return 0 ;;
		esac
	done <"$tmp/exempt"
	return 1
}

# ── arguments ────────────────────────────────────────────────────────

topic=''
topic_set=0
: >"$tmp/exempt"
while [ $# -gt 0 ]; do
	case $1 in
	--exempt)
		[ $# -ge 2 ] || usage
		[ -d "$2" ] || die "--exempt $2: no such directory — pass each machinery tree the front binds, as an existing directory"
		root=$(resolve "$2") || exit 2
		printf '%s\n' "$root" >>"$tmp/exempt"
		shift 2
		;;
	-*) usage ;;
	*)
		[ "$topic_set" = 0 ] || usage
		topic_set=1
		topic=$1
		shift
		;;
	esac
done
[ "$topic_set" = 1 ] || usage
[ -n "${HOME:-}" ] || die "HOME is not set — a home-rooted path is read from it; set HOME, as a login shell does"

topic=$(expand "$topic")
case $topic in
/*) ;;
*) topic=$(pwd)/$topic ;;
esac
if [ -d "$topic" ]; then
	topic=$(cd "$topic" && pwd)
fi
while :; do
	case $topic in
	?*/) topic=${topic%/} ;;
	*) break ;;
	esac
done

plan=$topic/plan.md
pay=$topic/payloads
man=$pay/manifest
[ -f "$plan" ] || die "no plan.md under $topic — pass the topic directory that holds plan.md and payloads/manifest"
[ -f "$man" ] || die "no payloads/manifest under $topic — a plan whose steps carry no payload has no manifest and nothing to verify"

# The state folder is the topic directory's great-grandparent, read only
# once the directory has the topic shape: a wrong-shaped path would
# exempt an arbitrary ancestor, and the reference scan would then pass on
# nothing.
base=${topic##*/}
year=${topic%/*}
area=${year%/*}
state=${area%/*}
year=${year##*/}
case $base in
[0-9][0-9]-[0-9][0-9]-?*) shape=1 ;;
*) shape=0 ;;
esac
case $year in
[0-9][0-9][0-9][0-9]) ;;
*) shape=0 ;;
esac
[ -n "$state" ] || shape=0
[ "$shape" = 1 ] || die "$topic is not a topic directory — pass <state folder>/<repo>/YYYY/MM-DD-<topic>, the shape the state folder is read from"
state=$(resolve "$state")
printf '%s\n' "$state" >>"$tmp/exempt"

# ── boxes ────────────────────────────────────────────────────────────
# `<id> <1|0>` per checkbox outside a fence (CommonMark-ish: a fence
# opened by N backticks closes only on a line of >= N backticks alone).

awk -v plan="$plan" '
	function die(m) { print "payload-verify: " m | "cat 1>&2"; bad = 1; exit 2 }
	{
		line = $0
		if (line ~ /^[[:space:]]*```/) {
			t = line
			sub(/^[[:space:]]*/, "", t)
			ticks = t
			sub(/[^`].*$/, "", ticks)
			ticks = length(ticks)
			sub(/[[:space:]]*$/, "", t)
			if (fence == 0) fence = ticks
			else if (ticks >= fence && t ~ /^`+$/) fence = 0
			next
		}
		if (fence) next
		if (line ~ /^[[:space:]]*- \[[ xX]\] \*\*T[0-9]+S[0-9]+[a-z]:/) {
			id = line
			sub(/^[[:space:]]*- \[[ xX]\] \*\*/, "", id)
			sub(/:.*$/, "", id)
			die("suffixed checkbox " id " in " plan " (line " NR ") — a checkbox carries the bare T<task>S<step>; name the box " substr(id, 1, length(id) - 1) " and keep the letter on its payload files alone")
		}
		if (line ~ /^[[:space:]]*- \[[ xX]\] \*\*T[0-9]+S[0-9]+:/) {
			s = line
			sub(/^[[:space:]]*- \[/, "", s)
			ticked = (substr(s, 1, 1) == " ") ? 0 : 1
			id = s
			sub(/^[ xX]\] \*\*/, "", id)
			sub(/:.*$/, "", id)
			if (id in seen) die("duplicate checkbox " id " in " plan " (line " NR ") — give each step its own step ID")
			seen[id] = 1
			print id, ticked
		}
	}
	END { if (bad) exit 2 }' "$plan" >"$tmp/boxes" || exit 2

# ── the manifest ─────────────────────────────────────────────────────
# The payloads/ and readback/ listings are read once; each gate becomes
# one `<sid> <box> <ticked> <payload file> <path> <expected> <kind>
# <target>` line: <path> is the file the gate reads — a file target
# ~-expanded, or a record target's read-back card — and <kind> is
# `file` or `record`.

ls -A "$pay" >"$tmp/listing" || die "cannot list $pay — check its permissions"
rb=$topic/readback
: >"$tmp/cards"
if [ -e "$rb" ] || [ -h "$rb" ]; then
	[ -d "$rb" ] || die "readback is not a directory under $topic — it holds the read-back cards of record targets; move the file aside"
	ls -A "$rb" >"$tmp/cards" || die "cannot list $rb — check its permissions"
fi

PV_TOPIC=$topic awk -v q="'" '
	function die(m) { print "payload-verify: " m | "cat 1>&2"; bad = 1; exit 2 }
	# sorted <list> — the newline-separated names, sorted, joined by ", "
	function sorted(o,    n, a, i, j, v, s) {
		n = split(o, a, "\n")
		for (i = 2; i <= n; i++) {
			v = a[i]
			for (j = i - 1; j >= 1 && a[j] > v; j--) a[j + 1] = a[j]
			a[j + 1] = v
		}
		s = a[1]
		for (i = 2; i <= n; i++) s = s ", " a[i]
		return s
	}
	FILENAME == ARGV[1] { box[$1] = $2; next }
	FILENAME == ARGV[2] { if ($0 != "manifest") file[$0] = 1; next }
	FILENAME == ARGV[3] { card[$0] = 1; next }
	{
		line = $0
		sub(/^[[:space:]]+/, "", line)
		sub(/[[:space:]]+$/, "", line)
		if (line == "" || line ~ /^#/) next
		nf = split(line, f, /[[:space:]]+/)
		if (nf != 2 && nf != 3) die("manifest line " FNR ": expected <step-id> <target> [expected]: " q line q " — one gate per line, fields separated by spaces")
		sid = f[1]
		target = f[2]
		if (sid !~ /^t[0-9]+s[0-9]+[a-z]?$/) die("manifest line " FNR ": bad step-id " q sid q " (want t<task>s<step>[a-z]) — the lowercase form of the step ID, letter suffix optional")
		if (sid in seen) die("manifest line " FNR ": duplicate gate for " sid " — one gate per payload file; a second payload in the step takes a letter suffix")
		seen[sid] = 1
		expected = nf == 3 ? f[3] : "1"
		if (expected != "whole") {
			if (expected !~ /^[0-9]+$/ || expected + 0 < 1) die("manifest line " FNR ": expected must be a positive integer or " q "whole" q ": " q expected q)
			expected = expected + 0
		}
		b = sid
		sub(/[a-z]$/, "", b)
		b = toupper(b)
		if (target ~ /^\// || target == "~" || target ~ /^~\//) kind = "file"
		else if (target ~ /^[^\/]*:/) {
			if (target !~ /^(ymer|notebook):[^\/]+\/[^\/]+(\/[^\/]+)?$/) die("manifest line " FNR ": bad record target " q target q " — write <store>:<collection>/<key>[/<field>], the store ymer or notebook, each part non-empty and free of slashes")
			if ((target in owner) && owner[target] != b) die("manifest line " FNR ": record target " q target q " is also " ownsid[target] q "s — one step writes a record target; merge the writes into one step and one payload")
			owner[target] = b
			ownsid[target] = sid
			kind = "record"
		} else die("manifest line " FNR ": target must be absolute or ~-rooted, or a record target: " q target q " — write the full path, or ~ and a slash for one under your home directory (~user is not expanded), or <store>:<collection>/<key>[/<field>] for a ymer record or a notebook row")
		if (!(b in box)) die("manifest line " FNR ": no checkbox " b " in plan.md for gate " sid " — add the step " q "- [ ] **" b ": …" q " or correct the step-id")
		k = 0
		for (x in file) if (index(x, sid ".") == 1) { k++; pf = x }
		if (k != 1) die("manifest line " FNR ": want exactly one payloads/" sid ".<ext>, found " k " — one payload file per gate, named by its step-id")
		shown = target
		if (kind == "record") {
			path = ENVIRON["PV_TOPIC"] "/readback/" pf
			recpf[pf] = 1
			recsid[sid] = 1
		} else if (target == "~") path = ENVIRON["HOME"]
		else if (target ~ /^~\//) path = ENVIRON["HOME"] substr(target, 2)
		else path = target
		if (kind == "file") shown = path
		print sid "\t" b "\t" box[b] "\t" pf "\t" path "\t" expected "\t" kind "\t" shown
	}
	END {
		if (bad) exit 2
		for (x in file) if (index(x, ".") == 0) die("payload file " x " has no extension — name it payloads/<step-id>.<ext>")
		o = ""
		for (x in file) {
			p = x
			sub(/\..*$/, "", p)
			if (!(p in seen)) o = o (o == "" ? "" : "\n") x
		}
		if (o != "") die("payload file(s) with no manifest gate: " sorted(o) " — add a manifest line for each, or remove the file")
		o = ""
		for (x in card) {
			if (x in recpf) continue
			p = x
			sub(/\..*$/, "", p)
			if ((p in recsid) && substr(x, length(p) + 1, 8) == ".before." && length(x) > length(p) + 8) continue
			o = o (o == "" ? "" : "\n") x
		}
		if (o != "") die("readback/ file(s) that are no record target" q "s read-back card or before card: " sorted(o) " — a read-back card is named like its payload, readback/<step-id>.<ext>, and a before card readback/<step-id>.before.<ext>, for a gate whose target is a record target; remove each, or restore its manifest line")
	}' "$tmp/boxes" "$tmp/listing" "$tmp/cards" "$man" >"$tmp/gates" || exit 2

while IFS= read -r c; do
	[ -f "$rb/$c" ] || die "readback/$c is not a regular file — a read-back card is a file named like its payload"
done <"$tmp/cards"

# The same pass reads plan complete (used by the verdicts below) and
# lists every count gate whose file is there, a file target or a record
# target's read-back card, as `<payload><TAB><that file>`, the counts'
# input.
complete=1
while IFS=$tab read -r sid box ticked pf target expected kind shown; do
	[ -f "$pay/$pf" ] || die "payloads/$pf is not a regular file — a payload is a file named payloads/<step-id>.<ext>"
	[ -r "$pay/$pf" ] || die "payloads/$pf is not readable — check its permissions"
	[ -s "$pay/$pf" ] || die "payloads/$pf is empty — a payload carries at least one line of the target's final state"
	[ "$ticked" = 1 ] || complete=0
	[ "$expected" = whole ] || [ ! -f "$target" ] || printf '%s\t%s\n' "$pay/$pf" "$target"
done <"$tmp/gates" >"$tmp/countable"

# ── workflow-internal references ─────────────────────────────────────
# Each class below mirrors its token shape with ASCII word boundaries: a
# leading class the token may not follow, and for some a trailing class
# it may not run into. A sentinel newline at both ends of the line stands
# for the line's edges.

# One awk reads every payload whose file target is not exempt, in
# manifest order, so the rows keep that order; a record target is never
# read.

wir_placeholders >"$tmp/wir"
: >"$tmp/hits"
stem=${state##*/}
set --
while IFS=$tab read -r sid box ticked pf target expected kind shown; do
	[ "$kind" = file ] || continue
	real=$(resolve "$target")
	exempt "$real" || set -- "$@" "$pay/$pf"
done <"$tmp/gates"
if [ $# -gt 0 ]; then
	awk -v stem="$stem" '
		function esc(s,    o, i, c) {
			o = ""
			for (i = 1; i <= length(s); i++) {
				c = substr(s, i, 1)
				if (index("\\^$.[]|()*+?{}", c)) o = o "\\" c
				else o = o c
			}
			return o
		}
		# find <s> <re> <head> <tail> — the leftmost token, head and tail
		# sentinels stripped; sets at, the token position, 0 on none
		function find(s, re, head, tail) {
			at = 0
			if (!match(s, re)) return ""
			at = RSTART + head
			return substr(s, RSTART + head, RLENGTH - head - tail)
		}
		# pick <s> <class> <literal token> <its position> — the leftmost of
		# the literal token, when there is one, and every placeholder
		# spelling of the class
		function pick(s, cls, best, pos,    i, p) {
			if (best == "") pos = 0
			for (i = 1; i <= np; i++) {
				if (pc[i] != cls) continue
				p = index(s, ps[i])
				if (p && (pos == 0 || p < pos)) { best = ps[i]; pos = p }
			}
			return pos ? best : ""
		}
		FILENAME == ARGV[1] {
			split($0, w, "\t")
			np++
			pc[np] = w[1]
			ps[np] = w[2]
			next
		}
		BEGIN {
			st = esc(stem)
			topic_re = "[^A-Za-z0-9_/-][0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[a-z0-9]*[a-z][a-z0-9]*(-[a-z0-9]+)*"
			up_re = "[^A-Za-z0-9_-]\\.\\./" st "[^A-Za-z0-9_-]"
			down_re = "[^A-Za-z0-9_-]" st "/[a-z][a-z0-9_-]*/"
			art_re = "[^A-Za-z0-9_-](plan|spec|survey|brainstorm|review|sketch|implemented)\\.md[^A-Za-z0-9_]"
			step_re = "[^A-Za-z0-9_]T[0-9]+S[0-9]+[^A-Za-z0-9_]"
			label_re = "[^A-Za-z0-9_](Spec|spec|Survey|survey|Brainstorm|brainstorm) [A-Z][0-9]+[^A-Za-z0-9_]"
			remedy_re = "(#|Remediation\\()(.*[^A-Za-z0-9_-])?plan:[[:space:]]*[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-"
			marker = "Redefinition in flight — "
		}
		{
			s = "\n" $0 "\n"
			# the remediation marker: the whole line is exempt
			if (match(s, remedy_re)) next
			# the redefinition-in-flight marker: a topic ID after it is exempt
			m = index(s, marker)
			ts = m ? substr(s, 1, m - 1) "\n" : s
			tok = find(ts, topic_re, 1, 0)
			tok = pick(ts, "topic ID", tok, at)
			if (tok != "") hit("topic ID", tok)
			up = find(s, up_re, 1, 1)
			upat = at
			down = find(s, down_re, 1, 0)
			if (upat && (!at || upat <= at)) { lit = up; at = upat } else lit = down
			tok = pick(s, "state-store path", lit, at)
			if (tok != "") hit("state-store path", tok)
			tok = find(s, art_re, 1, 1)
			tok = pick(s, "artifact basename", tok, at)
			if (tok != "") hit("artifact basename", tok)
			tok = find(s, step_re, 1, 1)
			tok = pick(s, "step ID", tok, at)
			if (tok != "") hit("step ID", tok)
			tok = find(s, label_re, 1, 1)
			tok = pick(s, "label", tok, at)
			if (tok != "") hit("label", tok)
			tok = pick(s, "phase name", "", 0)
			if (tok != "") hit("phase name", tok)
		}
		function hit(cls, tok) { printf "  %s:%d: %s — %s\n", FILENAME, FNR, cls, tok }
	' "$tmp/wir" "$@" >"$tmp/hits" ||
		die "cannot scan the payloads — awk failed on the batched scan (its error is above); the scan needs a POSIX awk"
fi
if [ -s "$tmp/hits" ]; then
	{
		echo "payload-verify: workflow-internal reference in payload prose bound for a project repo (write-plan's frame bar) — reword each line below for the target file's reader, or pass --exempt for a machinery tree the front binds:"
		cat "$tmp/hits"
	} >&2
	exit 2
fi

# ── the verdicts ─────────────────────────────────────────────────────
# Plan complete — every gate's box ticked — is the terminal moment:
# every gated step has run, so a count still short of its final-state
# count is short for good (the accepted edge: the header). The sanity
# pass above sets complete, and the verdict loop below reads it.

# The counts run first, as one awk over the count list, and the verdicts
# below take them in order. A count needs to know whether each file's
# last byte is a newline, which getline hides: under LC_ALL=C a
# non-empty file ends in one exactly when its line lengths, plus one per
# line, sum to its byte size, so one wc -c supplies every size. The awk
# prints one line per listed gate — the count, or `unreadable <file>`
# for a file it cannot read, after which it stops — and an awk that
# fails counts nothing.

set --
while IFS=$tab read -r p t; do
	set -- "$@" "$p" "$t"
done <"$tmp/countable"
: >"$tmp/sizes"
: >"$tmp/counts"
if [ $# -gt 0 ]; then
	wc -c "$@" >"$tmp/sizes" 2>/dev/null
	awk '
		# slurp <file> — 1 with its bytes in got, 0 when it cannot be read
		function slurp(f,    s, l, k, b, g) {
			s = ""
			k = 0
			b = 0
			while ((g = (getline l < f)) > 0) {
				s = (k++ ? s "\n" : "") l
				b += length(l) + 1
			}
			if (g < 0) return 0
			close(f)
			if (!(f in size)) exit 2
			got = (k && b == size[f]) ? s "\n" : s
			return 1
		}
		FILENAME == ARGV[1] {
			n = $1
			sub(/^ *[0-9]+ /, "")
			size[$0] = n + 0
			next
		}
		{
			split($0, g, "\t")
			if (!slurp(g[1])) { print "unreadable " g[1]; exit }
			p = got
			if (!(g[2] in text)) {
				if (!slurp(g[2])) { print "unreadable " g[2]; exit }
				text[g[2]] = got
			}
			if (p == "") exit 2
			t = text[g[2]]
			n = 0
			while ((i = index(t, p)) > 0) {
				n++
				t = substr(t, i + length(p))
			}
			print n
		}' "$tmp/sizes" "$tmp/countable" >"$tmp/counts" || : >"$tmp/counts"
fi

pass=0
pending=0
fail=0
total=0
while IFS=$tab read -r sid box ticked pf target expected kind shown; do
	payload=$pay/$pf
	if [ "$expected" = whole ]; then
		if [ ! -f "$target" ]; then
			if [ "$kind" = record ]; then
				if [ "$ticked" = 1 ]; then status=FAIL note='ticked but read-back card missing'; else status=PENDING note='read-back card not written yet'; fi
			elif [ "$ticked" = 1 ]; then status=FAIL note='ticked but target missing'; else status=PENDING note='target not created yet'; fi
		elif [ ! -r "$target" ]; then
			die "cannot read $target — check its permissions"
		elif cmp -s "$target" "$payload"; then
			if [ "$ticked" = 1 ]; then status=PASS note='whole file matches'; else status=FAIL note='early: whole file already matches but box unticked'; fi
		else
			if [ "$ticked" = 1 ]; then status=FAIL note='ticked but target differs from payload'; else status=PENDING note='target differs (not applied yet)'; fi
		fi
	else
		if [ -f "$target" ]; then
			IFS= read -r n <&3 ||
				die "cannot count the payloads — awk failed on the batched count (its error is above); the count needs a POSIX awk"
			case $n in
			'unreadable '*)
				printf 'payload-verify: cannot read %s — check its permissions\n' "${n#unreadable }" >&2
				die "cannot count payloads/$pf in $target — awk failed on it (its error is above)"
				;;
			esac
		else
			n=0
		fi
		case $n in
		'' | *[!0-9]*) die "cannot count payloads/$pf in $target — awk returned '$n'; the count needs a POSIX awk" ;;
		esac
		of="$n of $expected"
		if [ "$n" -eq "$expected" ]; then
			if [ "$ticked" = 1 ]; then status=PASS note=$of; else status=FAIL note="early: $of but box unticked"; fi
		elif [ "$n" -gt "$expected" ]; then
			status=FAIL note="drifted: $of occurrences"
		elif [ "$ticked" = 1 ]; then
			if [ "$n" -eq 0 ]; then
				status=FAIL note="ticked but $of occurrences"
			elif [ "$complete" = 1 ]; then
				status=FAIL note="plan complete but $of occurrences"
			else
				status=PENDING note="$of so far (final-state count)"
			fi
		else
			status=PENDING note=$of
		fi
	fi
	case $status in
	PASS) pass=$((pass + 1)) ;;
	PENDING) pending=$((pending + 1)) ;;
	FAIL) fail=$((fail + 1)) ;;
	esac
	total=$((total + 1))
	printf '%-7s %-6s %s — %s\n' "$status" "$sid" "$shown" "$note"
done <"$tmp/gates" 3<"$tmp/counts"

printf 'payload-verify: %d gate(s) — %d PASS · %d PENDING · %d FAIL\n' "$total" "$pass" "$pending" "$fail"
[ "$fail" -eq 0 ] || exit 1
exit 0
